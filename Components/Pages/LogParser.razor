    private static List<CountItem> GetTopIpAccess(List<ParsedLogRow> rows, int take)
    {
        return rows
            .Where(x => !IsExcludedAnalysisIp(x.Ip) && !string.IsNullOrWhiteSpace(x.Ip))
            .GroupBy(x => x.Ip.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => new CountItem(group.Key, group.Count()))
            .OrderByDescending(item => item.Count)
            .ThenBy(item => item.Value, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();
    }

