@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject Monitoring.Blazor.Services.LanguageState Language

<CascadingValue Name="UiLanguage" Value="Language.Code">
<a class="skip-link" href="#main-content">@Language.T("본문으로 건너뛰기", "Skip to content")</a>

<div class="page @(SidebarCollapsed ? "sidebar-collapsed" : string.Empty)">
    <aside class="sidebar" id="sidebar" role="navigation" aria-label="@Language.T("사이드바 탐색", "Sidebar navigation")">
        <NavMenu />
    </aside>

    <main id="main-content">
        <header class="top-row" role="banner">
            <div class="top-left">
                <button type="button" class="sidebar-toggle" aria-label="@Language.T("사이드바 전환", "Toggle sidebar")" aria-expanded="@(!SidebarCollapsed)" @onclick="ToggleSidebarAsync">
                    <i class="bi @(SidebarCollapsed ? "bi-layout-sidebar-inset" : "bi-layout-sidebar-inset-reverse")"></i>
                </button>
                <div class="top-title-wrap">
                    <div class="top-kicker" aria-hidden="true">OpsEye</div>
                    <div class="top-title">@Language.T("운영 콘솔", "Operations console")</div>
                </div>
            </div>
            <div class="top-right">
                <button type="button" class="theme-btn top-action language-toggle" @onclick="ToggleLanguageAsync" aria-label="@Language.T("언어", "Language")" title="@Language.T("언어 전환", "Switch language")">
                    <i class="bi bi-translate"></i>
                    @(Language.IsKorean ? "English" : "한국어")
                </button>

                <AuthorizeView>
                    <Authorized Context="auth">
                        <span class="pill soft" aria-label="@Language.T("현재 사용자", "Current user")">
                                <i class="bi bi-person-circle me-1"></i>@(auth.User.Identity?.Name ?? Language.T("로그인됨", "Signed in"))
                        </span>
                        <form method="post" action="/auth/logout" class="d-inline">
                            <button type="submit" class="theme-btn top-action" aria-label="@Language.T("로그아웃", "Logout")" title="@Language.T("로그아웃", "Logout")">
                                <i class="bi bi-box-arrow-right"></i>
                                @Language.T("로그아웃", "Logout")
                            </button>
                        </form>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <button type="button" class="theme-btn top-action" @onclick="OpenSettingsAsync" aria-label="@Language.T("설정 열기", "Open settings")" title="@Language.T("설정", "Settings")">
                            <i class="bi bi-gear-fill"></i>
                            @Language.T("설정", "Settings")
                        </button>
                    </Authorized>
                </AuthorizeView>
                <button type="button" class="theme-btn top-action" onclick="themeManager.toggle()" aria-label="@Language.T("테마 전환", "Toggle theme")" title="@Language.T("라이트 / 다크 테마 전환", "Toggle light / dark theme")">
                    <i class="bi bi-moon-stars-fill"></i>
                    @Language.T("테마", "Theme")
                </button>
            </div>
        </header>

        <article class="content" role="main" aria-label="@Language.T("주요 콘텐츠", "Main content")">
            @if (SidebarStateLoaded)
            {
                @Body
            }
            else
            {
                <div class="workspace-loading" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>@Language.T("화면을 준비하고 있습니다.", "Preparing your workspace.")</div>
            }
        </article>

        <footer class="footer" role="contentinfo">
            <span>@Language.T("OpsEye 운영 콘솔", "OpsEye Operations Console")</span>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet role="alert" aria-live="assertive">
    @Language.T("오류가 발생했습니다.", "An error has occurred.")
    <a href="." class="reload">@Language.T("새로고침", "Reload")</a>
    <span class="dismiss" tabindex="0" role="button" aria-label="@Language.T("닫기", "Dismiss")">×</span>
</div>

</CascadingValue>

@code {
    private bool SidebarCollapsed { get; set; }
    private bool SidebarStateLoaded { get; set; }

    protected override void OnInitialized()
    {
        Language.Changed += OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private Task OpenSettingsAsync()
    {
        NavigationManager.NavigateTo("/settings");
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || SidebarStateLoaded)
        {
            return;
        }

        var savedLanguage = await JS.InvokeAsync<string?>("monitorSettings.get", "language", "ko");
        Language.SetLanguage(savedLanguage);
        await JS.InvokeVoidAsync("opsLanguage.apply", Language.Code);
        SidebarCollapsed = await JS.InvokeAsync<bool>("monitorSettings.get", "sidebarCollapsed", false);
        SidebarStateLoaded = true;
        StateHasChanged();
    }

    private async Task ToggleLanguageAsync()
    {
        Language.SetLanguage(Language.IsKorean ? "en" : "ko");
        await JS.InvokeVoidAsync("monitorSettings.set", "language", Language.Code);
        await JS.InvokeVoidAsync("opsLanguage.apply", Language.Code);
    }

    private async Task ToggleSidebarAsync()
    {
        SidebarCollapsed = !SidebarCollapsed;
        await JS.InvokeVoidAsync("monitorSettings.set", "sidebarCollapsed", SidebarCollapsed);
    }

    public void Dispose()
    {
        Language.Changed -= OnLanguageChanged;
    }
}
