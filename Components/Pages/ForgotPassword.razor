@page "/forgot-password"
@attribute [AllowAnonymous]
@layout LoginLayout
@using Microsoft.AspNetCore.WebUtilities
@using Monitoring.Blazor.Services
@inject MemberAuthService MemberAuthService
@inject EmailSenderService EmailSenderService
@inject IConfiguration Configuration
@inject EmailSettingsRepository EmailSettingsRepository
@inject NavigationManager NavigationManager

<PageTitle>OpsEye | @Language.T("비밀번호 찾기", "Forgot Password")</PageTitle>

<div class="login-page">
    <section class="login-shell" aria-label="@Language.T("비밀번호 재설정 요청 양식", "Password reset request form")">
        <div class="login-brand">
            <div class="login-brand-mark" aria-hidden="true">
                <i class="bi bi-key-fill"></i>
            </div>
            <div>
                <div class="login-brand-name">OpsEye</div>
                <div class="login-brand-sub">@Language.T("비밀번호 재설정", "Password reset")</div>
            </div>
        </div>

        <div class="login-card card">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h1 class="h3 mb-2">@Language.T("비밀번호 재설정 요청", "Reset password request")</h1>
                    <p class="text-secondary mb-0">
                        @(_emailResetEnabled
                            ? Language.T("재설정 링크를 받을 계정 이메일 주소를 입력하세요.", "Enter the email address on your account to receive a reset link.")
                            : Language.T("사용자 비밀번호 재설정이 비활성화되어 있습니다. 관리자에게 문의하세요.", "Password reset by users is disabled. Please contact an administrator."))
                    </p>
                </div>

                @if (!_emailResetEnabled)
                {
                    <div class="alert alert-warning small" role="note">
                        @Language.T("설정에서 이메일 비밀번호 재설정이 비활성화되어 있습니다. 관리자는 사용자 관리 페이지에서 재설정할 수 있습니다.", "Email-based password reset is disabled in settings. Admins can still reset passwords from the user management page.")
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @( _isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
                }

                <div class="d-grid gap-3">
                    <div>
                        <label class="form-label" for="reset-email">@Language.T("이메일 주소", "Email address")</label>
                        <input id="reset-email" class="form-control" type="email" @bind="_emailAddress" autocomplete="email" disabled="@(!_emailResetEnabled)" />
                    </div>

                    <button type="button" class="btn btn-primary" @onclick="RequestResetAsync" disabled="@(!_emailResetEnabled || string.IsNullOrWhiteSpace(_emailAddress))">
                        @Language.T("재설정 이메일 보내기", "Send reset email")
                    </button>

                    @if (_emailResetEnabled)
                    {
                        <div class="alert alert-info small mb-0" role="note">
                            @Language.T("등록된 이메일 주소로 재설정 링크가 전송됩니다. 계정과 일치하지 않아도 요청은 접수된 것처럼 표시됩니다.", "The reset link will be sent to the email address on file. If the address does not match an account, the request will still appear accepted.")
                        </div>
                    }

                    <a class="btn btn-outline-secondary" href="/login">@Language.T("로그인으로 돌아가기", "Back to login")</a>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private string _emailAddress = string.Empty;
    private string? _message;
    private bool _isError;
    private bool _emailResetEnabled;

    protected override void OnInitialized()
    {
        var baseSettings = Configuration.GetSection("Monitoring:Email").Get<EmailSettings>() ?? new EmailSettings();
        var emailSettings = EmailSettingsRepository.Load(baseSettings);
        _emailResetEnabled = emailSettings.Enabled && emailSettings.PasswordResetEnabled;
    }

    private async Task RequestResetAsync()
    {
        ClearMessage();

        if (!_emailResetEnabled)
        {
            SetError(Language.T("이메일 비밀번호 재설정이 비활성화되어 있습니다. 관리자에게 문의하세요.", "Email-based password reset is disabled. Please contact an administrator."));
            return;
        }

        if (string.IsNullOrWhiteSpace(_emailAddress))
        {
            SetError(Language.T("이메일 주소를 입력하세요.", "Please enter your email address."));
            return;
        }

        try
        {
            var (token, expiresUtc, emailAddress, displayName) = await MemberAuthService.CreatePasswordResetRequestByEmailAsync(_emailAddress);
            var resetUrl = NavigationManager.ToAbsoluteUri($"/reset-password?token={Uri.EscapeDataString(token)}").ToString();
            await EmailSenderService.SendPasswordResetEmailAsync(emailAddress, resetUrl, displayName);
            SetSuccess($"If an account matches {emailAddress}, a reset email has been sent. The link expires at {expiresUtc.ToLocalTime():yyyy-MM-dd HH:mm}.");
        }
        catch (InvalidOperationException ex) when (string.Equals(ex.Message, "Member not found.", StringComparison.OrdinalIgnoreCase))
        {
            SetSuccess(Language.T("이메일 주소가 계정과 일치하면 재설정 이메일이 전송됩니다.", "If the email address matches an account, a reset email has been sent."));
        }
        catch (Exception ex)
        {
            SetError(ex.Message);
        }
    }

    private void SetSuccess(string message)
    {
        _message = message;
        _isError = false;
    }

    private void SetError(string message)
    {
        _message = message;
        _isError = true;
    }

    private void ClearMessage()
    {
        _message = null;
        _isError = false;
    }
}
