    private static void ApplyRuntimeAnalysisSettings(LogAnalysisRuntimeSettings settings)
    {
        AnalysisExcludedIpPatterns = MergeTokens(DefaultAnalysisExcludedIpPatterns, settings.ExcludedIpPatterns, treatAsPatterns: true);
        AnalysisExcludedIpPrefixes = AnalysisExcludedIpPatterns
            .Select(ToPrefixFromPattern)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        PriorityUrlTokens = MergeTokens(DefaultPriorityUrlTokens, settings.PriorityUrlTokens);
        AdminProbeTokens = MergeTokens(DefaultAdminProbeTokens, settings.AdminProbeTokens);
        BackupProbeTokens = MergeTokens(DefaultBackupProbeTokens, settings.BackupProbeTokens);
        ConfigProbeTokens = MergeTokens(DefaultConfigProbeTokens, settings.ConfigProbeTokens);
        ScriptProbeTokens = MergeTokens(DefaultScriptProbeTokens, settings.ScriptProbeTokens);
    }

    private static List<string> MergeTokens(IEnumerable<string> defaults, IEnumerable<string>? custom, bool treatAsPatterns = false)
    {
        var values = defaults
            .Concat(custom ?? [])
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!treatAsPatterns)
        {
            return values;
        }

        return values
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string ToPrefixFromPattern(string pattern)
    {
        var trimmed = pattern.Trim();
        return trimmed.EndsWith(".*", StringComparison.Ordinal) ? trimmed[..^1] : trimmed;
    }

    private async Task<List<ParsedLogRow>> ReadAndParseFile(IBrowserFile file, long bytesBefore, long totalBytes, CancellationToken token)
    {
        var result = new List<ParsedLogRow>();

        long readBytes = 0;
        int lastProgress = -1;

        const int batchSize = 500;
        var bufferLines = new List<string>(batchSize);

        await using var stream = file.OpenReadStream(300 * 1024 * 1024);
        using var reader = new StreamReader(stream);

        string? line;

        while (true)
        {
            token.ThrowIfCancellationRequested();
            line = await reader.ReadLineAsync();
            if (line is null)
            {
                break;
            }

            bufferLines.Add(line);

            readBytes = stream.Position;
            if (totalBytes > 0)
            {
                var current = (int)(((bytesBefore + readBytes) / (double)totalBytes) * 100);
                if (current != lastProgress)
                {
                    lastProgress = current;
                    PreviewProgress = current;
                    await InvokeAsync(StateHasChanged);
                }
            }

            if (bufferLines.Count >= batchSize)
            {
                result.AddRange(ApacheLogParser.ParseLines(bufferLines));
                bufferLines.Clear();
            }
        }

        if (bufferLines.Count > 0)
        {
            result.AddRange(ApacheLogParser.ParseLines(bufferLines));
        }

        return result;
    }

    private async Task HandleFiles(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles().ToList();
        if (files.Count > MaxUploadFiles)
        {
            AnalyzeMessage = $"You selected {files.Count} files. The upload limit is {MaxUploadFiles} files per batch.";
            return;
        }

        var totalBytes = files.Sum(x => (long)x.Size);
        if (totalBytes > MaxUploadBytes)
        {
            AnalyzeMessage = $"The selected files total {FormatBytes(totalBytes)}. The batch limit is {FormatBytes(MaxUploadBytes)}.";
            return;
        }

        SelectedFiles = files;
        AnalyzeMessage = $"Selected {files.Count} file(s), {FormatBytes(totalBytes)} total.";

        await ParseSelectedFilesAsync();
    }

    private async Task ParseSelectedFilesAsync()
    {
        if (SelectedFiles.Count == 0)
        {
            AnalyzeMessage = "Please select one or more log files first.";
            return;
        }

        IsPreviewing = true;
        IsCancelling = false;
        _uploadCts?.Dispose();
        _uploadCts = new CancellationTokenSource();
        var token = _uploadCts.Token;
        PreviewProgress = 0;
        PreviewStage = "Preparing preview";
        AnalyzeMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var totalFiles = Math.Max(SelectedFiles.Count, 1);
            var fileIndex = 0;
            var totalBytes = SelectedFiles.Sum(x => (long)x.Size);
            var processedBytes = 0L;
            var parsedRows = new List<ParsedLogRow>();

            foreach (var file in SelectedFiles)
            {
                token.ThrowIfCancellationRequested();
                fileIndex++;
                PreviewStage = $"Parsing {file.Name}";
                PreviewProgress = 5 + ((fileIndex - 1) * 90.0 / totalFiles);
                await InvokeAsync(StateHasChanged);

                var parsed = await ReadAndParseFile(file, processedBytes, totalBytes, token);
                processedBytes += (long)file.Size;
                parsedRows.AddRange(parsed);
            }

            AllRows = parsedRows;
            FilteredRows = [];
            FilterDirty = true;
            ResetPage();

            PreviewStage = "Finalizing";
            PreviewProgress = 100;
            await InvokeAsync(StateHasChanged);
            AnalyzeMessage = $"Preview ready: {SelectedFiles.Count} file(s), {AllRows.Count:N0} rows parsed.";
        }
        catch (OperationCanceledException)
        {
            AnalyzeMessage = "Parsing cancelled by user.";
        }
        catch (Exception ex)
        {
            AnalyzeMessage = $"Log parse failed: {ex.Message}";
        }
        finally
        {
            PreviewProgress = 100;
            PreviewStage = IsCancelling ? "Cancelling..." : "Done";
            IsPreviewing = false;
            IsCancelling = false;
            _uploadCts?.Dispose();
            _uploadCts = null;
        }
    }

    private async Task UpdateToServerAsync()
    {
        if (AllRows.Count == 0)
        {
            AnalyzeMessage = "No parsed rows available. Select files first.";
            return;
        }

        IsSaving = true;
        IsCancelling = false;
        _uploadCts?.Dispose();
        _uploadCts = new CancellationTokenSource();
        var token = _uploadCts.Token;
        SaveProgress = 0;
        SaveStage = "Preparing database save";
        AnalyzeMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var serverName = string.IsNullOrWhiteSpace(ServerName) ? "unknown" : ServerName.Trim();
            var nowUtc = DateTime.UtcNow;
            var aggregateMap = AllRows
                .Select(row => new
                {
                    LogDate = TryParseLogDate(row.Date, nowUtc),
                    row.Ip,
                    row.Status
                })
                .GroupBy(x => new { x.LogDate, x.Ip })
                .Select(g => new LogIpAggregate
                {
                    LogDate = g.Key.LogDate,
                    Ip = g.Key.Ip,
                    RequestCount = g.LongCount(),
                    Status2xxCount = g.LongCount(x => IsStatusInRange(x.Status, 200, 299)),
                    Status3xxCount = g.LongCount(x => IsStatusInRange(x.Status, 300, 399)),
                    Status4xxCount = g.LongCount(x => IsStatusInRange(x.Status, 400, 499)),
                    Status5xxCount = g.LongCount(x => IsStatusInRange(x.Status, 500, 599))
                })
                .ToList();

            await using var db = await DbFactory.CreateDbContextAsync();
            var existingRows = await db.LogIpDailyStats
                .Where(x => x.ServerName == serverName)
                .ToListAsync(token);

            var aggregateIndex = 0;
            foreach (var aggregate in aggregateMap)
            {
                token.ThrowIfCancellationRequested();
                aggregateIndex++;
                SaveStage = $"Saving aggregate {aggregateIndex:N0}/{aggregateMap.Count:N0}";
                SaveProgress = aggregateMap.Count == 0 ? 100 : aggregateIndex * 100.0 / aggregateMap.Count;
                await InvokeAsync(StateHasChanged);

                var existing = existingRows.FirstOrDefault(x =>
                    x.LogDate == aggregate.LogDate &&
                    x.Ip == aggregate.Ip);

                if (existing is null)
                {
                    db.LogIpDailyStats.Add(new LogIpDailyStatEntity
                    {
                        ServerName = serverName,
                        LogDate = aggregate.LogDate,
                        Ip = aggregate.Ip,
                        RequestCount = aggregate.RequestCount,
                        Status2xxCount = aggregate.Status2xxCount,
                        Status3xxCount = aggregate.Status3xxCount,
                        Status4xxCount = aggregate.Status4xxCount,
                        Status5xxCount = aggregate.Status5xxCount,
                        FirstSeenUtc = nowUtc,
                        LastSeenUtc = nowUtc
                    });
                }
                else
                {
                    existing.RequestCount += aggregate.RequestCount;
                    existing.Status2xxCount += aggregate.Status2xxCount;
                    existing.Status3xxCount += aggregate.Status3xxCount;
                    existing.Status4xxCount += aggregate.Status4xxCount;
                    existing.Status5xxCount += aggregate.Status5xxCount;
                    existing.LastSeenUtc = nowUtc;
                }
            }

            await db.SaveChangesAsync(token);
            AnalyzeMessage = $"Database update completed: {aggregateMap.Count:N0} aggregate rows saved.";
        }
        catch (OperationCanceledException)
        {
            AnalyzeMessage = "Database update cancelled by user.";
        }
        catch (Exception ex)
        {
            AnalyzeMessage = $"DB update failed: {ex.Message}";
        }
        finally
        {
            SaveProgress = 100;
            SaveStage = IsCancelling ? "Cancelling..." : "Done";
            IsSaving = false;
            IsCancelling = false;
            _uploadCts?.Dispose();
            _uploadCts = null;
        }
    }

    private Task CancelUploadAsync()
    {
        if (!(IsPreviewing || IsSaving))
        {
            return Task.CompletedTask;
        }

        IsCancelling = true;
        PreviewStage = "Cancelling...";
        SaveStage = "Cancelling...";
        _uploadCts?.Cancel();
        return InvokeAsync(StateHasChanged);
    }

    private void ClearSelectedFiles()
    {
        SelectedFiles = [];
        AllRows = [];
        FilteredRows = [];
        FilterDirty = true;
        ResetPage();
        PreviewProgress = 0;
        PreviewStage = "Idle";
        SaveStage = "Idle";
        AnalyzeMessage = null;
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        var unitIndex = 0;

        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.##} {units[unitIndex]}";
    }

    private static DateOnly TryParseLogDate(string value, DateTime fallbackUtc)
    {
        return DateOnly.TryParse(value, out var parsed) ? parsed : DateOnly.FromDateTime(fallbackUtc);
    }

    private static bool IsStatusInRange(string value, int minInclusive, int maxInclusive)
    {
        if (!int.TryParse(value, out var status))
        {
            return false;
        }

        return status >= minInclusive && status <= maxInclusive;
    }


    private List<ParsedLogRow> GetFilteredRows()
    {
        if (!FilterDirty)
        {
            return FilteredRows;
        }

        IEnumerable<ParsedLogRow> query = AllRows;

        if (!string.IsNullOrWhiteSpace(StatusGroup))
        {
            query = query.Where(x => !string.IsNullOrWhiteSpace(x.Status) && x.Status.StartsWith(StatusGroup, StringComparison.Ordinal));
        }

        if (!string.IsNullOrWhiteSpace(StatusCode))
        {
            query = query.Where(x => string.Equals(x.Status, StatusCode.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(UrlQuery))
        {
            query = query.Where(x => x.Uri.Contains(UrlQuery.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(MethodQuery))
        {
            query = query.Where(x => x.Method.Contains(MethodQuery.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(TextQuery))
        {
            var key = TextQuery.Trim();
            query = query.Where(x =>
                x.Ip.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                x.Uri.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                x.Referrer.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                x.UserAgent.Contains(key, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(ExcludeIpQuery))
        {
            var exclude = ParseIpList(ExcludeIpQuery);
            if (exclude.Count > 0)
            {
                query = query.Where(x => !exclude.Contains(x.Ip));
            }
        }

        if (!string.IsNullOrWhiteSpace(DateFilter))
        {
            query = query.Where(x => x.Date.Contains(DateFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(TimeFilter))
        {
            query = query.Where(x => x.Time.Contains(TimeFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(IpFilter))
        {
            query = query.Where(x => x.Ip.Contains(IpFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(MethodFilter))
        {
            query = query.Where(x => x.Method.Contains(MethodFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(UriFilter))
        {
            query = query.Where(x => x.Uri.Contains(UriFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            query = query.Where(x => x.Status.Contains(StatusFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(ReferrerFilter))
        {
            query = query.Where(x => x.Referrer.Contains(ReferrerFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(AgentFilter))
        {
            query = query.Where(x => x.UserAgent.Contains(AgentFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        var filtered = query.ToList();
        FilteredRows = ApplySort(filtered);
        FilterDirty = false;
        return FilteredRows;
    }

    private List<ParsedLogRow> GetPagedRows(List<ParsedLogRow> filtered)
    {
        var totalPages = GetTotalPages(filtered.Count);
        if (CurrentPage > totalPages)
        {
            CurrentPage = totalPages;
        }

        if (CurrentPage < 1)
        {
            CurrentPage = 1;
        }

        return filtered
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private static List<KeyValuePair<string, int>> GetStatusSummary(List<ParsedLogRow> filtered)
    {
        return filtered
            .Where(x => !string.IsNullOrWhiteSpace(x.Status))
            .GroupBy(x => x.Status)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(x => x.Value)
            .ThenBy(x => x.Key, StringComparer.Ordinal)
            .ToList();
    }

    private static List<KeyValuePair<string, int>> GetTopUrls(List<ParsedLogRow> filtered, int take)
    {
        return filtered
            .Where(x => !string.IsNullOrWhiteSpace(x.Uri))
            .GroupBy(x => x.Uri)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(x => x.Value)
            .Take(take)
            .ToList();
    }

    private int GetTotalPages(int count)
    {
        if (count == 0)
        {
            return 1;
        }

        return (int)Math.Ceiling(count / (double)PageSize);
    }

    private int GetStartIndex(int count) => count == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;

    private int GetEndIndex(int count) => Math.Min(CurrentPage * PageSize, count);

    private IEnumerable<int> GetVisiblePages(int count)
    {
        var totalPages = GetTotalPages(count);
        if (totalPages <= 0)
        {
            yield break;
        }
        
        var start = Math.Max(1, CurrentPage - 2);
        var end = Math.Min(totalPages, start + 4);

        if (end - start < 4)
        {
            start = Math.Max(1, end - 4);
        }

        for (var i = start; i <= end; i++)
        {
            yield return i;
        }
    }

    private bool ShouldShowLeadingEllipsis(int count)
    {
        var totalPages = GetTotalPages(count);
        if (totalPages <= 0) return false;

        var start = Math.Max(1, CurrentPage - 2);
        var end = Math.Min(totalPages, start + 4);
        
        if (end - start < 4)
        {
            start = Math.Max(1, end - 4);
        }
        
        return start > 1; 
    }

    private bool ShouldShowTrailingEllipsis(int count)
    {
        var totalPages = GetTotalPages(count);
        if (totalPages <= 0) return false;

        var start = Math.Max(1, CurrentPage - 2);
        var end = Math.Min(totalPages, start + 4);

        return end < totalPages; 
    }

    private void PrevPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }

    private void GoToFirstPage() => CurrentPage = 1;

    private void NextPage(int count)
    {
        var totalPages = GetTotalPages(count);
        if (CurrentPage < totalPages)
        {
            CurrentPage++;
        }
    }

    private void GoToLastPage(int count) => CurrentPage = GetTotalPages(count);

    private void GoToPage(int page) => CurrentPage = page;

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (int.TryParse(value, out var parsed) && parsed > 0)
        {
            PageSize = parsed;
            ResetPage();
        }
    }

    private void ResetPage() => CurrentPage = 1;

