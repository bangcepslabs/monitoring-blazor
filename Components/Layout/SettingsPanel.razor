@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@using System.Net.Http.Json
@using System.Text.Json
@using Monitoring.Blazor.Services
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="settings-page">
    <section class="settings-panel" aria-labelledby="settings-title">
        <div class="settings-header">
            <div>
                <div class="settings-kicker">@Language.T("구성", "Configuration")</div>
                <h2 id="settings-title">@Language.T("설정", "Settings")</h2>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ReloadAsync" disabled="@IsSaving">@Language.T("다시 불러오기", "Reload")</button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@IsSaving">@Language.T("저장", "Save")</button>
                <button type="button" class="settings-close" aria-label="@Language.T("뒤로", "Back")" @onclick="CloseAsync">X</button>
            </div>
        </div>

        <div class="settings-body">
            <div class="settings-tabs" role="tablist" aria-label="Settings categories">
                <button type="button" class="@BasicTabButtonClass" @onclick="ShowBasicTab">@Language.T("기본", "Basic")</button>
                <button type="button" class="@CollectionTabButtonClass" @onclick="ShowCollectionTab">@Language.T("로그 파이프라인", "Log Pipeline")</button>
                <button type="button" class="@AnalysisTabButtonClass" @onclick="ShowAnalysisTab">@Language.T("AI 및 리포트", "AI & Reports")</button>
                <button type="button" class="@IntegrationsTabButtonClass" @onclick="ShowIntegrationsTab">@Language.T("연동", "Integrations")</button>
            </div>
            <div class="settings-summary">
                <div>
                    <div class="settings-summary-title">@TabSummaryTitle</div>
                    <div class="settings-summary-text">@TabSummaryText</div>
                </div>
                <div class="settings-summary-note">@TabSummaryNote</div>
            </div>

            @if (ActiveSettingsTab == "basic")
            {
                <div class="settings-section" id="alert-rules">
                    <div class="settings-section-title">@Language.T("서버 상태 알림", "Server Health Alerts")</div>
                    <div class="settings-section-help">@Language.T("CPU·메모리·디스크·복구·점검 시간에 경고를 발생시킬 조건을 설정합니다.", "Tune when the dashboard should raise warnings for CPU, memory, disk, recovery, or maintenance windows.")</div>
                    <div class="settings-subsections">
                        <div class="settings-subsection">
                            <div class="settings-subsection-heading">
                                <div class="settings-subsection-title">@Language.T("감지 기준", "Detection thresholds")</div>
                                <div class="settings-subsection-help">@Language.T("알림을 사용할지와 CPU·메모리·디스크 경고 기준을 설정합니다.", "Enable alerts and set CPU, memory, and disk thresholds.")</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-md-3">
                                    <label class="form-label">Enabled</label>
                                    <select class="form-select" @bind="AlertEnabledChoice"><option value="Y">Y</option><option value="N">N</option></select>
                                </div>
                                <div class="col-12 col-md-3"><label class="form-label">CPU %</label><input class="form-control" type="number" @bind="AlertSettings.CpuThreshold" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">CPU Minutes</label><input class="form-control" type="number" @bind="AlertSettings.CpuDurationMinutes" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">RAM %</label><input class="form-control" type="number" @bind="AlertSettings.RamThreshold" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">Disk %</label><input class="form-control" type="number" @bind="AlertSettings.DiskThreshold" /></div>
                            </div>
                        </div>
                        <div class="settings-subsection">
                            <div class="settings-subsection-heading">
                                <div class="settings-subsection-title">@Language.T("알림 동작", "Alert behavior")</div>
                                <div class="settings-subsection-help">@Language.T("반복 알림 간격과 복구·이상 징후 알림을 설정합니다.", "Control cooldowns and recovery or anomaly notifications.")</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-md-3"><label class="form-label">Cooldown</label><input class="form-control" type="number" @bind="AlertSettings.CooldownMinutes" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">Recovery</label><select class="form-select" @bind="RecoveryEnabledChoice"><option value="Y">Y</option><option value="N">N</option></select></div>
                                <div class="col-12 col-md-3"><label class="form-label">Recovery Cooldown</label><input class="form-control" type="number" @bind="AlertSettings.RecoveryCooldownMinutes" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">Anomaly</label><select class="form-select" @bind="AnomalyEnabledChoice"><option value="Y">Y</option><option value="N">N</option></select></div>
                            </div>
                        </div>
                        <div class="settings-subsection">
                            <div class="settings-subsection-heading">
                                <div class="settings-subsection-title">@Language.T("점검 시간", "Maintenance window")</div>
                                <div class="settings-subsection-help">@Language.T("정기 점검 중에는 일시적인 상태 변화를 알림에서 제외합니다.", "Suppress expected status changes during scheduled maintenance.")</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-md-4"><label class="form-label">Maintenance Window</label><select class="form-select" @bind="MaintenanceWindowEnabledChoice"><option value="Y">Y</option><option value="N">N</option></select></div>
                                <div class="col-12 col-md-4"><label class="form-label">Window Start</label><input class="form-control" type="time" @bind="MaintenanceWindowStartValue" /></div>
                                <div class="col-12 col-md-4"><label class="form-label">Window End</label><input class="form-control" type="time" @bind="MaintenanceWindowEndValue" /></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-section" id="security">
                    <div class="settings-section-title">@Language.T("계정 보안", "Account Security")</div>
                    <div class="settings-section-help">@Language.T("계정 시스템의 2차 인증을 켜거나 끕니다.", "Turn two-factor authentication on or off for the account system.")</div>
                    <div class="row g-2">
                        <div class="col-12 col-md-3">
                            <label class="form-label">Two-factor authentication</label>
                            <select class="form-select" @bind="TwoFactorEnabledChoice">
                                <option value="Y">Y</option>
                                <option value="N">N</option>
                            </select>
                        </div>
                    </div>
                </div>
            }

            @if (ActiveSettingsTab == "collection")
            {
                <div class="settings-section" id="collection">
                    <div class="settings-section-title">@Language.T("IIS 로그 수집", "IIS Log Collection")</div>
                    <div class="settings-section-help">@Language.T("IIS 로그를 읽을 위치와 리포트 폴더로 복사할 시점을 설정합니다.", "These settings decide where IIS logs are read from and when they are copied into the reporting folder.")</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label">Daily log export</label>
                            <select class="form-select" @bind="LogExportEnabledChoice">
                                <option value="Y">Y</option>
                                <option value="N">N</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">IIS log folder</label>
                            <input class="form-control" @bind="LogExportSettings.LogFolder" placeholder="C:\\inetpub\\logs\\LogFiles\\W3SVC3" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Export folder</label>
                            <input class="form-control" @bind="LogExportSettings.OutputFolder" placeholder="F:\\iis_log" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Export Hour</label>
                            <input class="form-control" type="number" @bind="LogExportSettings.RunHour" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Export Minute</label>
                            <input class="form-control" type="number" @bind="LogExportSettings.RunMinute" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Export Offset Days</label>
                            <input class="form-control" type="number" @bind="LogExportSettings.TargetDateOffsetDays" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Daily log import</label>
                            <select class="form-select" @bind="LogImportEnabledChoice">
                                <option value="Y">Y</option>
                                <option value="N">N</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Import log folder</label>
                            <input class="form-control" @bind="LogImportSettings.LogFolder" placeholder="C:\\inetpub\\logs\\LogFiles\\W3SVC3" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Import state file</label>
                            <input class="form-control" @bind="LogImportSettings.StateFilePath" placeholder="F:\\iis_log\\log-import-state.json" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Import Hour</label>
                            <input class="form-control" type="number" @bind="LogImportSettings.RunHour" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Import Minute</label>
                            <input class="form-control" type="number" @bind="LogImportSettings.RunMinute" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Import Offset Days</label>
                            <input class="form-control" type="number" @bind="LogImportSettings.TargetDateOffsetDays" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Server name for reports</label>
                            <input class="form-control" @bind="LogImportSettings.ServerName" placeholder="HOST-01" />
                        </div>
                    </div>
                </div>
            }

            @if (ActiveSettingsTab == "analysis")
            {
                <div class="settings-section" id="analysis">
                        <div class="settings-section-title">@Language.T("AI 분석", "AI Analysis")</div>
                        <div class="settings-section-help">@Language.T("IIS 로그를 Ollama에 보낼지와 응답 대기 시간을 설정합니다.", "These settings control whether the app sends IIS log data to Ollama and how long it waits for answers.")</div>
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md-3">
                                <label class="form-label">AI Analysis</label>
                                <select class="form-select" @bind="OllamaEnabledChoice">
                                    <option value="Y">Y</option>
                                    <option value="N">N</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">Ollama Base URL</label>
                                <input class="form-control" @bind="OllamaSettings.BaseUrl" placeholder="http://localhost:11434" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">Ollama Model</label>
                                <input class="form-control" @bind="OllamaSettings.Model" placeholder="gemma3:4b" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">Ollama Timeout (sec)</label>
                                <input class="form-control" type="number" @bind="OllamaSettings.TimeoutSeconds" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">Auto analyze</label>
                                <select class="form-select" @bind="OllamaAutoAnalyzeChoice">
                                    <option value="Y">Y</option>
                                    <option value="N">N</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">Auto Analyze Threshold</label>
                                <input class="form-control" type="number" step="0.01" @bind="OllamaSettings.AutoAnalyzeStatus5xxRatio" />
                            </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Analysis output folder</label>
                            <input class="form-control" @bind="OllamaSettings.AnalysisOutputFolder" placeholder="F:\\iis_log\\analysis" />
                            <div class="form-text">This is where the latest IIS analysis JSON is saved and loaded from.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">AI analysis system prompt</label>
                            <textarea class="form-control font-monospace" rows="10" @bind="LogAnalysisSettings.AnalysisSystemPrompt"></textarea>
                            <div class="form-text">This prompt controls the base card report. Leave it unchanged to use the built-in default.</div>
                        </div>
                    </div>
                </div>

                <div class="settings-section" id="analysis-rules">
                    <div class="settings-section-title">@Language.T("로그 분석 규칙", "Log Analysis Rules")</div>
                    <div class="settings-section-help">@Language.T("IIS 로그 분석에 사용할 제외 IP 패턴과 탐지 토큰을 관리합니다. 한 줄에 하나씩 입력하세요.", "Manage excluded IP patterns and custom detection tokens used by the IIS log analyzer. Enter one item per line.")</div>
                    <div class="row g-2">
                        <div class="col-12 col-lg-6">
                            <label class="form-label">Excluded IP patterns</label>
                            <textarea class="form-control font-monospace" rows="5" @bind="ExcludedIpPatternsText" placeholder="121.131.195.*"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label">Priority URL tokens</label>
                            <textarea class="form-control font-monospace" rows="5" @bind="PriorityUrlTokensText" placeholder="board&#10;search&#10;download"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label">Admin probe tokens</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="AdminProbeTokensText" placeholder="admin&#10;manager&#10;login"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label">Backup probe tokens</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="BackupProbeTokensText" placeholder="backup&#10;bak&#10;zip"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label">Config probe tokens</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="ConfigProbeTokensText" placeholder="web.config&#10;appsettings.json&#10;.env"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label">Script / exploit tokens</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="ScriptProbeTokensText" placeholder="powershell&#10;cmd=&#10;phpmyadmin"></textarea>
                        </div>
                    </div>
                </div>

                <div class="settings-section" id="report">
                    <div class="settings-section-title">@Language.T("리포트", "Reports")</div>
                    <div class="settings-section-help">@Language.T("사람이 읽기 쉬운 IIS 분석 리포트를 확인하고 필요할 때만 원본 JSON을 열어보세요.", "View a human-readable IIS analysis report here, and open the raw JSON only when you need the source data.")</div>
                    <div class="row g-2">
                        <div class="col-12 col-lg-8">
                            <label class="form-label">Human-readable report</label>
                            <div class="report-preview">
                                @if (string.IsNullOrWhiteSpace(_iisReportSummary))
                                {
                                    <div class="text-muted">No IIS analysis loaded yet.</div>
                                }
                                else
                                {
                                    <pre class="report-preview-text">@_iisReportSummary</pre>
                                }
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-primary" @onclick="LoadLatestIisReportAsync">Load Latest IIS Report</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="ToggleIisReportJsonView" disabled="@string.IsNullOrWhiteSpace(_iisReportRawJson)">
                                    @(ShowIisReportJson ? "Hide JSON" : "View JSON")
                                </button>
                                <button type="button" class="btn btn-outline-success" @onclick="RunLogExportNowAsync">Run Log Export Now</button>
                                <button type="button" class="btn btn-outline-dark" @onclick="DownloadIisReportAsync" disabled="@string.IsNullOrWhiteSpace(_iisReportRawJson)">Download JSON</button>
                            </div>
                            <div class="text-muted small mt-2">
                                The JSON view is only for copying, downloading, or troubleshooting.
                            </div>
                        </div>
                    </div>
                    @if (ShowIisReportJson)
                    {
                        <div class="mt-3">
                            <label class="form-label">Raw JSON</label>
                            <textarea class="form-control font-monospace" rows="10" readonly>@_iisReportRawJson</textarea>
                        </div>
                    }
                </div>
            }

            @if (ActiveSettingsTab == "integrations")
            {
                <div class="settings-section" id="backup">
                        <div class="settings-section-title">@Language.T("백업 및 복원", "Backup & Restore")</div>
                        <div class="settings-section-help">@Language.T("현재 설정을 JSON으로 내보내거나 나중에 복원합니다.", "Use this to export the current settings as JSON or restore them later.")</div>
                        <div class="mb-2">
                            <label class="form-label">Import backup file</label>
                            <InputFile OnChange="LoadBackupFileAsync" class="form-control" accept=".json,application/json" />
                        </div>
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Backup JSON</label>
                                <textarea class="form-control font-monospace" rows="8" @bind="_backupJson" placeholder="Generate a backup or paste JSON here to restore."></textarea>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CreateBackupAsync">Generate Backup</button>
                            <button type="button" class="btn btn-outline-primary" @onclick="DownloadBackupAsync" disabled="@string.IsNullOrWhiteSpace(_backupJson)">Download Backup</button>
                            <button type="button" class="btn btn-outline-warning" @onclick="RestoreBackupAsync" disabled="@string.IsNullOrWhiteSpace(_backupJson)">Restore Backup</button>
                            <button type="button" class="btn btn-outline-danger" @onclick="ClearBackupAsync" disabled="@string.IsNullOrWhiteSpace(_backupJson)">Clear</button>
                        </div>
                </div>

                <div class="settings-section" id="email">
                        <div class="settings-section-title">@Language.T("이메일 인증 / 재설정", "Email Verification / Reset")</div>
                        <div class="settings-section-help">@Language.T("이메일 회원가입 인증과 비밀번호 재설정을 켜거나 끈 뒤 아래 SMTP 서버를 설정하세요.", "Turn email-based signup verification and password reset on or off, then set the SMTP server below.")</div>
                        <div class="settings-subsections">
                            <div class="settings-subsection">
                                <div class="settings-subsection-heading">
                                    <div class="settings-subsection-title">@Language.T("기능 사용", "Feature switches")</div>
                                    <div class="settings-subsection-help">@Language.T("SMTP 인증, 회원가입 인증, 비밀번호 재설정을 각각 독립적으로 켜고 끕니다.", "Enable SMTP, signup verification, and password reset independently.")</div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-12 col-md-4"><label class="form-label">SMTP auth mode</label><select class="form-select" @bind="EmailEnabledChoice"><option value="Y">Y</option><option value="N">N</option></select></div>
                                    <div class="col-12 col-md-4"><label class="form-label">Signup verification</label><select class="form-select" @bind="EmailVerificationChoice"><option value="Y">Y</option><option value="N">N</option></select></div>
                                    <div class="col-12 col-md-4"><label class="form-label">Password reset</label><select class="form-select" @bind="EmailPasswordResetChoice"><option value="Y">Y</option><option value="N">N</option></select></div>
                                </div>
                            </div>
                            <div class="settings-subsection">
                                <div class="settings-subsection-heading">
                                    <div class="settings-subsection-title">SMTP connection</div>
                                    <div class="settings-subsection-help">@Language.T("메일을 보낼 SMTP 호스트와 인증 정보를 입력합니다.", "Enter the SMTP host, port, encryption, and credentials used to send mail.")</div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-12 col-md-6"><label class="form-label">SMTP Host</label><input class="form-control" @bind="EmailSettings.SmtpHost" placeholder="smtp.example.com" /></div>
                                    <div class="col-12 col-md-3"><label class="form-label">SMTP Port</label><input class="form-control" type="number" @bind="EmailSettings.SmtpPort" /></div>
                                    <div class="col-12 col-md-3"><label class="form-label">SSL</label><select class="form-select" @bind="EmailSslChoice"><option value="Y">Y</option><option value="N">N</option></select></div>
                                    <div class="col-12 col-md-6"><label class="form-label">Username</label><input class="form-control" @bind="EmailSettings.SmtpUsername" autocomplete="off" /></div>
                                    <div class="col-12 col-md-6"><label class="form-label">Password</label><input class="form-control" type="password" @bind="EmailSettings.SmtpPassword" autocomplete="new-password" /></div>
                                </div>
                            </div>
                            <div class="settings-subsection">
                                <div class="settings-subsection-heading">
                                    <div class="settings-subsection-title">Sender and message</div>
                                    <div class="settings-subsection-help">@Language.T("사용자에게 표시될 발신자 정보와 인증 메일 제목을 설정합니다.", "Set the sender identity and the subject shown in verification emails.")</div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-12 col-md-6"><label class="form-label">From Address</label><input class="form-control" @bind="EmailSettings.FromAddress" placeholder="noreply@example.com" /></div>
                                    <div class="col-12 col-md-6"><label class="form-label">From Name</label><input class="form-control" @bind="EmailSettings.FromName" placeholder="OpsEye" /></div>
                                    <div class="col-12"><label class="form-label">Verification Subject</label><input class="form-control" @bind="EmailSettings.VerificationSubject" /></div>
                                </div>
                            </div>
                        </div>
                </div>

                <div class="settings-section" id="chatops">
                        <div class="settings-section-title">@Language.T("알림", "Notifications")</div>
                        <div class="settings-section-help">@Language.T("서버 상태 알림을 받을 채널을 선택합니다. Dooray는 채널 ID와 API 토큰을 사용하고 Discord·카카오워크는 Incoming Webhook을 사용합니다.", "Choose which channels receive server health alerts. Dooray uses its channel ID and API token; Discord and Kakao Work use incoming webhooks.")</div>
                        <div class="notification-channels">
                            <div class="notification-channel notification-channel--master">
                                <div class="notification-channel__copy">
                                    <strong>@Language.T("서버 알림", "Server notifications")</strong>
                                    <span>@Language.T("모든 알림 채널의 전송을 켜거나 끕니다.", "Enable or disable delivery to all notification channels.")</span>
                                </div>
                                <label class="form-switch-control" for="notificationsEnabled">
                                    <input id="notificationsEnabled" type="checkbox" @bind="NotificationSettings.Enabled" />
                                    <span class="form-switch-control__track" aria-hidden="true"></span>
                                    <span class="form-switch-control__state">@(NotificationSettings.Enabled ? Language.T("켜짐", "On") : Language.T("꺼짐", "Off"))</span>
                                </label>
                            </div>

                            <div class="notification-channel-grid">
                                <div class="notification-channel">
                                    <div class="notification-channel__copy"><strong>Slack</strong><span>Slack Webhook</span></div>
                                    <label class="form-switch-control" for="slackEnabled"><input id="slackEnabled" type="checkbox" @bind="NotificationSettings.SlackEnabled" /><span class="form-switch-control__track" aria-hidden="true"></span><span class="form-switch-control__state">@(NotificationSettings.SlackEnabled ? Language.T("켜짐", "On") : Language.T("꺼짐", "Off"))</span></label>
                                    <input class="form-control notification-channel__input" @bind="NotificationSettings.SlackWebhookUrl" placeholder="https://hooks.slack.com/..." />
                                </div>
                                <div class="notification-channel">
                                    <div class="notification-channel__copy"><strong>Microsoft Teams</strong><span>Teams Webhook</span></div>
                                    <label class="form-switch-control" for="teamsEnabled"><input id="teamsEnabled" type="checkbox" @bind="NotificationSettings.TeamsEnabled" /><span class="form-switch-control__track" aria-hidden="true"></span><span class="form-switch-control__state">@(NotificationSettings.TeamsEnabled ? Language.T("켜짐", "On") : Language.T("꺼짐", "Off"))</span></label>
                                    <input class="form-control notification-channel__input" @bind="NotificationSettings.TeamsWebhookUrl" placeholder="https://outlook.office.com/webhook/..." />
                                </div>
                                <div class="notification-channel">
                                    <div class="notification-channel__copy"><strong>Dooray</strong><span>@Language.T("채널 ID와 API 토큰", "Channel ID and API token")</span></div>
                                    <label class="form-switch-control" for="doorayEnabled"><input id="doorayEnabled" type="checkbox" @bind="NotificationSettings.DoorayEnabled" /><span class="form-switch-control__track" aria-hidden="true"></span><span class="form-switch-control__state">@(NotificationSettings.DoorayEnabled ? Language.T("켜짐", "On") : Language.T("꺼짐", "Off"))</span></label>
                                    <div class="notification-channel__fields"><input class="form-control" @bind="NotificationSettings.DoorayChannelId" placeholder="@Language.T("채널 ID", "Channel ID")" /><input class="form-control" type="password" @bind="NotificationSettings.DoorayApiToken" placeholder="@Language.T("API 토큰", "API token")" /></div>
                                </div>
                                <div class="notification-channel">
                                    <div class="notification-channel__copy"><strong>Discord</strong><span>Incoming Webhook</span></div>
                                    <label class="form-switch-control" for="discordEnabled"><input id="discordEnabled" type="checkbox" @bind="NotificationSettings.DiscordEnabled" /><span class="form-switch-control__track" aria-hidden="true"></span><span class="form-switch-control__state">@(NotificationSettings.DiscordEnabled ? Language.T("켜짐", "On") : Language.T("꺼짐", "Off"))</span></label>
                                    <input class="form-control notification-channel__input" @bind="NotificationSettings.DiscordWebhookUrl" placeholder="https://discord.com/api/webhooks/..." />
                                </div>
                                <div class="notification-channel">
                                    <div class="notification-channel__copy"><strong>Kakao Work</strong><span>Incoming Webhook</span></div>
                                    <label class="form-switch-control" for="kakaoWorkEnabled"><input id="kakaoWorkEnabled" type="checkbox" @bind="NotificationSettings.KakaoWorkEnabled" /><span class="form-switch-control__track" aria-hidden="true"></span><span class="form-switch-control__state">@(NotificationSettings.KakaoWorkEnabled ? Language.T("켜짐", "On") : Language.T("꺼짐", "Off"))</span></label>
                                    <input class="form-control notification-channel__input" @bind="NotificationSettings.KakaoWorkWebhookUrl" placeholder="https://hooks.kakao.work/..." />
                                </div>
                                <div class="notification-channel">
                                    <div class="notification-channel__copy"><strong>@Language.T("일반 Webhook", "Generic Webhook")</strong><span>Webhook URL</span></div>
                                    <label class="form-switch-control" for="webhookEnabled"><input id="webhookEnabled" type="checkbox" @bind="NotificationSettings.WebhookEnabled" /><span class="form-switch-control__track" aria-hidden="true"></span><span class="form-switch-control__state">@(NotificationSettings.WebhookEnabled ? Language.T("켜짐", "On") : Language.T("꺼짐", "Off"))</span></label>
                                    <input class="form-control notification-channel__input" @bind="NotificationSettings.WebhookUrl" placeholder="https://example.com/webhook" />
                                </div>
                            </div>
                        </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="alert alert-secondary mb-0">@StatusMessage</div>
            }
        </div>

        <div class="settings-footer">
            <button class="btn btn-outline-secondary" @onclick="ReloadAsync" disabled="@IsSaving">Reload</button>
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@IsSaving">Save</button>
        </div>
    </section>
</div>

@code {
    private AlertSettings AlertSettings { get; set; } = new();
    private SecuritySettings SecuritySettings { get; set; } = new();
    private bool IsOpen { get; set; }
    private bool IsSaving { get; set; }
    private string ActiveSettingsTab { get; set; } = "basic";
    private string? StatusMessage { get; set; }
    private EmailSettings EmailSettings { get; set; } = new();
    private NotificationSettings NotificationSettings { get; set; } = new();
    private OllamaRuntimeSettings OllamaSettings { get; set; } = new();
    private LogExportRuntimeSettings LogExportSettings { get; set; } = new();
    private LogImportRuntimeSettings LogImportSettings { get; set; } = new();
    private LogAnalysisRuntimeSettings LogAnalysisSettings { get; set; } = new();
    private string _backupJson = string.Empty;
    private string _iisReportSummary = string.Empty;
    private string _iisReportRawJson = string.Empty;
    private bool ShowIisReportJson { get; set; }

    private string AlertEnabledChoice
    {
        get => AlertSettings.Enabled ? "Y" : "N";
        set => AlertSettings.Enabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string RecoveryEnabledChoice
    {
        get => AlertSettings.RecoveryEnabled ? "Y" : "N";
        set => AlertSettings.RecoveryEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string AnomalyEnabledChoice
    {
        get => AlertSettings.AnomalyEnabled ? "Y" : "N";
        set => AlertSettings.AnomalyEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string MaintenanceWindowEnabledChoice
    {
        get => AlertSettings.MaintenanceWindowEnabled ? "Y" : "N";
        set => AlertSettings.MaintenanceWindowEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string TwoFactorEnabledChoice
    {
        get => SecuritySettings.TwoFactorEnabled ? "Y" : "N";
        set => SecuritySettings.TwoFactorEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string OllamaEnabledChoice
    {
        get => OllamaSettings.Enabled ? "Y" : "N";
        set => OllamaSettings.Enabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string OllamaAutoAnalyzeChoice
    {
        get => OllamaSettings.AutoAnalyzeEnabled ? "Y" : "N";
        set => OllamaSettings.AutoAnalyzeEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string LogExportEnabledChoice
    {
        get => LogExportSettings.Enabled ? "Y" : "N";
        set => LogExportSettings.Enabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string LogImportEnabledChoice
    {
        get => LogImportSettings.Enabled ? "Y" : "N";
        set => LogImportSettings.Enabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string EmailEnabledChoice
    {
        get => EmailSettings.Enabled ? "Y" : "N";
        set => EmailSettings.Enabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string EmailVerificationChoice
    {
        get => EmailSettings.VerificationEnabled ? "Y" : "N";
        set => EmailSettings.VerificationEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string EmailPasswordResetChoice
    {
        get => EmailSettings.PasswordResetEnabled ? "Y" : "N";
        set => EmailSettings.PasswordResetEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string EmailSslChoice
    {
        get => EmailSettings.EnableSsl ? "Y" : "N";
        set => EmailSettings.EnableSsl = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string NotificationsEnabledChoice
    {
        get => NotificationSettings.Enabled ? "Y" : "N";
        set => NotificationSettings.Enabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string SlackEnabledChoice
    {
        get => NotificationSettings.SlackEnabled ? "Y" : "N";
        set => NotificationSettings.SlackEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string TeamsEnabledChoice
    {
        get => NotificationSettings.TeamsEnabled ? "Y" : "N";
        set => NotificationSettings.TeamsEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string WebhookEnabledChoice
    {
        get => NotificationSettings.WebhookEnabled ? "Y" : "N";
        set => NotificationSettings.WebhookEnabled = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
    }

    private string ExcludedIpPatternsText
    {
        get => string.Join(Environment.NewLine, LogAnalysisSettings.ExcludedIpPatterns);
        set => LogAnalysisSettings.ExcludedIpPatterns = SplitLines(value);
    }

    private string PriorityUrlTokensText
    {
        get => string.Join(Environment.NewLine, LogAnalysisSettings.PriorityUrlTokens);
        set => LogAnalysisSettings.PriorityUrlTokens = SplitLines(value);
    }

    private string AdminProbeTokensText
    {
        get => string.Join(Environment.NewLine, LogAnalysisSettings.AdminProbeTokens);
        set => LogAnalysisSettings.AdminProbeTokens = SplitLines(value);
    }

    private string BackupProbeTokensText
    {
        get => string.Join(Environment.NewLine, LogAnalysisSettings.BackupProbeTokens);
        set => LogAnalysisSettings.BackupProbeTokens = SplitLines(value);
    }

    private string ConfigProbeTokensText
    {
        get => string.Join(Environment.NewLine, LogAnalysisSettings.ConfigProbeTokens);
        set => LogAnalysisSettings.ConfigProbeTokens = SplitLines(value);
    }

    private string ScriptProbeTokensText
    {
        get => string.Join(Environment.NewLine, LogAnalysisSettings.ScriptProbeTokens);
        set => LogAnalysisSettings.ScriptProbeTokens = SplitLines(value);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private string BasicTabButtonClass => TabButtonClass("basic");
    private string CollectionTabButtonClass => TabButtonClass("collection");
    private string AnalysisTabButtonClass => TabButtonClass("analysis");
    private string IntegrationsTabButtonClass => TabButtonClass("integrations");

    private string TabSummaryTitle => ActiveSettingsTab switch
    {
        "basic" => "Basic settings",
        "collection" => "IIS log pipeline",
        "analysis" => "AI analysis and reports",
        "integrations" => "Backup, email, and notifications",
        _ => "Settings"
    };

    private string TabSummaryText => ActiveSettingsTab switch
    {
        "basic" => "Server health alerts and account security.",
        "collection" => "Where IIS logs are picked up, exported, and imported.",
        "analysis" => "Ollama analysis, detection rules, and where report JSON is stored.",
        "integrations" => "Backups, email verification/reset, and outbound notifications.",
        _ => string.Empty
    };

    private string TabSummaryNote => ActiveSettingsTab switch
    {
        "basic" => "Start here if you only want to tune the main behavior.",
        "collection" => "Check this first if logs are not showing up.",
        "analysis" => "Tune this when you need custom detection logic or report storage.",
        "integrations" => "Used when you need recovery or external delivery.",
        _ => string.Empty
    };

    private void ShowBasicTab() => ActiveSettingsTab = "basic";
    private void ShowCollectionTab() => ActiveSettingsTab = "collection";
    private void ShowAnalysisTab() => ActiveSettingsTab = "analysis";
    private void ShowIntegrationsTab() => ActiveSettingsTab = "integrations";

    private string TabButtonClass(string tabKey)
        => ActiveSettingsTab == tabKey ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";

    private TimeOnly? MaintenanceWindowStartValue
    {
        get => TryParseTimeOnly(AlertSettings.MaintenanceWindowStart, out var value) ? value : null;
        set => AlertSettings.MaintenanceWindowStart = value?.ToString("HH:mm") ?? string.Empty;
    }

    private TimeOnly? MaintenanceWindowEndValue
    {
        get => TryParseTimeOnly(AlertSettings.MaintenanceWindowEnd, out var value) ? value : null;
        set => AlertSettings.MaintenanceWindowEnd = value?.ToString("HH:mm") ?? string.Empty;
    }

    public async Task OpenAsync()
    {
        NavigationManager.NavigateTo("/settings");
    }

    public Task CloseAsync()
    {
        NavigationManager.NavigateTo("/");
        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            StatusMessage = null;
            var client = CreateClient();
            var settings = await client.GetFromJsonAsync<AlertSettings>("api/alerts/settings");
            if (settings is not null)
            {
                AlertSettings = settings;
            }

            var securitySettings = await client.GetFromJsonAsync<SecuritySettings>("api/security/settings");
            if (securitySettings is not null)
            {
                SecuritySettings = securitySettings;
            }

            var ollamaResponse = await client.GetFromJsonAsync<OllamaRuntimeSettings>("api/runtime/ollama");
            if (ollamaResponse is not null)
            {
                OllamaSettings = ollamaResponse;
            }

            var logExportResponse = await client.GetFromJsonAsync<LogExportRuntimeSettings>("api/runtime/log-export");
            if (logExportResponse is not null)
            {
                LogExportSettings = logExportResponse;
            }

            var logImportResponse = await client.GetFromJsonAsync<LogImportRuntimeSettings>("api/runtime/log-import");
            if (logImportResponse is not null)
            {
                LogImportSettings = logImportResponse;
            }

            var logAnalysisResponse = await client.GetFromJsonAsync<LogAnalysisRuntimeSettings>("api/runtime/log-analysis-rules");
            if (logAnalysisResponse is not null)
            {
                LogAnalysisSettings = logAnalysisResponse;
            }

            var emailResponse = await client.GetFromJsonAsync<EmailSettings>("api/email/settings");
            if (emailResponse is not null)
            {
                EmailSettings = emailResponse;
            }

            var notificationResponse = await client.GetFromJsonAsync<NotificationSettings>("api/notification/settings");
            if (notificationResponse is not null)
            {
                NotificationSettings = notificationResponse;
            }
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        if (IsSaving)
        {
            return;
        }

        IsSaving = true;
        StatusMessage = null;
        try
        {
            await SaveJsonAsync("api/alerts/settings", AlertSettings);

            await SaveJsonAsync("api/security/settings", SecuritySettings);

            await SaveJsonAsync("api/email/settings", EmailSettings);

            await SaveJsonAsync("api/notification/settings", NotificationSettings);

            await SaveJsonAsync("api/runtime/ollama", OllamaSettings);

            await SaveJsonAsync("api/runtime/log-export", LogExportSettings);

            await SaveJsonAsync("api/runtime/log-import", LogImportSettings);

            await SaveJsonAsync("api/runtime/log-analysis-rules", LogAnalysisSettings);

            StatusMessage = Language.T("설정을 저장했습니다.", "Settings saved.");
            await JS.InvokeVoidAsync("monitorSettings.showToast", StatusMessage, "success");
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
            await JS.InvokeVoidAsync("monitorSettings.showToast", Language.T("설정 저장에 실패했습니다.", "Settings could not be saved."), "danger");
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateBackupAsync()
    {
        try
        {
            var client = CreateClient();
            _backupJson = await client.GetStringAsync("api/settings/backup");
            StatusMessage = "Backup JSON generated.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadLatestIisReportAsync()
    {
        try
        {
            var client = CreateClient();
            var latest = await client.GetFromJsonAsync<OllamaAnalysisEntry>("api/ollama/latest");
            _iisReportSummary = latest?.Response ?? string.Empty;
            _iisReportRawJson = latest is null
                ? string.Empty
                : JsonSerializer.Serialize(latest, new JsonSerializerOptions { WriteIndented = true });
            ShowIisReportJson = false;
            StatusMessage = latest is null
                ? "No IIS analysis found."
                : "Latest IIS analysis loaded.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadIisReportAsync()
    {
        if (string.IsNullOrWhiteSpace(_iisReportRawJson))
        {
            StatusMessage = "IIS report JSON is empty.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var fileName = $"iis-report-{DateTime.Now:yyyyMMdd-HHmmss}.json";
        await JS.InvokeVoidAsync("monitorSettings.downloadText", fileName, _iisReportRawJson, "application/json");
        StatusMessage = $"Download started: {fileName}.";
        await InvokeAsync(StateHasChanged);
    }

    private Task ToggleIisReportJsonView()
    {
        ShowIisReportJson = !ShowIisReportJson;
        return InvokeAsync(StateHasChanged);
    }

    private async Task RunLogExportNowAsync()
    {
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync("api/log-export/run", null);
            var body = await response.Content.ReadAsStringAsync();
            response.EnsureSuccessStatusCode();
            StatusMessage = string.IsNullOrWhiteSpace(body) ? "Log export completed." : body;
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadBackupAsync()
    {
        if (string.IsNullOrWhiteSpace(_backupJson))
        {
            StatusMessage = "Backup JSON is empty.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var fileName = $"settings-backup-{DateTime.Now:yyyyMMdd-HHmmss}.json";
        await JS.InvokeVoidAsync("monitorSettings.downloadText", fileName, _backupJson, "application/json");
        StatusMessage = $"Download started: {fileName}.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task RestoreBackupAsync()
    {
        if (string.IsNullOrWhiteSpace(_backupJson))
        {
            StatusMessage = "Backup JSON is empty.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var payload = JsonSerializer.Deserialize<SettingsBackupPayload>(_backupJson);
            if (payload is null)
            {
                throw new InvalidOperationException("Invalid backup JSON.");
            }

            var client = CreateClient();
            var response = await client.PostAsJsonAsync("api/settings/restore", payload);
            response.EnsureSuccessStatusCode();
            StatusMessage = "Backup restored.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadBackupFileAsync(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;
            if (file is null)
            {
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            _backupJson = await reader.ReadToEndAsync();
            StatusMessage = $"Loaded backup file: {file.Name}.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task ClearBackupAsync()
    {
        _backupJson = string.Empty;
        StatusMessage = "Backup JSON cleared.";
        return InvokeAsync(StateHasChanged);
    }

    private HttpClient CreateClient()
    {
        var client = HttpClientFactory.CreateClient();
        client.BaseAddress = new Uri(NavigationManager.BaseUri);
        return client;
    }

    private async Task SaveJsonAsync<T>(string endpoint, T payload)
    {
        var response = await JS.InvokeAsync<BrowserApiResponse>("monitorSettings.postJson", endpoint, payload);
        if (!response.Ok)
        {
            var detail = string.IsNullOrWhiteSpace(response.Body) ? "no response body" : response.Body.Trim();
            throw new InvalidOperationException($"{endpoint} failed ({response.Status}): {detail}");
        }
    }

    private sealed record BrowserApiResponse(bool Ok, int Status, string? Body);

    private static bool TryParseTimeOnly(string? value, out TimeOnly time)
    {
        if (TimeOnly.TryParse(value, out time))
        {
            return true;
        }

        time = default;
        return false;
    }

    private static List<string> SplitLines(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        return value
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
