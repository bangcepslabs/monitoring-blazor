    }

    private string UriFilter
    {
        get => _uriFilter;
        set { _uriFilter = value; FilterDirty = true; }
    }

    private string StatusFilter
    {
        get => _statusFilter;
        set { _statusFilter = value; FilterDirty = true; }
    }

    private string ReferrerFilter
    {
        get => _referrerFilter;
        set { _referrerFilter = value; FilterDirty = true; }
    }

    private string AgentFilter
    {
        get => _agentFilter;
        set { _agentFilter = value; FilterDirty = true; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                UseOllama = await JS.InvokeAsync<bool>("monitorSettings.get", "ollamaEnabled", true);
                IsAnalysisReportCollapsed = await JS.InvokeAsync<bool>("monitorSettings.get", "logParser.analysisCollapsed", false);
                IsRecentReportsCollapsed = await JS.InvokeAsync<bool>("monitorSettings.get", "logParser.recentReportsCollapsed", false);
                _settingsRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("monitorSettings.watch", "ollamaEnabled", _settingsRef, nameof(OnOllamaPreferenceChanged));
                await LoadRuntimeAnalysisSettingsAsync();
                await LoadRecentAnalysisHistoryAsync();
                await JS.InvokeVoidAsync("logParserColumns.init", "#log-entries-grid", "logParser.columns");
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                UseOllama = true;
            }
        }

        if (!string.IsNullOrWhiteSpace(AnalyzeMessage))
        {
            try
            {
                await JS.InvokeVoidAsync("logParserAnalysis.initTopIpChart", "logParserTopIpChart", GetTopIpAccess(GetFilteredRows(), 5));
            }
            catch
            {
                // Chart rendering is supplemental; the report remains usable without it.
            }
        }
    }
