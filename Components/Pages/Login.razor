@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Monitoring.Blazor.Services
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject EmailSettingsRepository EmailSettingsRepository
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>OpsEye | @Language.T("로그인", "Login")</PageTitle>

<div class="login-page">
    <section class="login-auth-panel" aria-label="@Language.T("로그인 양식", "Login form")">
        <div class="login-shell">
        <div class="login-brand">
            <div class="login-brand-mark" aria-hidden="true">
                <i class="bi bi-eye-fill"></i>
            </div>
            <div>
                <div class="login-brand-name">OpsEye</div>
                <div class="login-brand-sub">@Language.T("운영 대시보드", "Operations Dashboard")</div>
            </div>
        </div>

        <div class="login-card card">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h1 class="h3 mb-2">@Language.T("로그인", "Sign in")</h1>
                    <p class="text-secondary mb-0">
                        @Language.T("서버 상태와 운영 기록을 확인하려면 로그인하세요.", "Sign in to monitor your servers and review activity.")
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert alert-warning" role="alert">@Language.Localize(_message)</div>
                }

                <form method="post" action="/auth/login" class="d-grid gap-3">
                    <input type="hidden" name="returnUrl" value="@_returnUrl" />

                    <div>
                        <label class="form-label" for="login-user">@Language.T("사용자 ID", "User ID")</label>
                        <input id="login-user" name="userName" class="form-control" autocomplete="username" required value="@_lastUserName" />
                    </div>

                    <div>
                        <label class="form-label" for="login-password">@Language.T("비밀번호", "Password")</label>
                        <input id="login-password" name="password" type="password" class="form-control" autocomplete="current-password" required />
                    </div>

                    <div class="form-check">
                        <input id="login-remember" name="rememberMe" type="checkbox" class="form-check-input" value="true" checked />
                        <label class="form-check-label" for="login-remember">@Language.T("로그인 상태 유지", "Remember me")</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>@Language.T("로그인", "Sign in")
                        </button>
                        @if (_passwordResetEnabled)
                        {
                            <a class="btn btn-link text-decoration-none" href="/forgot-password">@Language.T("비밀번호를 잊으셨나요?", "Forgot password?")</a>
                        }
                        else
                        {
                            <span class="text-secondary small">@Language.T("비밀번호 재설정은 관리자에게 문의하세요.", "Password reset is managed by an administrator.")</span>
                        }
                        <a class="btn btn-outline-secondary" href="/register?returnUrl=@Uri.EscapeDataString(_returnUrl)">@Language.T("계정 만들기", "Create an account")</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="login-footnote">
            <span>OpsEye</span>
            <span aria-hidden="true">&middot;</span>
            <span>@Language.T("로컬 계정 인증", "Local account authentication")</span>
        </div>
        </div>
    </section>

    <aside class="login-visual-panel" aria-hidden="true">
        <div class="login-visual-brand">
            <i class="bi bi-eye-fill"></i>
            <span>OpsEye</span>
        </div>
        <div class="login-visual-copy">
            <p class="login-visual-kicker">@Language.T("운영 현황 한눈에 보기", "OPERATIONS AT A GLANCE")</p>
            <h2>@Language.T("운영의 흐름을", "Your operations.")<br />@Language.T("한눈에.", "A clearer view.")</h2>
            <p>@Language.T("서버 모니터링부터 로그 분석까지. 필요한 정보를 한곳에서 확인하고 문제에 빠르게 대응하세요.", "From server health to log analysis. Find what matters and respond with confidence.")</p>
        </div>
        <div class="login-globe-stage">
            <canvas @ref="_globeCanvas" class="login-globe-canvas"></canvas>
            <div class="login-globe-wash"></div>
        </div>
    </aside>
</div>

@code {
    private string _returnUrl = "/";
    private string _lastUserName = string.Empty;
    private string? _message;
    private bool _passwordResetEnabled;
    private ElementReference _globeCanvas;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("returnUrl", out var returnUrl) && !string.IsNullOrWhiteSpace(returnUrl))
        {
            _returnUrl = returnUrl.ToString();
        }

        if (query.TryGetValue("error", out var error) && !string.IsNullOrWhiteSpace(error))
        {
            _message = error.ToString() switch
            {
                "invalid" => Language.T("사용자 ID 또는 비밀번호가 올바르지 않습니다.", "Invalid username or password."),
                "inactive" => Language.T("비활성화된 계정입니다.", "This account is inactive."),
                "locked" => Language.T("로그인 실패가 반복되어 계정이 일시적으로 잠겼습니다.", "This account is temporarily locked because of repeated failed sign-in attempts."),
                "duplicate" => Language.T("이미 존재하는 사용자 이름입니다.", "This user name already exists."),
                "password_mismatch" => Language.T("비밀번호가 일치하지 않습니다.", "Passwords do not match."),
                "password_policy" => Language.T("비밀번호가 요구 사항을 충족하지 않습니다.", "The password does not meet the requirements."),
                "required" => Language.T("필수 입력값이 누락되었습니다.", "Required fields are missing."),
                "email_unverified" => Language.T("로그인 전에 이메일 주소를 인증하세요.", "Please verify your email address before signing in."),
                _ => error.ToString()
            };
        }

        if (query.TryGetValue("success", out var success) && success.ToString() == "registered")
        {
            _message = Language.T("계정이 생성되었습니다. 로그인하세요.", "Account created. Please sign in.");
        }

        if (query.TryGetValue("success", out var emailSuccess) && emailSuccess.ToString() == "verification_sent")
        {
            _message = Language.T("계정이 생성되었습니다. 로그인 전에 이메일 인증을 완료하세요.", "Account created. Please check your email to verify your address before signing in.");
        }

        var baseSettings = Configuration.GetSection("Monitoring:Email").Get<EmailSettings>() ?? new EmailSettings();
        var emailSettings = EmailSettingsRepository.Load(baseSettings);
        _passwordResetEnabled = emailSettings.Enabled && emailSettings.PasswordResetEnabled;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo(_returnUrl, forceLoad: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("loginGlobe.init", _globeCanvas);
        }
        catch (JSDisconnectedException)
        {
            // The circuit can close while navigating away from the login page.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("loginGlobe.dispose", _globeCanvas);
        }
        catch (JSDisconnectedException)
        {
            // The browser context is already gone.
        }
    }
}


