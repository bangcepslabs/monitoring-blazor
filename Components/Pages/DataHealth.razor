@page "/admin/data-health"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using Monitoring.Blazor.Models
@using Monitoring.Blazor.Services
@inject IDbContextFactory<MonitoringDbContext> DbFactory
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject ApiMetricsState ApiMetricsState

<PageTitle>OpsEye | Data health</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 data-health-page-header">
        <div>
            <div class="text-uppercase text-muted small mb-1">Operations</div>
            <h1 class="h3 mb-1">Data health</h1>
            <p class="text-secondary mb-0">Monitor storage usage and retention settings.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="LoadAsync">Refresh</button>
            <button class="btn btn-outline-danger" @onclick="CleanupAsync" disabled="@IsCleaning">@(IsCleaning ? "Cleaning..." : "Run cleanup now")</button>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header"><strong>API metrics</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 data-health-table">
                        <thead><tr><th>Endpoint</th><th class="text-end">Requests</th><th class="text-end">Errors</th><th class="text-end">Avg ms</th></tr></thead>
                        <tbody>@foreach (var metric in ApiMetrics) { <tr><td>@metric.Path</td><td class="text-end">@metric.Requests.ToString("N0")</td><td class="text-end">@metric.Errors.ToString("N0")</td><td class="text-end">@metric.AverageMs.ToString("N1")</td></tr> }</tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Table storage</strong></div>
                <div class="table-responsive">
                    @if (IsLoading)
                    {
                        <div class="p-4 text-secondary" role="status">Loading storage metrics...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(LoadError))
                    {
                        <div class="p-4">
                            <div class="alert alert-danger mb-2" role="alert">@LoadError</div>
                            <button class="btn btn-sm btn-outline-danger" @onclick="LoadAsync">Retry</button>
                        </div>
                    }
                    else
                    {
                    <table class="table table-hover align-middle mb-0 data-health-table">
                        <thead><tr><th>Table</th><th class="text-end">Rows</th><th class="text-end">Size</th></tr></thead>
                        <tbody>
                            @foreach (var table in Tables)
                            {
                                <tr><td>@table.TableName</td><td class="text-end">@table.RowCount.ToString("N0")</td><td class="text-end">@table.SizeMb.ToString("N2") MB</td></tr>
                            }
                        </tbody>
                    </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Retention policy</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-8">Snapshots</dt><dd class="col-4 text-end">@SnapshotDays days</dd>
                        <dt class="col-8">Alerts</dt><dd class="col-4 text-end">@AlertDays days</dd>
                        <dt class="col-8">IP statistics</dt><dd class="col-4 text-end">@LogStatsDays days</dd>
                        <dt class="col-8">Cleanup interval</dt><dd class="col-4 text-end">@CleanupMinutes min</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(CleanupMessage))
    {
        <div class="alert alert-info" role="status">@CleanupMessage</div>
    }
</div>

@code {
    private List<DatabaseTableSizeRow> Tables { get; set; } = [];
    private List<ApiMetricSnapshot> ApiMetrics { get; set; } = [];
    private bool IsLoading { get; set; }
    private string? LoadError { get; set; }
    private bool IsCleaning { get; set; }
    private string? CleanupMessage { get; set; }
    private int SnapshotDays => Configuration.GetValue("Monitoring:Retention:SnapshotDays", 30);
    private int AlertDays => Configuration.GetValue("Monitoring:Retention:AlertDays", 90);
    private int LogStatsDays => Configuration.GetValue("Monitoring:Retention:LogIpDailyStatDays", 365);
    private int CleanupMinutes => Configuration.GetValue("Monitoring:Retention:CleanupIntervalMinutes", 60);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        LoadError = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            Tables = await db.DatabaseTableSizes.FromSqlRaw("""
SELECT t.name AS TableName, SUM(p.rows) AS RowCount,
       CAST(SUM(a.total_pages) * 8.0 / 1024 AS decimal(12,2)) AS SizeMb
FROM sys.tables t JOIN sys.indexes i ON t.object_id=i.object_id
JOIN sys.partitions p ON i.object_id=p.object_id AND i.index_id=p.index_id
JOIN sys.allocation_units a ON p.partition_id=a.container_id
WHERE t.name IN ('HostSnapshots','AlertEvents','LogIpDailyStats','AlertSuppressions')
GROUP BY t.name ORDER BY SizeMb DESC
""").AsNoTracking().ToListAsync();
            ApiMetrics = ApiMetricsState.GetSnapshot().ToList();
        }
        catch
        {
            LoadError = "Storage metrics could not be loaded.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CleanupAsync()
    {
        IsCleaning = true;
        CleanupMessage = null;
        try
        {
            using var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
            var response = await client.PostAsync("api/admin/data-health/cleanup", null);
            response.EnsureSuccessStatusCode();
            CleanupMessage = "Cleanup completed.";
            await LoadAsync();
        }
        catch
        {
            CleanupMessage = "Cleanup failed. Check the server logs.";
        }
        finally
        {
            IsCleaning = false;
        }
    }
}
