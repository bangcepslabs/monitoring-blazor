    private async Task LoadHistoryAsync(string host, int? windowMinutesOverride = null)
    {
        if (_http is null)
        {
            return;
        }

        var windowMinutes = windowMinutesOverride ?? Configuration.GetValue<int?>("Monitoring:History:WindowMinutes") ?? DefaultHistoryWindowMinutes;
        if (windowMinutes <= 0)
        {
            windowMinutes = DefaultHistoryWindowMinutes;
        }

        try
        {
            var url = $"api/monitor/history?hostname={Uri.EscapeDataString(host)}&minutes={windowMinutes}";
            var response = await _http.GetFromJsonAsync<HistoryResponse>(url);
            if (response?.Data is null)
            {
                return;
            }

            var history = new HistorySeries();
            foreach (var row in response.Data)
            {
                history.Points.Add(new HistoryPoint
                {
                    TimestampUtc = row.CreatedUtc,
                    TimeLabel = row.CreatedUtc.ToLocalTime().ToString("MM-dd HH:mm"),
                    Tx = row.SentMbps,
                    Rx = row.RecvMbps,
                    Cpu = row.CpuUsage,
                    Memory = row.MemoryUsage,
                    Disk = row.DiskUsage
                });
            }

            ChartHistories[host] = history;
            _currentHistoryWindowMinutes = windowMinutes;
        }
        catch
        {
            // ignore history load failures
        }
    }

    private void TrimHistory(HistorySeries history)
    {
        // 현재 선택된 범위 중 가장 넓은 것을 기준으로 trim
        var configMinutes = Configuration.GetValue<int?>("Monitoring:History:WindowMinutes") ?? DefaultHistoryWindowMinutes;
        if (configMinutes <= 0) configMinutes = DefaultHistoryWindowMinutes;

        var windowMinutes = Math.Max(configMinutes, _currentHistoryWindowMinutes);

        var cutoff = DateTime.UtcNow.AddMinutes(-windowMinutes);
        while (history.Points.Count > 0 && history.Points[0].TimestampUtc < cutoff)
        {
            history.Points.RemoveAt(0);
        }
    }

    private static void TrimLiveHistory(HistorySeries history)
    {
        const int maxLivePoints = 60;
        while (history.Points.Count > maxLivePoints)
        {
            history.Points.RemoveAt(0);
        }
    }

    private bool TryGetChartHistory(string host, out HistorySeries history)
    {
        if (ChartHistories.TryGetValue(host, out var chartHistory) && chartHistory is not null)
        {
            history = chartHistory;
            return true;
        }

        if (Histories.TryGetValue(host, out var liveHistory) && liveHistory is not null)
        {
            history = liveHistory;
            return true;
        }

        history = new HistorySeries();
        return false;
    }

    private List<HistoryPoint> GetChartPoints(HistorySeries history, ChartKind kind)
    {
        var startLocal = kind == ChartKind.Network ? NetworkRangeStartLocal : ResourceRangeStartLocal;
        var endLocal = kind == ChartKind.Network ? NetworkRangeEndLocal : ResourceRangeEndLocal;

        if (startLocal is not null && endLocal is not null)
        {
            var startUtc = DateTime.SpecifyKind(startLocal.Value, DateTimeKind.Local).ToUniversalTime();
            var endUtc = DateTime.SpecifyKind(endLocal.Value, DateTimeKind.Local).ToUniversalTime();
            return history.Points
                .Where(x => x.TimestampUtc >= startUtc && x.TimestampUtc <= endUtc)
                .ToList();
        }

        // realtime: show last ChartWindowPoints
        return history.Points.TakeLast(ChartWindowPoints).ToList();
    }

    private async Task EnsureHistoryWindowForRangeAsync(string host, DateTime startLocal)
    {
        var startUtc = DateTime.SpecifyKind(startLocal, DateTimeKind.Local).ToUniversalTime();
        var minutesNeeded = (int)Math.Ceiling((DateTime.UtcNow - startUtc).TotalMinutes);
        if (minutesNeeded <= 0) return;

        if (minutesNeeded > _currentHistoryWindowMinutes)
        {
            await LoadHistoryAsync(host, minutesNeeded);
        }
        else
        {
            // 더 좁은 범위로 전환 시에도 _currentHistoryWindowMinutes 갱신
            // (TrimHistory가 필요 이상으로 데이터를 유지하지 않도록)
            _currentHistoryWindowMinutes = minutesNeeded;
        }
    }

