@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@using System.Text.Json
@using Monitoring.Blazor.Services
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="settings-page">
    <section class="settings-panel" aria-labelledby="settings-title">
        <div class="settings-header">
            <div>
                <div class="settings-kicker">@Language.T("구성", "Configuration")</div>
                <h2 id="settings-title">@Language.T("설정", "Settings")</h2>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ReloadAsync" disabled="@IsSaving">@Language.T("다시 불러오기", "Reload")</button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@(IsSaving || !SettingsLoaded)">@Language.T("저장", "Save")</button>
                <button type="button" class="settings-close" aria-label="@Language.T("뒤로", "Back")" @onclick="CloseAsync">X</button>
            </div>
        </div>

        <div class="settings-body">
            <div class="settings-tabs" role="tablist" aria-label="@Language.T("설정 항목", "Settings categories")">
                <button type="button" class="@BasicTabButtonClass" @onclick="ShowBasicTab">@Language.T("기본", "Basic")</button>
                <button type="button" class="@CollectionTabButtonClass" @onclick="ShowCollectionTab">@Language.T("로그 파이프라인", "Log Pipeline")</button>
                <button type="button" class="@AnalysisTabButtonClass" @onclick="ShowAnalysisTab">@Language.T("AI 및 보고서", "AI & Reports")</button>
                <button type="button" class="@IntegrationsTabButtonClass" @onclick="ShowIntegrationsTab">@Language.T("연동", "Integrations")</button>
            </div>
            <div class="settings-summary">
                <div>
                    <div class="settings-summary-title">@TabSummaryTitle</div>
                    <div class="settings-summary-text">@TabSummaryText</div>
                </div>
                <div class="settings-summary-note">@TabSummaryNote</div>
            </div>

            @if (ActiveSettingsTab == "basic")
            {
                <div class="settings-section" id="alert-rules">
                    <div class="settings-section-title">@Language.T("서버 상태 알림", "Server Health Alerts")</div>
                    <div class="settings-section-help">@Language.T("CPU·메모리·디스크·복구·점검 시간에 경고를 발생시킬 조건을 설정합니다.", "Tune when the dashboard should raise warnings for CPU, memory, disk, recovery, or maintenance windows.")</div>
                    <div class="settings-subsections">
                        <div class="settings-subsection">
                            <div class="settings-subsection-heading">
                                <div class="settings-subsection-title">@Language.T("감지 기준", "Detection thresholds")</div>
                                <div class="settings-subsection-help">@Language.T("알림을 사용할지와 CPU·메모리·디스크 경고 기준을 설정합니다.", "Enable alerts and set CPU, memory, and disk thresholds.")</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-md-3">
                                    <label class="form-label">@Language.T("사용", "Enabled")</label>
                                    <select class="form-select" @bind="AlertEnabledChoice"><option value="Y">@Language.T("사용", "Enabled")</option><option value="N">@Language.T("사용 안 함", "Disabled")</option></select>
                                </div>
                                <div class="col-12 col-md-3"><label class="form-label">CPU %</label><input class="form-control" type="number" @bind="AlertSettings.CpuThreshold" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">@Language.T("CPU 임계값 유지 시간(분)", "CPU duration (min)")</label><input class="form-control" type="number" @bind="AlertSettings.CpuDurationMinutes" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">@Language.T("메모리 %", "Memory %")</label><input class="form-control" type="number" @bind="AlertSettings.RamThreshold" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">@Language.T("디스크 %", "Disk %")</label><input class="form-control" type="number" @bind="AlertSettings.DiskThreshold" /></div>
                            </div>
                        </div>
                        <div class="settings-subsection">
                            <div class="settings-subsection-heading">
                                <div class="settings-subsection-title">@Language.T("알림 동작", "Alert behavior")</div>
                                <div class="settings-subsection-help">@Language.T("반복 알림 간격과 복구·이상 징후 알림을 설정합니다.", "Control cooldowns and recovery or anomaly notifications.")</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-md-3"><label class="form-label">@Language.T("재알림 대기 시간(분)", "Alert cooldown (min)")</label><input class="form-control" type="number" @bind="AlertSettings.CooldownMinutes" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">@Language.T("복구 알림", "Recovery alerts")</label><select class="form-select" @bind="RecoveryEnabledChoice"><option value="Y">@Language.T("사용", "Enabled")</option><option value="N">@Language.T("사용 안 함", "Disabled")</option></select></div>
                                <div class="col-12 col-md-3"><label class="form-label">@Language.T("복구 알림 대기 시간(분)", "Recovery cooldown (min)")</label><input class="form-control" type="number" @bind="AlertSettings.RecoveryCooldownMinutes" /></div>
                                <div class="col-12 col-md-3"><label class="form-label">@Language.T("이상 징후 감지", "Anomaly detection")</label><select class="form-select" @bind="AnomalyEnabledChoice"><option value="Y">@Language.T("사용", "Enabled")</option><option value="N">@Language.T("사용 안 함", "Disabled")</option></select></div>
                            </div>
                        </div>
                        <div class="settings-subsection">
                            <div class="settings-subsection-heading">
                                <div class="settings-subsection-title">@Language.T("점검 시간", "Maintenance window")</div>
                                <div class="settings-subsection-help">@Language.T("정기 점검 중에는 일시적인 상태 변화를 알림에서 제외합니다.", "Suppress expected status changes during scheduled maintenance.")</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-md-4"><label class="form-label">@Language.T("점검 시간 사용", "Enable maintenance window")</label><select class="form-select" @bind="MaintenanceWindowEnabledChoice"><option value="Y">@Language.T("사용", "Enabled")</option><option value="N">@Language.T("사용 안 함", "Disabled")</option></select></div>
                                <div class="col-12 col-md-4"><label class="form-label">@Language.T("시작 시각", "Start time")</label><input class="form-control" type="time" @bind="MaintenanceWindowStartValue" /></div>
                                <div class="col-12 col-md-4"><label class="form-label">@Language.T("종료 시각", "End time")</label><input class="form-control" type="time" @bind="MaintenanceWindowEndValue" /></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-section" id="security">
                    <div class="settings-section-title">@Language.T("계정 보안", "Account Security")</div>
                    <div class="settings-section-help">@Language.T("계정 시스템의 2차 인증을 켜거나 끕니다.", "Turn two-factor authentication on or off for the account system.")</div>
                    <div class="row g-2">
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Language.T("2차 인증", "Two-factor authentication")</label>
                            <select class="form-select" @bind="TwoFactorEnabledChoice">
                                <option value="Y">@Language.T("사용", "Enabled")</option>
                                <option value="N">@Language.T("사용 안 함", "Disabled")</option>
                            </select>
                        </div>
                    </div>
                </div>
            }

            @if (ActiveSettingsTab == "collection")
            {
                <div class="settings-section" id="collection">
                    <div class="settings-section-title">@Language.T("IIS 로그 수집", "IIS Log Collection")</div>
                    <div class="settings-section-help">@Language.T("IIS 로그를 읽을 위치와 보고서 폴더로 복사할 시점을 설정합니다.", "These settings decide where IIS logs are read from and when they are copied into the reporting folder.")</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Language.T("일일 로그 내보내기", "Daily log export")</label>
                            <select class="form-select" @bind="LogExportEnabledChoice">
                                <option value="Y">@Language.T("사용", "Enabled")</option>
                                <option value="N">@Language.T("사용 안 함", "Disabled")</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Language.T("IIS 로그 폴더", "IIS log folder")</label>
                            <input class="form-control" @bind="LogExportSettings.LogFolder" placeholder="C:\\inetpub\\logs\\LogFiles\\W3SVC3" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Language.T("내보내기 폴더", "Export folder")</label>
                            <input class="form-control" @bind="LogExportSettings.OutputFolder" placeholder="F:\\iis_log" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">@Language.T("내보내기 시", "Export hour")</label>
                            <input class="form-control" type="number" @bind="LogExportSettings.RunHour" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">@Language.T("내보내기 분", "Export minute")</label>
                            <input class="form-control" type="number" @bind="LogExportSettings.RunMinute" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">@Language.T("내보내기 기준일 오프셋(일)", "Export date offset (days)")</label>
                            <input class="form-control" type="number" @bind="LogExportSettings.TargetDateOffsetDays" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Language.T("일일 로그 가져오기", "Daily log import")</label>
                            <select class="form-select" @bind="LogImportEnabledChoice">
                                <option value="Y">@Language.T("사용", "Enabled")</option>
                                <option value="N">@Language.T("사용 안 함", "Disabled")</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Language.T("가져올 로그 폴더", "Import log folder")</label>
                            <input class="form-control" @bind="LogImportSettings.LogFolder" placeholder="C:\\inetpub\\logs\\LogFiles\\W3SVC3" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Language.T("가져오기 상태 파일", "Import state file")</label>
                            <input class="form-control" @bind="LogImportSettings.StateFilePath" placeholder="F:\\iis_log\\log-import-state.json" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">@Language.T("가져오기 시", "Import hour")</label>
                            <input class="form-control" type="number" @bind="LogImportSettings.RunHour" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">@Language.T("가져오기 분", "Import minute")</label>
                            <input class="form-control" type="number" @bind="LogImportSettings.RunMinute" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">@Language.T("가져오기 기준일 오프셋(일)", "Import date offset (days)")</label>
                            <input class="form-control" type="number" @bind="LogImportSettings.TargetDateOffsetDays" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Language.T("보고서에 표시할 서버 이름", "Server name in reports")</label>
                            <input class="form-control" @bind="LogImportSettings.ServerName" placeholder="HOST-01" />
                        </div>
                    </div>
                </div>
            }

            @if (ActiveSettingsTab == "analysis")
            {
                <div class="settings-section" id="analysis">
                        <div class="settings-section-title">@Language.T("AI 분석", "AI Analysis")</div>
                        <div class="settings-section-help">@Language.T("IIS 로그를 Ollama로 전송할지와 응답 대기 시간을 설정합니다.", "Choose whether to send IIS logs to Ollama and how long the app should wait for a response.")</div>
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md-3">
                                <label class="form-label">@Language.T("AI 분석 사용", "Enable AI analysis")</label>
                                <select class="form-select" @bind="OllamaEnabledChoice">
                                    <option value="Y">@Language.T("사용", "Enabled")</option>
                                    <option value="N">@Language.T("사용 안 함", "Disabled")</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">@Language.T("Ollama 기본 URL", "Ollama base URL")</label>
                                <input class="form-control" @bind="OllamaSettings.BaseUrl" placeholder="http://localhost:11434" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">@Language.T("Ollama 모델", "Ollama model")</label>
                                <input class="form-control" @bind="OllamaSettings.Model" placeholder="gemma3:4b" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">@Language.T("Ollama 응답 제한 시간(초)", "Ollama timeout (sec)")</label>
                                <input class="form-control" type="number" @bind="OllamaSettings.TimeoutSeconds" />
                            </div>
                            <div class="col-12">
                                <button class="btn btn-outline-primary" @onclick="CheckOllamaConnectionAsync" disabled="@IsCheckingOllama">
                                    @(IsCheckingOllama ? Language.T("연결 확인 중…", "Checking Ollama…") : Language.T("Ollama 연결 확인", "Test Ollama connection"))
                                </button>
                                <div class="form-text">@Language.T("저장된 설정으로 연결을 확인합니다. 주소나 모델을 변경했다면 먼저 저장하세요.", "This checks the saved settings. Save any URL or model changes before testing.")</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">@Language.T("자동 분석", "Automatic analysis")</label>
                                <select class="form-select" @bind="OllamaAutoAnalyzeChoice">
                                    <option value="Y">@Language.T("사용", "Enabled")</option>
                                    <option value="N">@Language.T("사용 안 함", "Disabled")</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label">@Language.T("자동 분석 임계값", "Auto-analysis threshold")</label>
                                <input class="form-control" type="number" step="0.01" @bind="OllamaSettings.AutoAnalyzeStatus5xxRatio" />
                            </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Language.T("분석 결과 저장 폴더", "Analysis output folder")</label>
                            <input class="form-control" @bind="OllamaSettings.AnalysisOutputFolder" placeholder="F:\\iis_log\\analysis" />
                            <div class="form-text">@Language.T("최신 IIS 분석 결과 JSON을 저장하고 불러올 폴더입니다.", "Folder used to save and load the latest IIS analysis JSON report.")</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Language.T("AI 분석 시스템 프롬프트", "AI analysis system prompt")</label>
                            <textarea class="form-control font-monospace" rows="10" @bind="LogAnalysisSettings.AnalysisSystemPrompt"></textarea>
                            <div class="form-text">@Language.T("기본 분석 보고서의 응답 방식을 지정합니다. 기본 프롬프트를 사용하려면 비워 두세요.", "Controls the base analysis report. Leave this blank to use the built-in prompt.")</div>
                        </div>
                    </div>
                </div>

                <div class="settings-section" id="analysis-rules">
                    <div class="settings-section-title">@Language.T("로그 분석 규칙", "Log Analysis Rules")</div>
                    <div class="settings-section-help">@Language.T("IIS 로그 분석에 사용할 제외 IP 패턴과 탐지 토큰을 관리합니다. 한 줄에 하나씩 입력하세요.", "Manage excluded IP patterns and custom detection tokens used by the IIS log analyzer. Enter one item per line.")</div>
                    <div class="row g-2">
                        <div class="col-12 col-lg-6">
                            <label class="form-label">@Language.T("제외할 IP 패턴", "Excluded IP patterns")</label>
                            <textarea class="form-control font-monospace" rows="5" @bind="ExcludedIpPatternsText" placeholder="121.131.195.*"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label">@Language.T("우선 분석 URL 키워드", "Priority URL tokens")</label>
                            <textarea class="form-control font-monospace" rows="5" @bind="PriorityUrlTokensText" placeholder="@("board\nsearch\ndownload")"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                                    <label class="form-label">@Language.T("관리자 경로 탐지 키워드", "Admin path probe tokens")</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="AdminProbeTokensText" placeholder="@("admin\nmanager\nlogin")"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                                    <label class="form-label">@Language.T("백업 파일 탐지 키워드", "Backup-file probe tokens")</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="BackupProbeTokensText" placeholder="@("backup\nbak\nzip")"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                                    <label class="form-label">@Language.T("설정 파일 탐지 키워드", "Configuration-file probe tokens")</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="ConfigProbeTokensText" placeholder="@("web.config\nappsettings.json\n.env")"></textarea>
                        </div>
                        <div class="col-12 col-lg-6">
                                    <label class="form-label">@Language.T("스크립트 / 공격 탐지 키워드", "Script / exploit probe tokens")</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="ScriptProbeTokensText" placeholder="@("powershell\ncmd=\nphpmyadmin")"></textarea>
                        </div>
                    </div>
                </div>

                <div class="settings-section" id="report">
                    <div class="settings-section-title">@Language.T("보고서", "Reports")</div>
                    <div class="settings-section-help">@Language.T("사람이 읽기 쉬운 IIS 분석 보고서를 확인하고 필요할 때만 원본 JSON을 열어보세요.", "View a human-readable IIS analysis report here, and open the raw JSON only when you need the source data.")</div>
                    <div class="row g-2">
                        <div class="col-12 col-lg-8">
                            <label class="form-label">@Language.T("읽기 쉬운 보고서", "Readable report")</label>
                            <div class="report-preview">
                                @if (string.IsNullOrWhiteSpace(_iisReportSummary))
                                {
                                    <div class="text-muted">@Language.T("아직 IIS 분석 결과를 불러오지 않았습니다.", "No IIS analysis has been loaded yet.")</div>
                                }
                                else
                                {
                                    <pre class="report-preview-text">@_iisReportSummary</pre>
                                }
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-primary" @onclick="LoadLatestIisReportAsync">@Language.T("최신 IIS 보고서 불러오기", "Load latest IIS report")</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="ToggleIisReportJsonView" disabled="@string.IsNullOrWhiteSpace(_iisReportRawJson)">
                                    @(ShowIisReportJson ? Language.T("JSON 숨기기", "Hide JSON") : Language.T("JSON 보기", "View JSON"))
                                </button>
                                <button type="button" class="btn btn-outline-success" @onclick="RunLogExportNowAsync">@Language.T("로그 내보내기 실행", "Run log export")</button>
                                <button type="button" class="btn btn-outline-dark" @onclick="DownloadIisReportAsync" disabled="@string.IsNullOrWhiteSpace(_iisReportRawJson)">@Language.T("JSON 다운로드", "Download JSON")</button>
                            </div>
                            <div class="text-muted small mt-2">
                                @Language.T("JSON 보기는 복사, 다운로드 또는 문제 해결을 위한 용도입니다.", "Use the JSON view to copy, download, or troubleshoot the report.")
                            </div>
                        </div>
                    </div>
                    @if (ShowIisReportJson)
                    {
                        <div class="mt-3">
                            <label class="form-label">@Language.T("원본 JSON", "Raw JSON")</label>
                            <textarea class="form-control font-monospace" rows="10" readonly>@_iisReportRawJson</textarea>
                        </div>
                    }
                </div>
            }

            @if (ActiveSettingsTab == "integrations")
            {
                <div class="settings-section" id="backup">
                        <div class="settings-section-title">@Language.T("백업 및 복원", "Backup & Restore")</div>
                        <div class="settings-section-help">@Language.T("현재 설정을 JSON으로 내보내거나 나중에 복원합니다.", "Use this to export the current settings as JSON or restore them later.")</div>
                        <div class="mb-2">
                            <label class="form-label">@Language.T("백업 파일 가져오기", "Import backup file")</label>
                            <FilePicker OnChange="LoadBackupFileAsync" Accept=".json,application/json" />
                        </div>
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">@Language.T("백업 JSON", "Backup JSON")</label>
                                <textarea class="form-control font-monospace" rows="8" @bind="_backupJson" placeholder="@Language.T("백업을 생성하거나 복원할 JSON을 여기에 붙여 넣으세요.", "Generate a backup or paste JSON here to restore.")"></textarea>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CreateBackupAsync">@Language.T("백업 생성", "Generate backup")</button>
