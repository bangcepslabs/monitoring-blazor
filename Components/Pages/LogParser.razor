        var topAttack = attackUrls.FirstOrDefault();
        var actionRanks = attackUrls
            .GroupBy(x => x.RecommendedAction, StringComparer.OrdinalIgnoreCase)
            .Select(g => new CountItem(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
            .ToList();

        return new AttackSummaryItem(
            topAttack?.Url ?? string.Empty,
            topAttack?.TotalRequests ?? 0,
            topAttack?.UniqueIpCount ?? 0,
            topAttack?.TopIp ?? string.Empty,
            topAttack?.TopIpRequestCount ?? 0,
            topAttack?.TopIpRatio ?? 0,
            topAttack?.NoRefererRatio ?? 0,
            topAttack?.RecommendedAction ?? string.Empty,
            actionRanks);
    }

    private static UrlAttackDetailItem BuildUrlAttackDetail(string url, List<ParsedLogRow> rows)
    {
        var totalRequestCount = rows.Count;
        var http200RequestCount = rows.Count(x => string.Equals(x.Status?.Trim(), "200", StringComparison.OrdinalIgnoreCase));
        var http404Count = rows.Count(x => string.Equals(x.Status?.Trim(), "404", StringComparison.OrdinalIgnoreCase));
        var uniqueIpCount = rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Ip))
            .Select(x => x.Ip!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        var refererMissingCount = rows.Count(x => IsMissingField(x.Referrer));
        var refererMissingRatio = totalRequestCount == 0 ? 0 : refererMissingCount / (double)totalRequestCount;
        var errorCount = rows.Count(x => IsErrorStatus(x.Status));
        var averageRequestsPerIp = uniqueIpCount == 0 ? 0 : totalRequestCount / (double)uniqueIpCount;

        var ipCounts = rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Ip))
            .GroupBy(x => x.Ip.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new CountItem(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var top3IpRequestCount = ipCounts.Take(3).Sum(x => x.Count);
        var top10IpRequestCount = ipCounts.Take(10).Sum(x => x.Count);
        var top30IpRequestCount = ipCounts.Take(30).Sum(x => x.Count);
        var top3IpRatio = totalRequestCount == 0 ? 0 : top3IpRequestCount / (double)totalRequestCount;
        var top10IpRatio = totalRequestCount == 0 ? 0 : top10IpRequestCount / (double)totalRequestCount;
        var top30IpRatio = totalRequestCount == 0 ? 0 : top30IpRequestCount / (double)totalRequestCount;
        var remainingIpCount = Math.Max(0, uniqueIpCount - Math.Min(uniqueIpCount, 30));
        var remainingRequestCount = Math.Max(0, totalRequestCount - top30IpRequestCount);
        var distributedAccessScore = 0;

        if (uniqueIpCount >= 20 && top3IpRatio <= 0.4)
        {
            distributedAccessScore += 30;
        }
        else if (uniqueIpCount >= 10 && top3IpRatio <= 0.55)
        {
            distributedAccessScore += 15;
        }

        if (top10IpRatio <= 0.6 && uniqueIpCount >= 20)
        {
            distributedAccessScore += 20;
        }

        if (top30IpRatio <= 0.75 && remainingIpCount >= 10)
        {
            distributedAccessScore += 20;
        }

        var isBoardUrl = IsBoardUrl(url);
        var priorityUrl = IsPriorityAttackUrl(url);
        var hasAdminProbe = ContainsAny(url, AdminProbeTokens);
        var hasBackupProbe = ContainsAny(url, BackupProbeTokens);
        var hasConfigProbe = ContainsAny(url, ConfigProbeTokens);
        var hasScriptProbe = ContainsAny(url, ScriptProbeTokens);
        var isDistributedAccess = distributedAccessScore >= 30 && uniqueIpCount >= 15 && totalRequestCount >= 20;
        var isDistributedCrawler = isDistributedAccess && http200RequestCount >= 10 && refererMissingRatio >= 0.5;
        var isDistributedDdosCandidate = isDistributedAccess && totalRequestCount >= 50 && top10IpRatio <= 0.6;
        var isDistributedAttackCandidate = isDistributedCrawler || isDistributedDdosCandidate;

        var topIps = ipCounts
            .Take(3)
            .Select(x => new UrlIpShareItem(x.Value, x.Count, totalRequestCount == 0 ? 0 : x.Count / (double)totalRequestCount))
            .ToList();

        var uaCount = rows
            .Where(x => !string.IsNullOrWhiteSpace(x.UserAgent) && !string.Equals(x.UserAgent.Trim(), "-", StringComparison.Ordinal))
            .Select(x => x.UserAgent!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        var topIp = ipCounts.FirstOrDefault();
        var topIpValue = topIp?.Value ?? string.Empty;
        var topIpCount = topIp?.Count ?? 0;
        var topIpRatio = totalRequestCount == 0 ? 0 : topIpCount / (double)totalRequestCount;
        var reasons = new List<string>();
        var score = 0;

        if (totalRequestCount >= 200)
        {
            score += 25;
            reasons.Add($"URL 요청 수 과다 ({totalRequestCount:N0})");
        }
        else if (totalRequestCount >= 50)
        {
            score += 15;
            reasons.Add($"URL 요청 수 증가 ({totalRequestCount:N0})");
        }
        else if (totalRequestCount >= 20)
        {
            score += 8;
            reasons.Add($"URL 접근 다수 ({totalRequestCount:N0})");
        }

        if (http200RequestCount >= 20)
        {
            score += 10;
            reasons.Add($"HTTP 200 요청 다수 ({http200RequestCount:N0})");
        }

        if (refererMissingRatio >= 0.8 && totalRequestCount >= 10)
        {
            score += 15;
            reasons.Add($"Referer 없음 비율 높음 ({refererMissingRatio:P0})");
        }
        else if (refererMissingRatio >= 0.5 && totalRequestCount >= 10)
        {
            score += 8;
            reasons.Add($"Referer 없음 비율 높음 ({refererMissingRatio:P0})");
        }

        if (topIpRatio >= 0.7 && totalRequestCount >= 20)
        {
            score += 20;
            reasons.Add($"상위 IP 집중도 높음 ({topIpValue} x{topIpCount}, {topIpRatio:P0})");
        }
        else if (topIpRatio >= 0.5 && totalRequestCount >= 10)
        {
            score += 10;
            reasons.Add($"상위 IP 집중도 높음 ({topIpValue} x{topIpCount}, {topIpRatio:P0})");
        }

        if (errorCount >= 20)
        {
            score += 15;
            reasons.Add($"4xx/5xx 오류 다수 ({errorCount:N0})");
        }
        else if (errorCount >= 5)
        {
            score += 8;
            reasons.Add($"4xx/5xx 오류 관찰 ({errorCount:N0})");
        }

        if (isBoardUrl)
        {
            if (totalRequestCount >= 50)
            {
                score += 20;
                reasons.Add("게시판 URL 집중 접근");
            }
            else if (totalRequestCount >= 10)
            {
                score += 10;
                reasons.Add("게시판 URL 접근");
            }

            if (topIpRatio >= 0.5 && totalRequestCount >= 20)
            {
                score += 10;
                reasons.Add("게시판 URL에 특정 IP 집중");
            }
        }

        if (priorityUrl)
        {
            score += 10;
            reasons.Add("우선 분석 대상 URL");
        }

        if (hasAdminProbe)
        {
            score += 20;
            reasons.Add("관리자 페이지 탐색 시도");
        }

        if (hasBackupProbe)
        {
            score += 20;
            reasons.Add("백업 파일 탐색 시도");
        }

        if (hasConfigProbe)
        {
            score += 20;
            reasons.Add("설정 파일 탐색 시도");
        }

        if (hasScriptProbe)
        {
            score += 15;
            reasons.Add("스크립트/익스플로잇 탐색 시도");
        }

        if (isDistributedAttackCandidate)
        {
            reasons.Add($"분산 접근 가능성 높음 (Top3={top3IpRatio:P0}, Top10={top10IpRatio:P0}, Top30={top30IpRatio:P0}, 분산점수={distributedAccessScore})");
            score += isDistributedDdosCandidate ? 25 : 15;
        }
        else if (topIpRatio >= 0.7 && totalRequestCount >= 20)
        {
            reasons.Add("단일 IP 집중형 접근");
        }

        var recommendedAction =
            (isDistributedAttackCandidate && topIpRatio < 0.01) || (isBoardUrl && (totalRequestCount >= 100 || topIpRatio >= 0.7)) || totalRequestCount >= 300 || (refererMissingRatio >= 0.8 && totalRequestCount >= 20) || hasAdminProbe || hasBackupProbe || hasConfigProbe
                ? "Block"
                : (isDistributedAttackCandidate || (isBoardUrl && totalRequestCount >= 20) || totalRequestCount >= 80 || topIpRatio >= 0.5 || refererMissingRatio >= 0.5 || (priorityUrl && totalRequestCount >= 30) || hasScriptProbe)
                    ? "RateLimit"
                    : totalRequestCount >= 20
                        ? "Monitor"
                        : "Allow";

        if (topIpRatio < 0.01 && totalRequestCount >= 50 && recommendedAction is "Block")
        {
            recommendedAction = "RateLimit";
            reasons.Add("상위 IP 비율 1% 미만으로 IP 차단보다 URL RateLimit/WAF 우선");
        }

        if (recommendedAction is "Block" && score < 60)
        {
            score = 60;
        }
        else if (recommendedAction is "RateLimit" && score < 35)
        {
            score = 35;
        }
        else if (recommendedAction is "Monitor" && score < 15)
        {
            score = 15;
        }

        return new UrlAttackDetailItem(
            url,
            totalRequestCount,
            http200RequestCount,
            http404Count,
            uniqueIpCount,
            null,
            refererMissingRatio,
            topIpValue,
            topIpCount,
            topIpRatio,
            top10IpRequestCount,
            top10IpRatio,
            top30IpRequestCount,
            top30IpRatio,
            remainingIpCount,
            remainingRequestCount,
            averageRequestsPerIp,
            distributedAccessScore,
            isDistributedAccess,
            isDistributedCrawler,
            isDistributedDdosCandidate,
            uaCount,
            recommendedAction,
            reasons.Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
            topIps)
        {
            Score = score,
            IsBoardUrl = isBoardUrl,
            Top3IpRequestCount = top3IpRequestCount,
            Top3IpRatio = top3IpRatio,
            Top10IpRequestCount = top10IpRequestCount,
            Top10IpRatio = top10IpRatio,
            Top30IpRequestCount = top30IpRequestCount,
            Top30IpRatio = top30IpRatio,
            RemainingIpCount = remainingIpCount,
            RemainingRequestCount = remainingRequestCount,
            DistributedAccessScore = distributedAccessScore,
            IsDistributedAttackCandidate = isDistributedAttackCandidate,
            IsDistributedAccess = isDistributedAccess,
            IsDistributedCrawler = isDistributedCrawler,
            IsDistributedDdosCandidate = isDistributedDdosCandidate
        };
    }

    private static bool IsPriorityAttackUrl(string url)
    {
        return ContainsAny(url, PriorityUrlTokens);
    }

    private static List<CountItem> GetProbeUrls(List<ParsedLogRow> rows, string[] tokens, int take)
    {
        return rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Uri))
            .Select(x => x.Uri.Trim())
            .Where(uri => ContainsAny(uri, tokens))
            .GroupBy(uri => uri, StringComparer.OrdinalIgnoreCase)
            .Select(g => new CountItem(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();
    }

    private static bool ContainsAny(string value, IEnumerable<string> tokens)
    {
        return tokens.Any(token => value.Contains(token, StringComparison.OrdinalIgnoreCase));
    }

    private static bool IsBoardUrl(string? uri)
    {
        if (string.IsNullOrWhiteSpace(uri))
        {
            return false;
        }

        return uri.Contains("/board/", StringComparison.OrdinalIgnoreCase)
            || uri.Contains("/Board/", StringComparison.OrdinalIgnoreCase)
            || (uri.Contains("inform.aspx", StringComparison.OrdinalIgnoreCase) && uri.Contains("board", StringComparison.OrdinalIgnoreCase));
    }

