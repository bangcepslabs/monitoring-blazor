    {
        StatusGroup = StatusGroup,
        StatusCode = StatusCode,
        UrlQuery = UrlQuery,
        MethodQuery = MethodQuery,
        TextQuery = TextQuery,
        ExcludeIpQuery = ExcludeIpQuery,
        Date = DateFilter,
        Time = TimeFilter,
        Ip = IpFilter,
        Method = MethodFilter,
