APP_PORT=8080
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_DATABASE=MonitoringDb
MONITOR_AGENT_API_KEY=replace-with-a-long-random-agent-key

# Ollama
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=1200
OLLAMA_AUTO_ANALYZE_ENABLED=true
OLLAMA_AUTO_ANALYZE_STATUS5XX_RATIO=0.05

# Logs
LOG_EXPORT_ENABLED=false
LOG_IMPORT_ENABLED=false
LOG_IMPORT_SERVER_NAME=HOST-01

# Email
EMAIL_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
EMAIL_PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USE_DEFAULT_CREDENTIALS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=OpsEye
SMTP_VERIFICATION_SUBJECT=Confirm your email address

# SQL
SLOW_QUERY_THRESHOLD_SECONDS=5
