@page "/"
@attribute [Authorize]
@implements IDisposable
@inject Monitoring.Blazor.Services.MonitorStateService MonitorState
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject SlowQueryService SlowQueryService
@inject ServerCatalogRepository ServerCatalogRepository
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using Monitoring.Blazor.Models
@using Monitoring.Blazor.Services
@inject IDbContextFactory<MonitoringDbContext> DbFactory

<PageTitle>OpsEye | @Language.T("대시보드", "Dashboard")</PageTitle>

<div class="dashboard-page-heading">
    <div>
        <div class="page-eyebrow">@Language.T("개요", "Overview")</div>
        <h1>@Language.T("대시보드", "Dashboard")</h1>
        <p>@Language.T("하나의 워크스페이스에서 서버 상태, 알림, 성능을 확인하세요.", "Monitor host health, alerts, and performance from one workspace.")</p>
    </div>
    <div class="dashboard-page-status" role="status">
        <span class="status-dot @(Hosts.Count > 0 ? "status-online" : "status-offline")" aria-hidden="true"></span>
        @(Hosts.Count > 0 ? Language.T("실시간 모니터링", "Live monitoring") : Language.T("데이터 수신 대기 중", "Waiting for data"))
        <span class="dashboard-last-refresh">@Language.T("업데이트", "Updated") @LastRefreshLocal.ToString("HH:mm:ss")</span>
    </div>
</div>

<div class="dashboard-toolbar mb-3">
    <div class="dashboard-toolbar-primary">
        <button class="btn @(CurrentHost == DashboardView ? "btn-primary" : "btn-outline-primary")" @onclick="ShowDashboard"><i class="bi bi-grid-1x2 me-1"></i>@Language.T("대시보드", "Dashboard")</button>
        <button class="btn btn-outline-secondary" @onclick="ToggleAutoRefresh">
            <span class="status-dot @(AutoRefresh ? "status-online" : "status-offline")" aria-hidden="true"></span>@Language.T("자동 새로고침", "Auto Refresh"): @(AutoRefresh ? Language.T("켜짐", "On") : Language.T("꺼짐", "Off"))
        </button>
        <button class="btn btn-outline-primary" @onclick="ManualRefreshAsync"><i class="bi bi-arrow-clockwise me-1"></i>@Language.T("지금 새로고침", "Refresh Now")</button>
        <div class="dashboard-menu">
            <button type="button" class="btn btn-outline-secondary" aria-expanded="@ShowManageMenu" @onclick="ToggleManageMenu">@Language.T("관리", "Manage") <i class="bi bi-chevron-down ms-1"></i></button>
            @if (ShowManageMenu)
            {
                <div class="dashboard-menu-backdrop" @onclick="CloseManageMenu"></div>
                <div class="dashboard-menu-popover" role="menu" aria-label="Manage menu" @onclick:stopPropagation="true">
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <button type="button" class="dashboard-menu-item" @onclick="ToggleAlertPanel">
                                <i class="bi bi-bell me-2"></i>Alert Rules
                            </button>
                            <button type="button" class="dashboard-menu-item" @onclick="ToggleSqlAccessPanel">
                                <i class="bi bi-database-lock me-2"></i>SQL Access
                            </button>
                        </Authorized>
                    </AuthorizeView>
                    <a class="dashboard-menu-item" href="/api/reports/dashboard" @onclick="CloseManageMenu"><i class="bi bi-download me-2"></i>@Language.T("리포트 내보내기", "Export Report")</a>
                    <a class="dashboard-menu-item" href="/server-groups" @onclick="CloseManageMenu"><i class="bi bi-tags me-2"></i>@Language.T("서버 그룹", "Server Groups")</a>
                    <a class="dashboard-menu-item" href="/events" @onclick="CloseManageMenu"><i class="bi bi-clock-history me-2"></i>@Language.T("이벤트 타임라인", "Event Timeline")</a>
                    <a class="dashboard-menu-item" href="/dependencies" @onclick="CloseManageMenu"><i class="bi bi-diagram-3 me-2"></i>@Language.T("의존 서비스", "Dependencies")</a>
                </div>
            }
        </div>
    </div>

        <div class="dashboard-toolbar-hosts">
        @foreach (var host in OrderedHosts)
        {
            <button class="btn dashboard-host-button @(CurrentHost == host.Info.Hostname ? "btn-primary" : "btn-outline-secondary") @(host.IsOnline ? "host-online" : "host-offline")"
                    disabled="@(!host.IsOnline)"
                    aria-label="@(host.Info.Hostname + (host.IsOnline ? " online" : " offline"))"
                    @onclick="() => SelectHost(host.Info.Hostname)">
                <span class="status-dot @(host.IsOnline ? "status-online" : "status-offline")" aria-hidden="true"></span>
                <span class="host-name">@host.Info.Hostname</span>
                <span class="host-state @(host.IsOnline ? "host-state-online" : "host-state-offline")">
                    @(host.IsOnline ? "Online" : "Offline")
                </span>
            </button>
        }
    </div>
</div>

@if (CurrentHost == DashboardView)
{
    <div class="row g-2 mb-3 dashboard-mini-metrics">
        <div class="col-6 col-lg-3">
            <div class="card h-100 metric-card metric-card-compact">
                <div class="card-body">
                    <div class="metric-label">@Language.T("온라인 호스트", "Hosts Online")</div>
                    <div class="metric-value">@Hosts.Count(x => x.IsOnline).ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 metric-card metric-card-compact">
                <div class="card-body">
                    <div class="metric-label">@Language.T("오프라인 호스트", "Hosts Offline")</div>
                    <div class="metric-value">@Hosts.Count(x => !x.IsOnline).ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 metric-card metric-card-compact" title="Warning: CPU is at or above 60%, memory is at or above 75%, or disk usage is at or above 85%." aria-label="Hosts Warning: CPU 60 percent or higher, memory 75 percent or higher, or disk 85 percent or higher.">
                <div class="card-body">
                    <div class="metric-label">@Language.T("주의 호스트", "Hosts Warning")</div>
                    <div class="metric-value">@Hosts.Count(x => IsWarning(x.Info)).ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 metric-card metric-card-compact" title="Critical: CPU is at or above 85%, memory is at or above 90%, or disk usage is at or above 95%." aria-label="Hosts Critical: CPU 85 percent or higher, memory 90 percent or higher, or disk 95 percent or higher.">
                <div class="card-body">
                    <div class="metric-label">@Language.T("위험 호스트", "Hosts Critical")</div>
                    <div class="metric-value">@Hosts.Count(x => IsCritical(x.Info)).ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <div class="card h-100 metric-card metric-link-card" role="button" tabindex="0" title="Open alert history to inspect all recent alerts." @onclick="OpenAlertHistory">
                <div class="card-body">
                    <div class="metric-label">@Language.T("최근 알림", "Recent Alerts")</div>
                    <div class="metric-value">@RecentAlerts.Count.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card h-100 metric-card metric-link-card" role="button" tabindex="0" title="Open alert history and review threshold events." @onclick="OpenAlertHistory">
                <div class="card-body">
                    <div class="metric-label">@Language.T("임계값 알림", "Threshold Alerts")</div>
                    <div class="metric-value">@RecentAlerts.Count(x => x.Type == AlertType.Threshold).ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card h-100 metric-card metric-link-card" role="button" tabindex="0" title="Open alert history and review recovery events." @onclick="OpenAlertHistory">
                <div class="card-body">
                    <div class="metric-label">@Language.T("복구 알림", "Recovery Alerts")</div>
                    <div class="metric-value">@RecentAlerts.Count(x => x.Type == AlertType.Recovery).ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card h-100 metric-card metric-link-card" role="button" tabindex="0" title="Open alert history and review anomaly events." @onclick="OpenAlertHistory">
                <div class="card-body">
                    <div class="metric-label">@Language.T("이상 징후 알림", "Anomaly Alerts")</div>
                    <div class="metric-value">@RecentAlerts.Count(x => x.Type == AlertType.Anomaly).ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3 dashboard-data-card">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <strong class="dashboard-data-title">@Language.T("최근 알림", "Recent Alerts")</strong>
            <button class="btn btn-sm btn-outline-secondary dashboard-data-action" title="Refresh recent alerts" @onclick="LoadRecentAlertsAsync">@Language.T("새로고침", "Refresh")</button>
        </div>
        <div class="card-body">
            @if (RecentAlerts.Count == 0)
            {
                <div class="text-muted">@Language.T("최근 알림이 없습니다.", "No recent alerts.")</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Host</th>
                                <th>Metric</th>
                                <th>Value</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in RecentAlerts)
                            {
                                <tr>
                                    <td>@alert.TimestampUtc.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                                    <td>@alert.Hostname</td>
                                    <td><span class="badge text-bg-warning">@alert.Metric</span></td>
                                    <td>@alert.Value.ToString("0.0") / @alert.Threshold.ToString("0.0")</td>
                                    <td class="text-break">@alert.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card mb-3 dashboard-data-card">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
            <strong class="dashboard-data-title">@Language.T("최근 로그인 실패", "Recent Login Failures")</strong>
            <button class="btn btn-sm btn-outline-secondary dashboard-data-action" title="Refresh recent failed sign-ins" @onclick="LoadRecentLoginFailuresAsync">@Language.T("새로고침", "Refresh")</button>
        </div>
        <div class="card-body">
            @if (RecentLoginFailures.Count == 0)
            {
                <div class="text-muted">@Language.T("최근 로그인 실패가 없습니다.", "No recent failed sign-ins.")</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>User</th>
                                <th>Reason</th>
                                <th>IP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attempt in RecentLoginFailures)
                            {
                                <tr>
                                    <td>@attempt.CreatedUtc.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                                    <td>@attempt.UserName</td>
                                    <td><span class="badge text-bg-danger">@attempt.Reason</span></td>
                                    <td>@(attempt.IpAddress ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (ShowAlertPanel)
    {
        <div class="alert-modal-backdrop" @onclick="ToggleAlertPanel">
            <div class="alert-modal" role="dialog" aria-modal="true" aria-labelledby="alert-rules-title" @onclick:stopPropagation="true">
                <div class="alert-modal-header">
                    <div>
                        <div class="settings-kicker">Configuration</div>
                        <h2 id="alert-rules-title">Alert Rules</h2>
                        <div class="text-muted small">Tune threshold, recovery, anomaly, and maintenance window rules here.</div>
                    </div>
                    <button type="button" class="modal-close-button" aria-label="Close" @onclick="ToggleAlertPanel">&times;</button>
                </div>
                <div class="alert-modal-body">
                    <div class="row g-2">
                        <div class="col-12 col-md-2">
                            <label class="form-label">Enabled</label>
                            <input type="checkbox" class="form-check-input ms-2" @bind="AlertSettings.Enabled" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">CPU %</label>
                            <input class="form-control" type="number" @bind="AlertSettings.CpuThreshold" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">CPU Minutes</label>
                            <input class="form-control" type="number" @bind="AlertSettings.CpuDurationMinutes" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">RAM %</label>
                            <input class="form-control" type="number" @bind="AlertSettings.RamThreshold" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Disk %</label>
                            <input class="form-control" type="number" @bind="AlertSettings.DiskThreshold" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Cooldown (min)</label>
                            <input class="form-control" type="number" @bind="AlertSettings.CooldownMinutes" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Recovery</label>
                            <input type="checkbox" class="form-check-input ms-2" @bind="AlertSettings.RecoveryEnabled" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Recovery Cooldown</label>
                            <input class="form-control" type="number" @bind="AlertSettings.RecoveryCooldownMinutes" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Anomaly</label>
                            <input type="checkbox" class="form-check-input ms-2" @bind="AlertSettings.AnomalyEnabled" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Window</label>
                            <input class="form-control" type="number" @bind="AlertSettings.AnomalyWindow" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">StdDev</label>
                            <input class="form-control" type="number" step="0.1" @bind="AlertSettings.AnomalyStdDev" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Min Delta</label>
                            <input class="form-control" type="number" step="0.1" @bind="AlertSettings.AnomalyMinDelta" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Anomaly Cooldown</label>
                            <input class="form-control" type="number" @bind="AlertSettings.AnomalyCooldownMinutes" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Maintenance Window</label>
                            <input type="checkbox" class="form-check-input ms-2" @bind="AlertSettings.MaintenanceWindowEnabled" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Start</label>
                            <input class="form-control" type="time" @bind="MaintenanceWindowStartValue" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">End</label>
                            <input class="form-control" type="time" @bind="MaintenanceWindowEndValue" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-primary" @onclick="SaveAlertSettings">Save</button>
                        <button class="btn btn-outline-secondary" @onclick="LoadAlertSettings">Reload</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="dashboard-section-heading">
        <div>
            <div class="page-eyebrow">@Language.T("인프라", "Infrastructure")</div>
            <h2>@Language.T("호스트", "Hosts")</h2>
        </div>
        <span class="dashboard-section-count">@Hosts.Count.ToString("N0") @Language.T("대", "total")</span>
    </div>

    <div class="row g-3 dashboard-host-grid">
        @foreach (HostState host in OrderedHosts)
        {
            var cpu = host.Info.Dynamic.CpuInfo.Usage;
            var mem = host.Info.Dynamic.MemoryInfo.Usage;
            var cpuClass = GetUsageClass(cpu, 60, 85);
            var memoryClass = GetUsageClass(mem, 75, 90);

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 host-card @(host.IsOnline ? "" : "host-offline")"
                     role="button"
                     tabindex="0"
                     aria-label="Open details for @host.Info.Hostname"
                     @onkeydown="(e) => HandleHostCardKeyDown(e, host.Info.Hostname)"
                     @onclick="() => SelectHost(host.Info.Hostname)">
                    <div class="card-body">
                        <div class="host-card-heading">
                            <div class="host-card-title-wrap">
                                <span class="status-dot @(host.IsOnline ? "status-online" : "status-offline")" aria-hidden="true"></span>
                                <h3 class="card-title mb-0">@host.Info.Hostname</h3>
                            </div>
                            <span class="host-status-badge @(host.IsOnline ? "host-status-online" : "host-status-offline")">@(host.IsOnline ? "Online" : "Offline")</span>
                        </div>
                        <p class="host-card-ip">@host.Info.Ip</p>
                        <div class="host-card-tags">
                            @if (!string.IsNullOrWhiteSpace(GetServerGroup(host.Info.Hostname)))
                            {
                                <span class="badge text-bg-secondary">@GetServerGroup(host.Info.Hostname)</span>
                            }
                            @foreach (var tag in GetServerTags(host.Info.Hostname))
                            {
                                <span class="badge text-bg-light text-dark border">@tag</span>
                            }
                        </div>
                        <div class="host-usage-list">
                            <div class="host-usage-item">
                                <div class="host-usage-label"><span>CPU</span><strong>@cpu.ToString("0.0")%</strong></div>
                                <div class="progress"><div class="progress-bar @cpuClass" style="width: @($"{cpu}%")"></div></div>
                            </div>
                            <div class="host-usage-item">
                                <div class="host-usage-label"><span>Memory</span><strong>@mem.ToString("0.0")%</strong></div>
                                <div class="progress"><div class="progress-bar @memoryClass" style="width: @($"{mem}%")"></div></div>
                            </div>
                        </div>
                        <div class="host-card-footer">
                            <span>@Language.T("호스트 개요 열기", "Open host overview")</span>
                            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (SelectedHost is not null)
{
    var info = SelectedHost.Info;
    var history = Histories.GetValueOrDefault(info.Hostname);

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(SelectedDetailTab == DetailTab.Overview ? "active" : "")" @onclick="() => SetDetailTab(DetailTab.Overview)">Overview</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(SelectedDetailTab == DetailTab.SlowQueries ? "active" : "")" @onclick="() => SetDetailTab(DetailTab.SlowQueries)">Slow Queries</button>
        </li>
    </ul>

    @if (SelectedDetailTab == DetailTab.SlowQueries)
    {
        <div class="card mb-3">
            <div class="card-header"><strong>@info.Hostname</strong> Slow Queries</div>
            <div class="card-body">
                <div class="d-flex gap-2 mb-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-primary" @onclick="LoadSlowQueries" disabled="@IsLoadingSlowQueries">Refresh</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadBlockingQueries" disabled="@IsLoadingBlockingQueries">Blocking</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadTopIoQueries" disabled="@IsLoadingTopIoQueries">Top IO</button>
                    @if (!string.IsNullOrWhiteSpace(SlowQueryError))
                    {
                        <span class="text-danger">@SlowQueryError</span>
                    }
                    else if (SlowQueries is not null)
                    {
                        <span class="text-muted">Rows: @SlowQueries.Count</span>
                    }
                </div>

                @if (SlowQueries is null)
                {
                    <div class="text-muted">No data loaded yet.</div>
                }
                else if (SlowQueries.Count == 0)
                {
                    <div class="text-muted">No slow queries above threshold.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm detail-table">
                            <thead>
                                <tr>
                                    <th>Session</th>
                                    <th>DB</th>
                                    <th>Status</th>
                                    <th>Command</th>
                                    <th class="text-end">Elapsed(ms)</th>
                                    <th class="text-end">CPU(ms)</th>
                                    <th class="text-end">Reads</th>
                                    <th class="text-end">Writes</th>
                                    <th>Wait</th>
                                    <th>Blocking</th>
                                    <th>Statement</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in SlowQueries)
                            {
                                <tr>
                                    <td>@row.SessionId</td>
                                    <td>@row.DatabaseName</td>
                                    <td>@row.Status</td>
                                    <td>@row.Command</td>
                                    <td class="text-end">@row.ElapsedMs</td>
                                    <td class="text-end">@row.CpuTimeMs</td>
                                    <td class="text-end">@row.Reads</td>
                                    <td class="text-end">@row.Writes</td>
                                    <td>@row.WaitType</td>
                                    <td>@row.BlockingSessionId</td>
                                    <td class="text-truncate" style="max-width: 380px;" title="@row.StatementText">@row.StatementText</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(BlockingQueryError))
                {
                    <div class="text-danger mt-3">@BlockingQueryError</div>
                }
                else if (BlockingQueries is not null)
                {
                    <div class="mt-3 mb-2"><strong>Blocking / Deadlock 후보</strong></div>
                    @if (BlockingQueries.Count == 0)
                    {
                        <div class="text-muted">No blocking sessions.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm detail-table">
                                <thead>
                                    <tr>
                                        <th>Session</th>
                                        <th>DB</th>
                                        <th>Status</th>
                                        <th>Command</th>
                                        <th class="text-end">Elapsed(ms)</th>
                                        <th class="text-end">CPU(ms)</th>
                                        <th>Wait</th>
                                        <th>Blocking</th>
                                        <th>Statement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var row in BlockingQueries)
                                {
                                    <tr>
                                        <td>@row.SessionId</td>
                                        <td>@row.DatabaseName</td>
                                        <td>@row.Status</td>
                                        <td>@row.Command</td>
                                        <td class="text-end">@row.ElapsedMs</td>
                                        <td class="text-end">@row.CpuTimeMs</td>
                                        <td>@row.WaitType</td>
                                        <td>@row.BlockingSessionId</td>
                                        <td class="text-truncate" style="max-width: 380px;" title="@row.StatementText">@row.StatementText</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(TopIoError))
                {
                    <div class="text-danger mt-3">@TopIoError</div>
                }
                else if (TopIoQueries is not null)
                {
                    <div class="mt-3 mb-2"><strong>Top IO Queries</strong></div>
                    @if (TopIoQueries.Count == 0)
                    {
                        <div class="text-muted">No heavy IO queries.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm detail-table">
                                <thead>
                                    <tr>
                                        <th>DB</th>
                                        <th class="text-end">Reads</th>
                                        <th class="text-end">Writes</th>
                                        <th class="text-end">CPU(ms)</th>
                                        <th class="text-end">Elapsed(ms)</th>
                                        <th class="text-end">Execs</th>
                                        <th>Statement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var row in TopIoQueries)
                                {
                                    <tr>
                                        <td>@row.DatabaseName</td>
                                        <td class="text-end">@row.TotalLogicalReads</td>
                                        <td class="text-end">@row.TotalLogicalWrites</td>
                                        <td class="text-end">@row.TotalCpuTimeMs</td>
                                        <td class="text-end">@row.TotalElapsedMs</td>
                                        <td class="text-end">@row.ExecutionCount</td>
                                        <td class="text-truncate" style="max-width: 380px;" title="@row.StatementText">@row.StatementText</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header"><strong>@info.Hostname</strong> Server Status</div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-12 col-md-4">
                        <div class="gauge-wrap"><canvas id="cpuGauge"></canvas></div>
                        <div class="mt-2">CPU: <strong>@info.Dynamic.CpuInfo.Usage.ToString("0.0")%</strong></div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="gauge-wrap"><canvas id="memoryGauge"></canvas></div>
                        <div class="mt-2">Memory: <strong>@info.Dynamic.MemoryInfo.Usage.ToString("0.0")%</strong></div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="gauge-wrap"><canvas id="diskGauge"></canvas></div>
                        <div class="mt-2">Disk: <strong>@info.Dynamic.DiskInfo.Percent.ToString("0.0")%</strong></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-0 align-items-stretch detail-split-row">
            <div class="col-12 col-xl-4">
                <div class="card detail-card">
                    <div class="card-header"><strong>@info.Hostname</strong> Details</div>
                    <div class="card-body p-0">
                        <table class="table table-sm detail-table mb-0">
                            <tbody>
                            <tr><td>Status</td><td>@(info.Status?.ToString() ?? "-")</td></tr>
                            <tr><td>Host</td><td>@info.Hostname</td></tr>
                            <tr><td>IP</td><td>@info.Ip</td></tr>
                            <tr><td>OS</td><td>@info.Os</td></tr>
                            <tr><td>CPU</td><td>@info.Dynamic.CpuInfo.Usage.ToString("0.0")%</td></tr>
                            <tr><td>Memory</td><td>@info.Dynamic.MemoryInfo.Usage.ToString("0.0")%</td></tr>
                            <tr><td>Disk</td><td>@info.Dynamic.DiskInfo.Percent.ToString("0.0")%</td></tr>
                            <tr><td>Disk Used</td><td>@ToGb((long)info.Dynamic.DiskInfo.Total - (long)info.Dynamic.DiskInfo.Free).ToString("0.00") GB</td></tr>
                            <tr><td>Disk Total</td><td>@ToGb((long)info.Dynamic.DiskInfo.Total).ToString("0.00") GB</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
            <div class="col-12 col-xl-8">
                <div class="card detail-history-card">
                    <div class="card-header"><strong>@info.Hostname</strong> History</div>
                    <div class="card-body p-0 detail-history-scroll">
                        <table class="table table-sm detail-table mb-0">
                            <thead><tr><th>Time</th><th>TX Mbps</th><th>RX Mbps</th><th>CPU</th><th>MEM</th></tr></thead>
                            <tbody>
                            @if (history is not null)
                            {
                                foreach (var point in history.Points.TakeLast(12).Reverse())
                                {
                                    <tr>
                                        <td>@point.TimeLabel</td>
                                        <td>@point.Tx.ToString("0.000")</td>
                                        <td>@point.Rx.ToString("0.000")</td>
                                        <td>@point.Cpu.ToString("0.0")%</td>
                                        <td>@point.Memory.ToString("0.0")%</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mt-0">
            <div class="col-12">
                <div class="card dashboard-chart-card">
                    <div class="card-header dashboard-chart-header">
                        <div>
                            <strong>Performance Charts</strong>
                            <div class="text-muted small">Switch between network traffic and system resource trends without leaving the page.</div>
                        </div>
                        <div class="dashboard-chart-tabs" role="tablist" aria-label="Chart views">
                            <button type="button"
                                    class="btn btn-sm @(SelectedChartPanel == ChartPanel.Network ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => SelectChartPanel(ChartPanel.Network)">
                                Network
                            </button>
                            <button type="button"
                                    class="btn btn-sm @(SelectedChartPanel == ChartPanel.Resource ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => SelectChartPanel(ChartPanel.Resource)">
                                Resource
                            </button>
                        </div>
                    </div>

                    <div class="card-body border-bottom dashboard-chart-summary">
                        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                            <div>
                                <div class="metric-label">Current focus</div>
                                <div class="dashboard-chart-title">@GetSelectedChartTitle()</div>
                            </div>
                            <div class="text-muted small text-end">
                                @GetSelectedChartSummaryText()
                            </div>
                        </div>
                    </div>

                    <div class="card-body chart-wrap dashboard-chart-panel @(SelectedChartPanel == ChartPanel.Network ? "" : "d-none")">
                        <div class="chart-surface">
                            <canvas id="networkChart"></canvas>
                            <div id="networkChartOverlay" class="chart-overlay"></div>
                            @if (IsChartLoading)
                            {
                                <div class="chart-state-overlay">
                                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                                    <div class="mt-2">Loading network chart...</div>
                                </div>
                            }
                        </div>
                        <div class="dashboard-chart-toolbar">
                            <div>
                                <label class="form-label mb-1">Range</label>
                                <select class="form-select" @bind="NetworkRangePreset" @bind:after="ApplyNetworkPresetAsync">
                                    <option value="realtime">Real-time</option>
                                    <option value="day">Last 24h</option>
                                    <option value="week">Last 7 days</option>
                                    <option value="month">Last 30 days</option>
                                    <option value="year">Last 12 months</option>
                                </select>
                            </div>
                            <div class="chart-range-note">@GetRangeDisplay(NetworkRangeStartLocal, NetworkRangeEndLocal)</div>
                            <button class="btn btn-outline-secondary" @onclick="ResetNetworkZoom">Reset Zoom</button>
                        </div>
                        @if (!NetworkHasData)
                        {
                            <div class="text-warning mt-2">No network data is available for this range. Try a wider range or wait for the next refresh.</div>
                        }
                    </div>
                    <div class="card-body chart-wrap dashboard-chart-panel @(SelectedChartPanel == ChartPanel.Resource ? "" : "d-none")">
                        <div class="chart-surface">
                            <canvas id="resourceChart"></canvas>
                            <div id="resourceChartOverlay" class="chart-overlay"></div>
                            @if (IsChartLoading)
                            {
                                <div class="chart-state-overlay">
                                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                                    <div class="mt-2">Loading resource chart...</div>
                                </div>
                            }
                        </div>
                        <div class="dashboard-chart-toolbar">
                            <div>
                                <label class="form-label mb-1">Range</label>
                                <select class="form-select" @bind="ResourceRangePreset" @bind:after="ApplyResourcePresetAsync">
                                    <option value="realtime">Real-time</option>
                                    <option value="day">Last 24h</option>
                                    <option value="week">Last 7 days</option>
                                    <option value="month">Last 30 days</option>
                                    <option value="year">Last 12 months</option>
                                </select>
                            </div>
                            <div class="chart-range-note">@GetRangeDisplay(ResourceRangeStartLocal, ResourceRangeEndLocal)</div>
                            <button class="btn btn-outline-secondary" @onclick="ResetResourceZoom">Reset Zoom</button>
                        </div>
                        @if (!ResourceHasData)
                        {
                            <div class="text-warning mt-2">No resource data is available for this range. Try a wider range or wait for the next refresh.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>Host data not found.</p>
}

@if (ShowSqlAccessPanel)
{
    <div class="sql-modal-backdrop" @onclick="CloseSqlAccessPanel">
        <div class="sql-modal" role="dialog" aria-modal="true" aria-labelledby="sql-access-title" @onclick:stopPropagation="true">
            <div class="sql-modal-header">
                <div>
                    <div class="settings-kicker">Configuration</div>
                    <h2 id="sql-access-title">DB Access</h2>
                    <div class="text-muted small">Manage SQL connection credentials per server from one place.</div>
                </div>
                <button type="button" class="modal-close-button" aria-label="Close" @onclick="CloseSqlAccessPanel">&times;</button>
            </div>
            <div class="sql-modal-body">
                <div class="row g-3">
                    <div class="col-12 col-xl-4">
                        <div class="list-group sql-host-list">
                            @foreach (var host in OrderedHosts)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(string.Equals(SelectedSqlHost, host.Info.Hostname, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                        @onclick="() => SelectSqlHost(host.Info.Hostname)">
                                    <span class="text-start">
                                        <span class="d-block">@host.Info.Hostname</span>
                                        <small class="opacity-75">@host.Info.Ip</small>
                                    </span>
                                    <span class="badge sql-status-badge @(host.IsOnline ? "sql-status-online" : "sql-status-offline")">
                                        @(host.IsOnline ? "Online" : "Offline")
                                    </span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-xl-8">
                        @if (SelectedSqlHost is null)
                        {
                            <div class="text-muted">Select a server on the left.</div>
                        }
                        else
                        {
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label">Server</label>
                                    <input class="form-control" @bind="SqlTargetSettings.Server" placeholder="127.0.0.1" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Port</label>
                                    <input class="form-control" type="number" @bind="SqlTargetSettings.Port" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Database</label>
                                    <input class="form-control" @bind="SqlTargetSettings.Database" placeholder="master" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Authentication</label>
                                    <select class="form-select" @bind="SqlIntegratedSecurityChoice">
                                        <option value="N">SQL Authentication</option>
                                        <option value="Y">Windows / Integrated</option>
                                    </select>
                                </div>
                                @if (!SqlTargetSettings.IntegratedSecurity)
                                {
                                    <div class="col-12">
                                        <label class="form-label">Username</label>
                                        <input class="form-control" @bind="SqlTargetSettings.Username" autocomplete="off" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Password</label>
                                        <input class="form-control" type="password" @bind="SqlTargetSettings.Password" autocomplete="new-password" />
                                    </div>
                                }
                                <div class="col-6">
                                    <label class="form-label">Encrypt</label>
                                    <select class="form-select" @bind="SqlEncryptChoice">
                                        <option value="Y">Y</option>
                                        <option value="N">N</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Trust Cert</label>
                                    <select class="form-select" @bind="SqlTrustCertificateChoice">
                                        <option value="Y">Y</option>
                                        <option value="N">N</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <div class="text-muted small">This host uses its own SQL target config for slow query, blocking, and top IO cards.</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(SqlTargetStatusMessage))
                                {
                                    <div class="col-12">
                                        <div class="alert alert-secondary mb-0">@SqlTargetStatusMessage</div>
                                    </div>
                                }
                            </div>
                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <button class="btn btn-outline-secondary" @onclick="LoadSqlTargetSettingsAsync">Reload</button>
                                <button class="btn btn-outline-warning" @onclick="ResetSqlTargetSettingsAsync">Reset to Default</button>
                                <button class="btn btn-primary" @onclick="SaveSqlTargetSettingsAsync" disabled="@IsSavingSqlTarget">Save</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string DashboardView = "DASHBOARD";
    private const string DashboardHostSettingKey = "dashboard.currentHost";
    private const string DashboardChartPanelSettingKey = "dashboard.chartPanel";
    private const string DashboardNetworkRangeSettingKey = "dashboard.networkRangePreset";
    private const string DashboardResourceRangeSettingKey = "dashboard.resourceRangePreset";
    private const int DefaultHistoryWindowMinutes = 180;
    private const int ChartWindowPoints = 120;
    private readonly TimeSpan _offlineThreshold = TimeSpan.FromSeconds(15);
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _timerCts;
    private List<HostState> Hosts { get; set; } = [];
    private Dictionary<string, HistorySeries> Histories { get; } = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, HistorySeries> ChartHistories { get; } = new(StringComparer.OrdinalIgnoreCase);
    private string CurrentHost { get; set; } = DashboardView;
    private DetailTab SelectedDetailTab { get; set; } = DetailTab.Overview;
    private bool AutoRefresh { get; set; } = true;
    private DateTime LastRefreshLocal { get; set; } = DateTime.Now;
    private bool ShowAlertPanel { get; set; } = false;
    private bool ShowSqlAccessPanel { get; set; } = false;
    private bool ShowManageMenu { get; set; } = false;
    private bool IsLoadingSlowQueries { get; set; }
    private bool IsLoadingBlockingQueries { get; set; }
    private bool IsLoadingTopIoQueries { get; set; }
    private List<SlowQueryRow>? SlowQueries { get; set; }
    private List<BlockingQueryRow>? BlockingQueries { get; set; }
    private List<TopIoQueryRow>? TopIoQueries { get; set; }
    private string? SlowQueryError { get; set; }
    private string? BlockingQueryError { get; set; }
    private string? TopIoError { get; set; }
    private string? SqlTargetStatusMessage { get; set; }
    private bool IsSavingSqlTarget { get; set; }
    private SqlTargetSettings SqlTargetSettings { get; set; } = new();
    private string? SelectedSqlHost { get; set; }
    private int _currentHistoryWindowMinutes = DefaultHistoryWindowMinutes;
    private string NetworkRangePreset { get; set; } = "realtime";
    private DateTime? NetworkRangeStartLocal { get; set; }
    private DateTime? NetworkRangeEndLocal { get; set; }
    private bool NetworkHasData { get; set; } = true;

    private string ResourceRangePreset { get; set; } = "realtime";
    private DateTime? ResourceRangeStartLocal { get; set; }
    private DateTime? ResourceRangeEndLocal { get; set; }
    private bool ResourceHasData { get; set; } = true;
    private AlertSettings AlertSettings { get; set; } = new();
    private Dictionary<string, ServerMetadata> ServerCatalog { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private List<AlertEventEntity> RecentAlerts { get; set; } = [];
    private List<MemberLoginAttemptEntity> RecentLoginFailures { get; set; } = [];
    private HttpClient? _http;
    private bool _settingsLoaded;
    private bool _uiPreferencesLoaded;
    private bool _pendingNetworkChartUpdate;
    private bool _pendingResourceChartUpdate;
    private bool IsChartLoading { get; set; }
    private ChartPanel SelectedChartPanel { get; set; } = ChartPanel.Network;
    private HostState? SelectedHost =>
        Hosts.FirstOrDefault(x => string.Equals(x.Info.Hostname, CurrentHost, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<HostState> OrderedHosts => Hosts
        .OrderBy(x => GetServerGroup(x.Info.Hostname), StringComparer.OrdinalIgnoreCase)
        .ThenByDescending(GetHostSeverity)
        .ThenBy(x => x.Info.Hostname, StringComparer.OrdinalIgnoreCase);
    private TimeOnly? MaintenanceWindowStartValue
    {
        get => TryParseTimeOnly(AlertSettings.MaintenanceWindowStart, out var value) ? value : null;
        set => AlertSettings.MaintenanceWindowStart = value?.ToString("HH:mm") ?? string.Empty;
    }

    private TimeOnly? MaintenanceWindowEndValue
    {
        get => TryParseTimeOnly(AlertSettings.MaintenanceWindowEnd, out var value) ? value : null;
        set => AlertSettings.MaintenanceWindowEnd = value?.ToString("HH:mm") ?? string.Empty;
    }

    private static bool TryParseTimeOnly(string? value, out TimeOnly time)
    {
        if (TimeOnly.TryParse(value, out time))
        {
            return true;
        }

        time = default;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        MonitorState.Changed += OnStateChanged;
        _http = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        await LoadAlertSettings();
        await LoadRecentAlertsAsync();
        await LoadRecentLoginFailuresAsync();
        RefreshSnapshot();
        StartRefreshLoop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_settingsLoaded)
        {
            try
            {
                AutoRefresh = await JS.InvokeAsync<bool>("monitorSettings.get", "autoRefresh", true);
                _settingsLoaded = true;
                StateHasChanged();
            }
            catch
            {
                return;
            }
        }

        if (!_uiPreferencesLoaded)
        {
            try
            {
                var savedPanel = await JS.InvokeAsync<string>("monitorSettings.get", DashboardChartPanelSettingKey, SelectedChartPanel.ToString()) ?? SelectedChartPanel.ToString();
                var savedNetworkPreset = await JS.InvokeAsync<string>("monitorSettings.get", DashboardNetworkRangeSettingKey, NetworkRangePreset) ?? NetworkRangePreset;
                var savedResourcePreset = await JS.InvokeAsync<string>("monitorSettings.get", DashboardResourceRangeSettingKey, ResourceRangePreset) ?? ResourceRangePreset;

                if (Enum.TryParse(savedPanel, true, out ChartPanel chartPanel))
                {
                    SelectedChartPanel = chartPanel;
                }

                NetworkRangePreset = string.IsNullOrWhiteSpace(savedNetworkPreset) ? NetworkRangePreset : savedNetworkPreset;
                ResourceRangePreset = string.IsNullOrWhiteSpace(savedResourcePreset) ? ResourceRangePreset : savedResourcePreset;
                _uiPreferencesLoaded = true;

                await InvokeAsync(StateHasChanged);
                return;
            }
            catch
            {
                _uiPreferencesLoaded = true;
            }
        }

        if (CurrentHost == DashboardView || SelectedHost is null)
        {
            IsChartLoading = false;
            return;
        }

        if (SelectedDetailTab == DetailTab.SlowQueries)
        {
            IsChartLoading = false;
            return;
        }

        bool initialized;
        try
        {
            initialized = await JS.InvokeAsync<bool>("monitorCharts.init");
        }
        catch
        {
            return;
        }
        if (!initialized)
        {
            return;
        }

        // 각 차트별로 realtime 모드이거나 명시적 업데이트 요청 시 갱신
        var info = SelectedHost.Info;
        await JS.InvokeVoidAsync("monitorCharts.updateGauges", new
        {
            cpu    = info.Dynamic.CpuInfo.Usage,
            memory = info.Dynamic.MemoryInfo.Usage,
            disk   = info.Dynamic.DiskInfo.Percent
        });

        if (_pendingNetworkChartUpdate || NetworkRangePreset == "realtime")
        {
            _pendingNetworkChartUpdate = false;
            await PushNetworkChartAsync(SelectedHost.Info.Hostname);
        }
        if (_pendingResourceChartUpdate || ResourceRangePreset == "realtime")
        {
            _pendingResourceChartUpdate = false;
            await PushResourceChartAsync(SelectedHost.Info.Hostname);
        }

        IsChartLoading = false;
    }

    private void OnStateChanged()
    {
        InvokeAsync(() =>
        {
            RefreshSnapshot();
            StateHasChanged();
        });
    }

    private void StartRefreshLoop()
    {
        _timerCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        _ = Task.Run(async () =>
        {
            while (_refreshTimer is not null && await _refreshTimer.WaitForNextTickAsync(_timerCts.Token))
            {
                if (!AutoRefresh)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    RefreshSnapshot();
                    StateHasChanged();

                    // 각 차트별로 realtime 모드일 때만 자동 갱신
                    if (CurrentHost != DashboardView && SelectedHost is not null
                        && SelectedDetailTab != DetailTab.SlowQueries)
                    {
                        try
                        {
                            var initialized = await JS.InvokeAsync<bool>("monitorCharts.init");
                            if (initialized)
                            {
                                if (NetworkRangePreset == "realtime")
                                    await PushNetworkChartAsync(SelectedHost.Info.Hostname);
                                if (ResourceRangePreset == "realtime")
                                    await PushResourceChartAsync(SelectedHost.Info.Hostname);
                            }
                        }
                        catch { }
                    }
                });
            }
        });
    }

    private void RefreshSnapshot()
    {
        Hosts = MonitorState.GetSnapshot(_offlineThreshold).ToList();
        LastRefreshLocal = DateTime.Now;
        ServerCatalog = ServerCatalogRepository.LoadAll();
        foreach (var host in Hosts)
        {
            if (!Histories.TryGetValue(host.Info.Hostname, out var history))
            {
                history = new HistorySeries();
                Histories[host.Info.Hostname] = history;
            }

            if (!ChartHistories.TryGetValue(host.Info.Hostname, out var chartHistory))
            {
                chartHistory = new HistorySeries();
                ChartHistories[host.Info.Hostname] = chartHistory;
            }

            var point = new HistoryPoint
            {
                TimestampUtc = DateTime.UtcNow,
                TimeLabel = DateTime.Now.ToString("MM-dd HH:mm"),
                Tx = host.Info.Dynamic.NetworkInfo.SentMbps,
                Rx = host.Info.Dynamic.NetworkInfo.RecvMbps,
                Cpu = host.Info.Dynamic.CpuInfo.Usage,
                Memory = host.Info.Dynamic.MemoryInfo.Usage,
                Disk = host.Info.Dynamic.DiskInfo.Percent
            };

            history.Points.Add(new HistoryPoint
            {
                TimestampUtc = point.TimestampUtc,
                TimeLabel = DateTime.Now.ToString("HH:mm:ss"),
                Tx = point.Tx,
                Rx = point.Rx,
                Cpu = point.Cpu,
                Memory = point.Memory,
                Disk = point.Disk
            });

            chartHistory.Points.Add(point);

            TrimLiveHistory(history);
            TrimHistory(chartHistory);
        }

        if (CurrentHost != DashboardView && Hosts.All(x => !string.Equals(x.Info.Hostname, CurrentHost, StringComparison.OrdinalIgnoreCase)))
        {
            CurrentHost = DashboardView;
        }
    }

    private async Task PushChartDataAsync(string host)
    {
        if (!TryGetChartHistory(host, out var history))
        {
            return;
        }

        var info = Hosts.FirstOrDefault(x => string.Equals(x.Info.Hostname, host, StringComparison.OrdinalIgnoreCase))?.Info;
        if (info is null)
        {
            return;
        }

        var networkPoints = GetChartPoints(history, ChartKind.Network);
        var resourcePoints = GetChartPoints(history, ChartKind.Resource);

        NetworkHasData = networkPoints.Count > 0;
        ResourceHasData = resourcePoints.Count > 0;

        var networkPayloadPoints = networkPoints.Count > 0 ? networkPoints : history.Points.TakeLast(1).ToList();
        var resourcePayloadPoints = resourcePoints.Count > 0 ? resourcePoints : history.Points.TakeLast(1).ToList();
        await JS.InvokeVoidAsync("monitorCharts.update", new
        {
            cpu = info.Dynamic.CpuInfo.Usage,
            memory = info.Dynamic.MemoryInfo.Usage,
            disk = info.Dynamic.DiskInfo.Percent,
            networkLabels = networkPayloadPoints.Select(x => x.TimeLabel).ToList(),
            tx = networkPayloadPoints.Select(x => x.Tx).ToList(),
            rx = networkPayloadPoints.Select(x => x.Rx).ToList(),
            resourceLabels = resourcePayloadPoints.Select(x => x.TimeLabel).ToList(),
            cpuSeries = resourcePayloadPoints.Select(x => x.Cpu).ToList(),
            memorySeries = resourcePayloadPoints.Select(x => x.Memory).ToList()
        });
    }

