@page "/log-parser"
@attribute [Authorize]
@implements IDisposable
@using Monitoring.Blazor.Models
@using Monitoring.Blazor.Services
@using Microsoft.EntityFrameworkCore
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text
@inject IDbContextFactory<MonitoringDbContext> DbFactory
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>@Language.T("IIS 로그 파서", "IIS Log Parser")</PageTitle>

<div class="log-analyzer-page">
<h1>@Language.T("IIS 로그 파서", "IIS Log Parser")</h1>
<p class="text-muted mb-3">@Language.T("`iis.log` 파일을 업로드하고 상태 코드·URL·메서드·IP 기준으로 분석합니다.", "Upload `iis.log` files and analyze by status, URL, method, and IP.")</p>

@if (IsAnalyzing)
{
    <div class="ai-analysis-overlay" aria-live="polite" aria-busy="true">
        <div class="ai-analysis-overlay__panel">
            <div class="spinner-border text-light" role="status" aria-hidden="true"></div>
            <div class="ai-analysis-overlay__title">AI 분석 중</div>
            <div class="ai-analysis-overlay__text">결과를 준비하는 중입니다. 잠시만 기다려 주세요.</div>
            <button class="btn btn-light btn-sm mt-3" @onclick="CancelAnalyzeAsync">분석 취소</button>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label">@Language.T("서버 이름", "Server Name")</label>
                <input class="form-control" @bind="ServerName" placeholder="HOST-01" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">Ollama</label>
                <select class="form-select" @bind="OllamaEnabledChoice">
                    <option value="Y">Y</option>
                    <option value="N">N</option>
                </select>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <InputFile OnChange="HandleFiles" multiple class="form-control" style="max-width: 420px;" />
            <button class="btn btn-primary" @onclick="UpdateToServerAsync" disabled="@(IsPreviewing || IsSaving || AllRows.Count == 0)">
                Update to Server
            </button>
            <button class="btn btn-warning" @onclick="CancelUploadAsync" disabled="@(!(IsPreviewing || IsSaving))">
                Cancel Upload
            </button>
            <button class="btn btn-outline-secondary" @onclick="ClearSelectedFiles" disabled="@((IsPreviewing || IsSaving) || SelectedFiles.Count == 0)">
                Clear Files
            </button>
        </div>
        @if (SelectedFiles.Count > 0)
        {
            <div class="text-muted mb-2">Selected files: @SelectedFiles.Count | Preview rows: @AllRows.Count</div>
        }
        @if (IsPreviewing)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted">@PreviewStage</span>
                    <span class="text-muted">@PreviewProgress.ToString("0")%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar" role="progressbar" style="width: @($"{PreviewProgress:0}%")"></div>
                </div>
            </div>
        }
        @if (IsSaving)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted">@SaveStage</span>
                    <span class="text-muted">@SaveProgress.ToString("0")%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: @($"{SaveProgress:0}%")"></div>
                </div>
            </div>
        }
        <div class="row g-2">
            <div class="col-12 col-md-2">
                <label class="form-label">@Language.T("상태 그룹", "Status Group")</label>
                <select class="form-select" @bind="StatusGroup">
                    <option value="">@Language.T("전체", "All")</option>
                    <option value="2">2xx</option>
                    <option value="3">3xx</option>
                    <option value="4">4xx</option>
                    <option value="5">5xx</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">@Language.T("상태 코드", "Status Code")</label>
                <input class="form-control" @bind="StatusCode" @bind:event="oninput" placeholder="ex) 404" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("URL 포함", "URL Contains")</label>
                <input class="form-control" @bind="UrlQuery" @bind:event="oninput" placeholder="/api/users" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">@Language.T("메서드", "Method")</label>
                <input class="form-control" @bind="MethodQuery" @bind:event="oninput" placeholder="GET" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("IP / 텍스트 검색", "IP / Text Search")</label>
                <input class="form-control" @bind="TextQuery" @bind:event="oninput" placeholder="192.168 or keyword" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("제외 IP", "Exclude IPs")</label>
                <input class="form-control" @bind="ExcludeIpQuery" @bind:event="oninput" placeholder="192.168.0.1, 10.0.0.2" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("프리셋", "Presets")</label>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => ApplyPreset("5xx")'>5xx</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => ApplyPreset("/api")'>/api</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => ApplyPreset("POST")'>POST</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">@Language.T("초기화", "Clear")</button>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("표시 방식", "Render")</label>
                <div class="d-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input" @bind="UseVirtualize" />
                    <span class="text-muted">@Language.T("가상 스크롤", "Virtual scroll")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var filtered = GetFilteredRows();
    var statusSummary = GetStatusSummary(filtered);
    var topUrls = GetTopUrls(filtered, 8);
    var pageRows = UseVirtualize ? filtered : GetPagedRows(filtered);
    var totalPages = GetTotalPages(filtered.Count);
}

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="metric-label">@Language.T("전체 요청 수", "Total Requests")</div>
                <div class="metric-value">@filtered.Count.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="metric-label">@Language.T("고유 IP 수", "Unique IPs")</div>
                <div class="metric-value">@filtered.Select(x => x.Ip).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="metric-label">@Language.T("탐지된 URL", "Detected URLs")</div>
                <div class="metric-value">@filtered.Select(x => x.Uri).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><strong>@Language.T("상태 코드 분석", "Status Analysis")</strong></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead>
                    <tr><th>@Language.T("상태", "Status")</th><th class="text-end">@Language.T("건수", "Count")</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in statusSummary)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td class="text-end">@item.Value.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><strong>@Language.T("상위 URL", "Top URLs")</strong></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead>
                    <tr><th>URL</th><th class="text-end">@Language.T("호출 수", "Hits")</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in topUrls)
                    {
                        <tr>
                            <td class="text-truncate" style="max-width: 420px;" title="@item.Key">@item.Key</td>
                            <td class="text-end">@item.Value.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card log-entries-card">
    <div class="card-header log-entries-header">
        <div class="log-entries-header__title">
            <strong>@Language.T("로그 항목", "Log Entries")</strong>
            <div class="text-muted small">@Language.T("현재 표시된 로그를 필터링·분석·내보냅니다.", "Filter, analyze, and export the currently visible log set.")</div>
        </div>
        <div class="log-entries-actions">
            <button class="btn btn-sm btn-outline-secondary" @onclick="RunExportNow" disabled="@IsRunningExport">@Language.T("지금 내보내기 실행", "Run Export Now")</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="RunAnalyze" disabled="@(!CanRunAnalyze)">AI 분석</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="CancelAnalyzeAsync" disabled="@(!IsAnalyzing)">AI 분석 취소</button>
            <input class="form-control form-control-sm log-question-input" placeholder="추가 질문을 작성하실 수 있습니다." @bind="AiQuestion" @bind:event="oninput" />
            <button class="btn btn-sm btn-outline-secondary" @onclick="RunAnalyze" disabled="@(!CanRunAnalyze || string.IsNullOrWhiteSpace(AiQuestion))">질문 반영</button>
            <button class="btn btn-sm btn-outline-dark" @onclick="CopyBlockCandidatesAsync" disabled="@(!CanCopyBlockCandidates)">@Language.T("차단 IP 복사", "Copy Block IPs")</button>
            <button class="btn btn-sm btn-outline-dark" @onclick="CopyRateLimitCandidatesAsync" disabled="@(!CanCopyRateLimitCandidates)">@Language.T("RateLimit IP 복사", "Copy RateLimit IPs")</button>
            <label class="form-label mb-0">@Language.T("다중 정렬", "Multi-sort")</label>
            <input type="checkbox" class="form-check-input" @bind="MultiSort" />
            <span class="badge @(UseOllama ? "text-bg-success" : "text-bg-secondary")">Ollama: @(UseOllama ? "Y" : "N")</span>
            <span class="badge text-bg-info">제외 IP 필터 적용됨</span>
            <label class="form-label mb-0">@Language.T("행", "Rows")</label>
            <select class="form-select form-select-sm w-auto" value="@PageSize" @onchange="OnPageSizeChanged" disabled="@(UseVirtualize)">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <button class="btn btn-sm btn-outline-primary" @onclick="ExportToExcel">@Language.T("Excel 내보내기", "Export Excel")</button>
        </div>
    </div>
    <div class="card-body log-entries-body">
        @if (!string.IsNullOrWhiteSpace(ExportMessage))
        {
            <div class="analysis-inline-message mb-3">
                <div class="analysis-inline-message__label">Export</div>
                <div class="analysis-inline-message__text">@ExportMessage</div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(AnalyzeMessage))
        {
            var reportSections = ParseDisplayedAnalysisSections(AnalyzeMessage);
            var topIpAccess = GetTopIpAccess(filtered, 5);
            <section class="analysis-inline-report mb-3" aria-label="AI analysis report">
                <div class="analysis-inline-report__header">
                    <button type="button" class="analysis-inline-report__toggle" @onclick="ToggleAnalysisReportCollapsed" aria-expanded="@(!IsAnalysisReportCollapsed)">
                        <span class="analysis-inline-report__icon">
                            <i class="bi @(IsAnalysisReportCollapsed ? "bi-chevron-right" : "bi-chevron-down")"></i>
                        </span>
                        <span class="analysis-inline-report__content">
                            <span class="analysis-inline-report__eyebrow">AI 분석 리포트</span>
                            <span class="analysis-inline-report__subtitle">공격 URL, 의심 IP, 대응 권고를 한 번에 확인합니다.</span>
                        </span>
                    </button>
                    <div class="analysis-inline-report__meta">
                        <button type="button" class="analysis-inline-report__action" @onclick="ToggleAnalysisReportCollapsed">
                            @(IsAnalysisReportCollapsed ? "열기" : "접기")
                        </button>
                    </div>
                </div>

                @if (!IsAnalysisReportCollapsed && reportSections.Count > 0)
                {
                    @if (LastAnalysisUsedFallback)
                    {
                        <div class="analysis-inline-report__notice">
                            자동 요약이 충분하지 않아 집계 기반 분석 결과로 표시되었습니다.
                        </div>
                    }
                    <div class="analysis-section-grid">
                        @foreach (var section in reportSections)
                        {
                            <article class="analysis-section-card">
                                <div class="analysis-section-card__header">
                                    <h3>@section.Title</h3>
                                </div>
                                <div class="analysis-section-card__body">
                                    @{
                                        var primaryLine = section.Lines.FirstOrDefault();
                                        var detailLines = section.Lines.Skip(1).ToList();
                                    }

                                    @if (!string.IsNullOrWhiteSpace(primaryLine))
                                    {
                                        <div class="analysis-section-card__primary">@primaryLine</div>
                                    }

                                    @if (detailLines.Count > 0)
                                    {
                                        <div class="analysis-section-card__list">
                                            @foreach (var line in detailLines)
                                            {
                                                if (line.StartsWith("- "))
                                                {
                                                    <div class="analysis-section-card__bullet">@line.Substring(2)</div>
                                                }
                                                else
                                                {
                                                    <p>@line</p>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                    @if (topIpAccess.Count > 0)
                    {
                        <div class="analysis-ip-chart-card" aria-label="IP 접근 TOP 5">
                            <div class="analysis-ip-chart-card__header">
                                <div>
                                    <h3>IP 접근 TOP 5</h3>
                                    <p>현재 필터된 로그 기준 요청 수가 많은 IP입니다.</p>
                                </div>
                                <span class="analysis-ip-chart-card__badge">요청 수</span>
                            </div>
                            <div class="analysis-ip-chart-card__canvas-wrap">
                                <canvas id="logParserTopIpChart" aria-label="IP 접근 TOP 5 차트"></canvas>
                            </div>
                        </div>
                    }
                }
                else if (!IsAnalysisReportCollapsed)
                {
                    <pre class="analysis-pre">@AnalyzeMessage</pre>
                }
                else
                {
                    <div class="analysis-inline-report__collapsed-note">AI 분석 리포트가 접혀 있습니다. 펼치기를 누르면 상세 내용을 확인할 수 있습니다.</div>
                }
            </section>
        }
        @if (RecentAnalysisEntries.Count > 0)
        {
            <section class="analysis-history-panel" aria-label="Recent analysis history">
                <div class="analysis-history-panel__header">
                    <button type="button" class="analysis-inline-report__toggle" @onclick="ToggleRecentReportsCollapsed">
                        <span class="analysis-inline-report__icon">
                            <i class="bi @(IsRecentReportsCollapsed ? "bi-chevron-right" : "bi-chevron-down")"></i>
                        </span>
                        <span class="analysis-inline-report__content">
                            <span class="analysis-inline-report__eyebrow">분석 기록</span>
                            <span class="analysis-history-panel__subtitle">최근 분석 결과를 선택해 다시 확인할 수 있습니다.</span>
                        </span>
                    </button>
                    <div class="analysis-inline-report__meta">
                        <button class="analysis-inline-report__action analysis-inline-report__action--secondary" @onclick="LoadRecentAnalysisHistoryAsync">새로고침</button>
                        <button type="button" class="analysis-inline-report__action" @onclick="ToggleRecentReportsCollapsed">
                            @(IsRecentReportsCollapsed ? "열기" : "접기")
                        </button>
                    </div>
                </div>
                @if (!IsRecentReportsCollapsed)
                {
                    <div class="analysis-history-list">
                        @foreach (var entry in RecentAnalysisEntries)
                        {
                            <button type="button" class="analysis-history-item" @onclick="() => LoadHistoryEntry(entry)">
                                <div class="analysis-history-item__top">
                                    <strong>@entry.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong>
                                </div>
                                <div class="analysis-history-item__meta">
                                    <span>@(entry.LogDate?.ToString() ?? "-")</span>
                                    <span>@entry.TotalRows.ToString("N0") rows</span>
                                    @if (IsFallbackResponse(entry.Response))
                                    {
                                        <span>집계 기반</span>
                                    }
                                </div>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="analysis-inline-report__collapsed-note">최근 분석 이력이 접혀 있습니다. 펼치기를 누르면 목록을 확인할 수 있습니다.</div>
                }
            </section>
        }
    </div>
    <div class="log-entries-toolbar">
        <div class="log-entries-toolbar__hint">
            <i class="bi bi-arrows-expand-vertical"></i>
            헤더 오른쪽 경계를 드래그해서 열 너비를 조절할 수 있습니다.
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetColumnWidthsAsync">열 너비 초기화</button>
    </div>
    <div class="table-responsive log-entries-table">
        <table id="log-entries-grid" class="table table-sm table-striped mb-0 log-entries-grid">
            <colgroup>
                <col class="col-date" data-column="date" />
                <col class="col-time" data-column="time" />
                <col class="col-ip" data-column="ip" />
                <col class="col-method" data-column="method" />
                <col class="col-uri" data-column="uri" />
                <col class="col-status" data-column="status" />
                <col class="col-referer" data-column="referer" />
                <col class="col-agent" data-column="agent" />
            </colgroup>
            <thead>
            <tr>
                <th class="cell-compact" data-column="date"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Date))">Date <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Date))"></i></span></button><span class="column-resizer" data-column="date" title="Resize Date column"></span></div></th>
                <th class="cell-compact" data-column="time"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Time))">Time <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Time))"></i></span></button><span class="column-resizer" data-column="time" title="Resize Time column"></span></div></th>
                <th class="cell-ip" data-column="ip"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Ip))">IP <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Ip))"></i></span></button><span class="column-resizer" data-column="ip" title="Resize IP column"></span></div></th>
                <th class="cell-compact" data-column="method"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Method))">Method <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Method))"></i></span></button><span class="column-resizer" data-column="method" title="Resize Method column"></span></div></th>
                <th class="cell-wide" data-column="uri"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Uri))">URI <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Uri))"></i></span></button><span class="column-resizer" data-column="uri" title="Resize URI column"></span></div></th>
                <th class="cell-compact" data-column="status"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Status))">Status <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Status))"></i></span></button><span class="column-resizer" data-column="status" title="Resize Status column"></span></div></th>
                <th class="cell-medium" data-column="referer"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Referrer))">Referer <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Referrer))"></i></span></button><span class="column-resizer" data-column="referer" title="Resize Referer column"></span></div></th>
                <th class="cell-agent" data-column="agent"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.UserAgent))">User-Agent <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.UserAgent))"></i></span></button><span class="column-resizer" data-column="agent" title="Resize User-Agent column"></span></div></th>
            </tr>
            <tr class="table-filter-row">
                <th class="cell-compact"><input class="form-control form-control-sm" @bind="DateFilter" @bind:event="oninput" placeholder="yyyy-mm-dd" /></th>
                <th class="cell-compact"><input class="form-control form-control-sm" @bind="TimeFilter" @bind:event="oninput" placeholder="hh:mm" /></th>
                <th class="cell-ip"><input class="form-control form-control-sm" @bind="IpFilter" @bind:event="oninput" placeholder="IP" /></th>
                <th class="cell-compact"><input class="form-control form-control-sm" @bind="MethodFilter" @bind:event="oninput" placeholder="GET" /></th>
                <th class="cell-wide"><input class="form-control form-control-sm" @bind="UriFilter" @bind:event="oninput" placeholder="/api" /></th>
                <th class="cell-compact"><input class="form-control form-control-sm" @bind="StatusFilter" @bind:event="oninput" placeholder="200" /></th>
                <th class="cell-medium"><input class="form-control form-control-sm" @bind="ReferrerFilter" @bind:event="oninput" placeholder="ref" /></th>
                <th class="cell-agent"><input class="form-control form-control-sm" @bind="AgentFilter" @bind:event="oninput" placeholder="agent" /></th>
            </tr>
            </thead>
            <tbody @key="CurrentPage">
            @if (UseVirtualize)
            {
                <Virtualize Items="filtered" Context="row" ItemSize="36" OverscanCount="12">
                    <tr @key="row" class="@GetRowClass(row)">
                        <td class="cell-compact">@row.Date</td>
                        <td class="cell-compact">@row.Time</td>
                        <td class="cell-ip">@row.Ip</td>
                        <td class="cell-compact"><span class="@GetMethodBadgeClass(row.Method)">@row.Method</span></td>
                        <td class="cell-wide text-truncate" title="@row.Uri">@row.Uri</td>
                        <td class="cell-compact"><span class="@GetStatusBadgeClass(row.Status)">@row.Status</span></td>
                        <td class="cell-medium text-truncate" title="@row.Referrer">@row.Referrer</td>
                        <td class="cell-agent text-truncate" title="@row.UserAgent">@row.UserAgent</td>
                    </tr>
                </Virtualize>
            }
            else
            {
                @foreach (var row in pageRows)
                {
                    <tr @key="row" class="@GetRowClass(row)">
                        <td class="cell-compact">@row.Date</td>
                        <td class="cell-compact">@row.Time</td>
                        <td class="cell-ip">@row.Ip</td>
                        <td class="cell-compact"><span class="@GetMethodBadgeClass(row.Method)">@row.Method</span></td>
                        <td class="cell-wide text-truncate" title="@row.Uri">@row.Uri</td>
                        <td class="cell-compact"><span class="@GetStatusBadgeClass(row.Status)">@row.Status</span></td>
                        <td class="cell-medium text-truncate" title="@row.Referrer">@row.Referrer</td>
                        <td class="cell-agent text-truncate" title="@row.UserAgent">@row.UserAgent</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
        @if (!UseVirtualize)
        {
            <div class="text-muted">@(Language.IsKorean ? $"전체 {GetStartIndex(filtered.Count)}-{GetEndIndex(filtered.Count)} / {filtered.Count}행 | {CurrentPage} / {totalPages}페이지" : $"Showing {GetStartIndex(filtered.Count)}-{GetEndIndex(filtered.Count)} of {filtered.Count} rows | Page {CurrentPage} / {totalPages}")</div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GoToFirstPage" disabled="@(CurrentPage <= 1)">First</button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="PrevPage" disabled="@(CurrentPage <= 1)">Prev</button>
                @if (ShouldShowLeadingEllipsis(filtered.Count))
                {
                    <span class="text-muted px-1">...</span>
                }
                @foreach (var pageNumber in GetVisiblePages(filtered.Count))
                {
                    <button type="button" class="btn btn-sm @(pageNumber == CurrentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                @if (ShouldShowTrailingEllipsis(filtered.Count))
                {
                    <span class="text-muted px-1">...</span>
                }
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => NextPage(filtered.Count)" disabled="@(CurrentPage >= totalPages)">Next</button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => GoToLastPage(filtered.Count)" disabled="@(CurrentPage >= totalPages)">Last</button>
            </div>
        }
    </div>
</div>

<button class="scroll-top-btn" title="Top" @onclick="ScrollToTop">↑</button>
</div>

