@page "/java-log-parser"
@attribute [Authorize]
@using Monitoring.Blazor.Models
@using Monitoring.Blazor.Services
@inject JavaLogParserService JavaParser

<PageTitle>@Language.T("Java 로그 파서", "Java Log Parser")</PageTitle>

<div class="log-analyzer-page">
    <h1>@Language.T("Java 로그 분석기", "Java Log Analyzer")</h1>
    <p class="text-muted mb-3">@Language.T("Java, Spring Boot 또는 Tomcat 로그를 업로드해 로그 레벨, 로거, 메시지를 확인합니다.", "Upload Java, Spring Boot, or Tomcat logs to review log levels, logger names, and messages.")</p>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label">@Language.T("로그 파일 업로드", "Upload log files")</label>
                    <FilePicker OnChange="HandleFiles" Multiple="true" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">@Language.T("로그 레벨", "Log level")</label>
                    <select class="form-select" @bind="LevelFilter">
                        <option value="">@Language.T("전체", "All")</option>
                        <option value="TRACE">TRACE</option>
                        <option value="DEBUG">DEBUG</option>
                        <option value="INFO">INFO</option>
                        <option value="WARN">WARN</option>
                        <option value="ERROR">ERROR</option>
                        <option value="FATAL">FATAL</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">@Language.T("검색", "Search")</label>
                    <input class="form-control" @bind="SearchText" @bind:event="oninput" placeholder="@Language.T("로거, 메시지, 스레드...", "Logger, message, thread...")" />
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button class="btn btn-primary" @onclick="ParseAsync" disabled="@(!SelectedFiles.Any() || IsParsing)">
                    @(IsParsing ? Language.T("파싱 중…", "Parsing…") : Language.T("파싱", "Parse"))
                </button>
                <button class="btn btn-outline-secondary" @onclick="ClearAsync" disabled="@IsParsing">@Language.T("초기화", "Clear")</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="alert alert-info mt-3 mb-0" role="alert">
                    @StatusMessage
                </div>
            }
        </div>
    </div>

    @{
        var filtered = GetFilteredRows();
        var levelSummary = GetLevelSummary(filtered);
        var loggerSummary = GetLoggerSummary(filtered, 8);
        var totalLines = ParsedRows.Count;
    }

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="metric-label">@Language.T("파싱된 행", "Parsed lines")</div>
                    <div class="metric-value">@totalLines.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="metric-label">@Language.T("표시 행", "Visible rows")</div>
                    <div class="metric-value">@filtered.Count.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="metric-label">@Language.T("로거 수", "Loggers")</div>
                    <div class="metric-value">@filtered.Select(x => x.Logger).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-5">
            <div class="card h-100">
                <div class="card-header"><strong>@Language.T("레벨별 요약", "Level summary")</strong></div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>@Language.T("레벨", "Level")</th><th class="text-end">@Language.T("건수", "Count")</th></tr></thead>
                        <tbody>
                        @foreach (var item in levelSummary)
                        {
                            <tr>
                                <td>@item.Key</td>
                                <td class="text-end">@item.Value.ToString("N0")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-7">
            <div class="card h-100">
                <div class="card-header"><strong>@Language.T("상위 로거", "Top loggers")</strong></div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>@Language.T("로거", "Logger")</th><th class="text-end">@Language.T("건수", "Count")</th></tr></thead>
                        <tbody>
                        @foreach (var item in loggerSummary)
                        {
                            <tr>
                                <td class="text-truncate" style="max-width: 520px;" title="@item.Key">@item.Key</td>
                                <td class="text-end">@item.Value.ToString("N0")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><strong>@Language.T("로그 항목", "Log entries")</strong></div>
        <div class="table-responsive">
            <table class="table table-sm table-striped mb-0">
                <thead>
                    <tr>
                        <th>@Language.T("시각", "Timestamp")</th>
                        <th>@Language.T("레벨", "Level")</th>
                        <th>@Language.T("스레드", "Thread")</th>
                        <th>@Language.T("로거", "Logger")</th>
                        <th>@Language.T("메시지", "Message")</th>
                        <th>@Language.T("파일", "File")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in filtered.Take(500))
                {
                    <tr>
                        <td>@row.Timestamp</td>
                        <td><span class="badge @GetLevelBadgeClass(row.Level)">@row.Level</span></td>
                        <td>@row.Thread</td>
                        <td>@row.Logger</td>
                        <td class="text-break">@row.Message</td>
                        <td>@row.SourceFile</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly List<IBrowserFile> SelectedFiles = [];
    private readonly List<JavaLogEntry> ParsedRows = [];
    private string? StatusMessage { get; set; }
    private string LevelFilter { get; set; } = string.Empty;
    private string SearchText { get; set; } = string.Empty;
    private bool IsParsing { get; set; }

    private void HandleFiles(InputFileChangeEventArgs args)
    {
        SelectedFiles.Clear();
        SelectedFiles.AddRange(args.GetMultipleFiles());
        StatusMessage = SelectedFiles.Count == 0
            ? Language.T("Java 로그 파일을 하나 이상 선택하세요.", "Select one or more Java log files.")
            : Language.T($"파일 {SelectedFiles.Count}개를 선택했습니다.", $"{SelectedFiles.Count} file{(SelectedFiles.Count == 1 ? "" : "s")} selected.");
    }

    private async Task ParseAsync()
    {
        if (!SelectedFiles.Any())
        {
            StatusMessage = Language.T("먼저 Java 로그 파일을 하나 이상 선택하세요.", "Select one or more Java log files first.");
            return;
        }

        IsParsing = true;
        ParsedRows.Clear();
        try
        {
            foreach (var file in SelectedFiles)
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 250L * 1024 * 1024);
                using var reader = new StreamReader(stream);
                var text = await reader.ReadToEndAsync();
                var lines = text.Split(Environment.NewLine, StringSplitOptions.None);
                ParsedRows.AddRange(JavaParser.ParseLines(lines, file.Name));
            }

            StatusMessage = Language.T(
                $"{SelectedFiles.Count}개 파일에서 {ParsedRows.Count:N0}개 로그 행을 파싱했습니다.",
                $"Parsed {ParsedRows.Count:N0} log lines from {SelectedFiles.Count} file{(SelectedFiles.Count == 1 ? "" : "s")}.");
        }
        catch (Exception ex)
        {
            StatusMessage = Language.T($"Java 로그 파싱에 실패했습니다: {ex.Message}", $"Failed to parse the Java logs: {ex.Message}");
        }
        finally
        {
            IsParsing = false;
        }
    }

    private Task ClearAsync()
    {
        SelectedFiles.Clear();
        ParsedRows.Clear();
        StatusMessage = null;
        LevelFilter = string.Empty;
        SearchText = string.Empty;
        return Task.CompletedTask;
    }

    private List<JavaLogEntry> GetFilteredRows()
    {
        IEnumerable<JavaLogEntry> query = ParsedRows;

        if (!string.IsNullOrWhiteSpace(LevelFilter))
        {
            query = query.Where(x => string.Equals(x.Level, LevelFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var term = SearchText.Trim();
            query = query.Where(x =>
                x.Timestamp.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.Level.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.Thread.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.Logger.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.Message.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.SourceFile.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return query.ToList();
    }

    private static List<KeyValuePair<string, int>> GetLevelSummary(List<JavaLogEntry> rows)
        => rows
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Level) ? "UNKNOWN" : x.Level.ToUpperInvariant())
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(x => x.Value)
            .ThenBy(x => x.Key)
            .ToList();

    private static List<KeyValuePair<string, int>> GetLoggerSummary(List<JavaLogEntry> rows, int take)
        => rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Logger))
            .GroupBy(x => x.Logger)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(x => x.Value)
            .ThenBy(x => x.Key)
            .Take(take)
            .ToList();

    private static string GetLevelBadgeClass(string? level)
    {
        return (level ?? string.Empty).ToUpperInvariant() switch
        {
            "ERROR" or "FATAL" => "text-bg-danger",
            "WARN" => "text-bg-warning",
            "DEBUG" => "text-bg-secondary",
            "TRACE" => "text-bg-dark",
            _ => "text-bg-info"
        };
    }
}
