        {
            _analysisCts?.Dispose();
            _ = JS.InvokeVoidAsync("monitorSettings.unwatch", "ollamaEnabled");
        }
        catch
        {
            // ignore cleanup failures
        }

        _settingsRef?.Dispose();
    }

    private sealed record OllamaAnalyzeResponse(string? Response);

    private string BuildFallbackAnalysisReport(CompactLogAnalysisPayload payload)
    {
        string T(string korean, string english) => Language.T(korean, english);
        string FormatReasons(IReadOnlyList<string> reasons, int take = 3)
            => reasons.Count == 0 ? T("근거 없음", "No specific evidence") : string.Join(", ", reasons.Take(take));

        string DescribeUrlPattern(UrlAttackDetailItem item)
        {
            if (item.IsDistributedDdosCandidate)
            {
                return T("분산 DDoS 또는 대량 요청 의심", "Possible distributed DDoS or high-volume traffic");
            }

            if (item.IsDistributedCrawler)
            {
                return T("분산 크롤링 또는 스크래핑 의심", "Possible distributed crawling or scraping");
            }

            if (item.TopIpRatio >= 0.7)
            {
                return T("단일 IP 집중형 스크래핑 의심", "Possible scraping concentrated on one IP");
            }

            if (item.Http404Count > 0 && item.Http404Count >= item.Http200Count)
            {
                return T("404 기반 스캔 또는 탐색성 접근 의심", "Possible 404 scanning or probing");
            }

            if (item.Http200Count > 0 && item.NoRefererRatio >= 0.5)
            {
                return T("정상 응답을 이용한 자동화 접근 의심", "Possible automated access receiving successful responses");
            }

            return T("반복 접근 패턴 관찰", "Repeated access pattern observed");
        }

        string DescribeAction(string action) => action switch
        {
            "Block" => T("차단 검토", "Consider blocking"),
            "RateLimit" => T("속도 제한 검토", "Consider rate limiting"),
            "Monitor" => T("모니터링", "Monitor"),
            _ => T("추가 관찰 필요", "Further review needed")
        };

        string FormatIpList(IEnumerable<string> ips, int take = 8)
        {
            var values = ips
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(take)
                .ToList();

            return values.Count == 0 ? T("없음", "None") : string.Join(", ", values);
        }

        var topAttackUrls = payload.TopUrlAttackCandidates.Take(3).ToList();
        var topScoredIps = payload.ScoredIps
            .Where(x => x.RecommendedAction is "Block" or "RateLimit" or "Monitor")
            .Take(5)
            .ToList();
        var top404Ips = payload.NotFoundScanIps.Take(5).ToList();
        var boardUrls = payload.BoardAttackCandidates.Take(3).ToList();
        var top404Urls = payload.Top404Urls.Take(3).ToList();

        var blockCandidates = payload.ScoredIps
            .Where(x => x.RecommendedAction == "Block")
            .Select(x => x.Ip)
            .Concat(payload.NotFoundScanIps.Where(x => x.RecommendedAction == "Block").Select(x => x.Ip))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .ToList();
        var rateLimitCandidates = payload.ScoredIps
            .Where(x => x.RecommendedAction == "RateLimit")
            .Select(x => x.Ip)
            .Concat(payload.NotFoundScanIps.Where(x => x.RecommendedAction == "RateLimit").Select(x => x.Ip))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .ToList();
        var monitorCandidates = payload.ScoredIps
            .Where(x => x.RecommendedAction == "Monitor")
            .Select(x => x.Ip)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .ToList();
        var suspiciousQueries = payload.SuspiciousQueryStrings.Take(5).ToList();
        var topAttack = payload.AttackSummary;
        var blockUrlCount = payload.UrlAttackDetails.Count(x => x.RecommendedAction == "Block");
        var rateLimitUrlCount = payload.UrlAttackDetails.Count(x => x.RecommendedAction == "RateLimit");
        var distributedUrls = payload.UrlAttackDetails.Where(x => x.IsDistributedAttackCandidate).OrderByDescending(x => x.Score).Take(3).ToList();
        var singleIpUrls = payload.UrlAttackDetails.Where(x => !x.IsDistributedAttackCandidate && x.TopIpRatio >= 0.7).OrderByDescending(x => x.Score).Take(3).ToList();
        var highRisk404Ips = payload.NotFoundScanIps.Where(x => x.RecommendedAction is "Block" or "RateLimit").Take(5).ToList();
        var adminProbes = payload.AdminPageProbes.Take(5).ToList();
        var backupProbes = payload.BackupFileProbes.Take(5).ToList();
        var configProbes = payload.ConfigFileProbes.Take(5).ToList();
        var scriptProbes = payload.ScriptProbeUrls.Take(5).ToList();
        var topBlockUrl = topAttackUrls.FirstOrDefault(x => x.RecommendedAction == "Block") ?? topAttackUrls.FirstOrDefault();
        var topBlockIp = payload.ScoredIps.FirstOrDefault(x => x.RecommendedAction == "Block")
            ?? payload.ScoredIps.FirstOrDefault(x => x.RecommendedAction == "RateLimit")
            ?? payload.ScoredIps.FirstOrDefault();

        var summaryText = topAttack.TopTargetUrlRequestCount > 0
            ? T($"최우선 대상은 {topAttack.TopTargetUrl}이며, 요청 {topAttack.TopTargetUrlRequestCount:N0}건이 집중되었습니다.", $"The top target is {topAttack.TopTargetUrl}, which received {topAttack.TopTargetUrlRequestCount:N0} requests.")
            : T("뚜렷한 단일 공격 대상 URL은 적지만 반복 접근 및 404 스캔 흔적이 있습니다.", "No single URL stands out as a clear attack target, but repeated access and 404 scanning patterns were detected.");

        var riskText =
            blockUrlCount >= 3 || blockCandidates.Count >= 5
                ? T("높음 — 차단 또는 속도 제한을 검토할 항목이 있습니다.", "High — some items may warrant blocking or rate limiting.")
                : rateLimitUrlCount >= 2 || rateLimitCandidates.Count >= 3
                    ? T("중간 이상 — 선제적인 속도 제한과 모니터링이 필요합니다.", "Moderate to high — proactive rate limiting and monitoring are recommended.")
                    : T("관찰 필요 — 반복 접근 패턴을 계속 확인하세요.", "Monitor for further repeated access patterns.");

        var lines = new List<string>
        {
            T("[전체 요약]", "[Overview]"),
            T($"분석 {payload.AnalyzedRequestCount:N0}건 · 제외 {payload.ExcludedRequestCount:N0}건 · 리퍼러 없음 {payload.RefererMissingRatio:P0}", $"Analyzed: {payload.AnalyzedRequestCount:N0} · Excluded: {payload.ExcludedRequestCount:N0} · No referrer: {payload.RefererMissingRatio:P0}"),
            summaryText,
            topBlockUrl is not null
                ? T($"우선 검토 URL: {topBlockUrl.Url} · {DescribeAction(topBlockUrl.RecommendedAction)}", $"Priority URL: {topBlockUrl.Url} · {DescribeAction(topBlockUrl.RecommendedAction)}")
                : string.Empty,
            topBlockIp is not null
                ? T($"우선 검토 IP: {topBlockIp.Ip} · {DescribeAction(topBlockIp.RecommendedAction)}", $"Priority IP: {topBlockIp.Ip} · {DescribeAction(topBlockIp.RecommendedAction)}")
                : string.Empty,
            "",
            T("[위험도]", "[Risk level]"),
            riskText,
            distributedUrls.Count > 0
                ? T($"분산 접근 후보 {distributedUrls.Count:N0}개 — IP 차단만으로는 부족할 수 있습니다.", $"{distributedUrls.Count:N0} distributed-access candidate(s) — blocking IPs alone may not be sufficient.")
                : T("현재는 단일 IP 또는 소수 IP에 집중된 접근 패턴이 더 많습니다.", "Current candidates are mostly concentrated on one or a small number of IPs."),
            "",
            T("[공격 의심 URL]", "[Suspicious URLs]"),
            topAttackUrls.Count > 0
                ? string.Join(Environment.NewLine, topAttackUrls.Select(x =>
                    $"- {x.Url} · {DescribeAction(x.RecommendedAction)} · 요청 {x.TotalRequests:N0} · 고유 IP {x.UniqueIpCount:N0} · 상위 IP 점유 {x.TopIpRatio:P0}"))
                : T("뚜렷한 공격 URL 후보가 충분하지 않습니다.", "There are not enough clear suspicious-URL candidates."),
            boardUrls.Count > 0
                ? T($"게시판·조회 URL: {string.Join(" · ", boardUrls.Select(x => $"{x.Url} ({x.TotalRequests:N0}건)"))}", $"Board/lookup URLs: {string.Join(" · ", boardUrls.Select(x => $"{x.Url} ({x.TotalRequests:N0} requests)"))}")
                : string.Empty,
            distributedUrls.Count > 0
                ? T($"분산 접근: {string.Join(" · ", distributedUrls.Select(x => $"{x.Url} (고유 IP {x.UniqueIpCount:N0})"))}", $"Distributed access: {string.Join(" · ", distributedUrls.Select(x => $"{x.Url} ({x.UniqueIpCount:N0} unique IPs)"))}")
                : string.Empty,
            singleIpUrls.Count > 0
                ? T($"단일 IP 집중: {string.Join(" · ", singleIpUrls.Select(x => $"{x.Url} ({x.TopIpRatio:P0})"))}", $"Single-IP concentration: {string.Join(" · ", singleIpUrls.Select(x => $"{x.Url} ({x.TopIpRatio:P0})"))}")
                : string.Empty,
            "",
            T("[의심 IP]", "[Suspicious IPs]"),
            topScoredIps.Count > 0
                ? string.Join(Environment.NewLine, topScoredIps.Select(x =>
                    $"- {x.Ip} · {DescribeAction(x.RecommendedAction)} · 점수 {x.Score} · 요청 {x.RequestCount:N0} · 주요 URL {x.DominantUrl}"))
                : T("차단 또는 제한을 검토할 IP가 충분하지 않습니다.", "There are not enough IP candidates for blocking or rate limiting."),
            top404Ips.Count > 0
                ? T($"404 스캔: {string.Join(" · ", top404Ips.Select(x => $"{x.Ip} (404 {x.NotFoundCount:N0})"))}", $"404 scans: {string.Join(" · ", top404Ips.Select(x => $"{x.Ip} ({x.NotFoundCount:N0} requests)"))}")
                : string.Empty,
            adminProbes.Count > 0
                ? T($"관리자 페이지 접근 시도: {string.Join("; ", adminProbes.Select(x => $"{x.Value}({x.Count:N0})"))}", $"Admin-page probes: {string.Join("; ", adminProbes.Select(x => $"{x.Value} ({x.Count:N0})"))}")
                : string.Empty,
            backupProbes.Count > 0
                ? T($"백업 파일 접근 시도: {string.Join("; ", backupProbes.Select(x => $"{x.Value}({x.Count:N0})"))}", $"Backup-file probes: {string.Join("; ", backupProbes.Select(x => $"{x.Value} ({x.Count:N0})"))}")
                : string.Empty,
            configProbes.Count > 0
                ? T($"설정 파일 접근 시도: {string.Join("; ", configProbes.Select(x => $"{x.Value}({x.Count:N0})"))}", $"Configuration-file probes: {string.Join("; ", configProbes.Select(x => $"{x.Value} ({x.Count:N0})"))}")
                : string.Empty,
            scriptProbes.Count > 0
                ? T($"스크립트·익스플로잇 탐색 시도: {string.Join("; ", scriptProbes.Select(x => $"{x.Value}({x.Count:N0})"))}", $"Script/exploit probes: {string.Join("; ", scriptProbes.Select(x => $"{x.Value} ({x.Count:N0})"))}")
                : string.Empty,
            suspiciousQueries.Count > 0
                ? T($"의심 쿼리 문자열: {string.Join("; ", suspiciousQueries.Select(x => $"{x.QueryString}({x.Count:N0}회, {FormatReasons(x.Reasons, 2)})"))}", $"Suspicious query strings: {string.Join("; ", suspiciousQueries.Select(x => $"{x.QueryString} ({x.Count:N0}, {FormatReasons(x.Reasons, 2)})"))}")
                : string.Empty,
            "",
            T("[대응 후보]", "[Recommended actions]"),
            T($"차단 검토: {FormatIpList(blockCandidates)}", $"Consider blocking: {FormatIpList(blockCandidates)}") + Environment.NewLine +
            T($"속도 제한 검토: {FormatIpList(rateLimitCandidates)}", $"Consider rate limiting: {FormatIpList(rateLimitCandidates)}") + Environment.NewLine +
            T($"모니터링: {FormatIpList(monitorCandidates)}", $"Monitor: {FormatIpList(monitorCandidates)}"),
            topBlockUrl is not null
                ? T($"우선 보호 검토 URL: {topBlockUrl.Url} ({DescribeUrlPattern(topBlockUrl)}, {DescribeAction(topBlockUrl.RecommendedAction)})", $"Priority URL to protect: {topBlockUrl.Url} ({DescribeUrlPattern(topBlockUrl)}, {DescribeAction(topBlockUrl.RecommendedAction)})")
                : string.Empty,
            "",
            T("[대응 방안]", "[Response plan]"),
            FallbackResponsePlanService.Build(new FallbackResponsePlanEvidence(
                topAttackUrls.Any(x => x.IsDistributedDdosCandidate),
                topAttackUrls.Any(x => x.Http200Count > 0 && x.TopIpRatio >= 0.5),
                top404Ips.Any(),
                topScoredIps.Any(x => x.SuspiciousQueryCount > 0) || payload.SuspiciousQueryStrings.Any(),
                topScoredIps.Any(x => x.BoardAccessCount >= 20)), Language.IsKorean)
        };

        if (top404Urls.Count > 0 || highRisk404Ips.Count > 0)
        {
            lines.Add(T($"404 집중 URL: {(top404Urls.Count > 0 ? string.Join(", ", top404Urls.Select(x => $"{x.Value}({x.Count:N0})")) : "없음")}", $"Top 404 URLs: {(top404Urls.Count > 0 ? string.Join(", ", top404Urls.Select(x => $"{x.Value} ({x.Count:N0})")) : "None")}"));
            lines.Add(T($"404 우선 차단·제한 검토 IP: {(highRisk404Ips.Count > 0 ? string.Join(", ", highRisk404Ips.Select(x => $"{x.Ip}({x.RecommendedAction})")) : "없음")}", $"IPs to consider blocking or rate-limiting for 404 activity: {(highRisk404Ips.Count > 0 ? string.Join(", ", highRisk404Ips.Select(x => $"{x.Ip} ({DescribeAction(x.RecommendedAction)})")) : "None")}"));
        }

        return string.Join(Environment.NewLine, lines.Where(line => !string.IsNullOrWhiteSpace(line)));
    }

    private static bool IsFallbackResponse(string? response)
    {
        if (string.IsNullOrWhiteSpace(response))
        {
            return false;
        }

        return response.Contains("로컬 집계 기반 fallback", StringComparison.OrdinalIgnoreCase)
            || response.Contains("[전체 요약]", StringComparison.Ordinal)
               && response.Contains("[차단 후보]", StringComparison.Ordinal)
               && response.Contains("[대응 방안]", StringComparison.Ordinal);
    }

    private static bool LooksTrivialAnalysis(string? response)
    {
        if (string.IsNullOrWhiteSpace(response))
        {
            return true;
        }

        var trimmed = response.Trim();
        var normalized = trimmed.Replace(".", string.Empty, StringComparison.Ordinal)
            .Replace("!", string.Empty, StringComparison.Ordinal)
            .Replace("?", string.Empty, StringComparison.Ordinal)
            .Replace(" ", string.Empty, StringComparison.Ordinal)
            .ToLowerInvariant();

        if (normalized is "ok" or "okay" or "alright" or "done" or "complete" or "완료" or "알겠습니다" or "이해했습니다")
        {
            return true;
        }

        if (trimmed.Length < 40)
        {
            return !(trimmed.Contains("위험도", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("공격 URL", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("차단", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("대응", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("공격", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("의심", StringComparison.OrdinalIgnoreCase));
        }

        return false;
    }

    private static bool NeedsStructuredAnalysisFallback(string? response)
    {
        if (LooksTrivialAnalysis(response) || string.IsNullOrWhiteSpace(response))
        {
            return true;
        }

        // Do not show an English/free-form answer as the Korean report UI.
        var koreanCharacterCount = response.Count(character => character is >= '\uAC00' and <= '\uD7A3');
        if (koreanCharacterCount < 5)
        {
            return true;
        }

        // The report renderer is card-based; a response without section markers
        // cannot be presented consistently, even when its prose is otherwise valid.
        return LogAnalysisPresentationService.ParseSections(response).Count < 2;
    }

