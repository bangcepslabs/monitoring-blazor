    private static List<AnalysisSection> ParseAnalysisSections(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return [];
        }

        var lines = text.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var sections = new List<AnalysisSection>();
        AnalysisSection? current = null;

        foreach (var raw in lines)
        {
            var line = raw.Trim();
            if (string.IsNullOrWhiteSpace(line))
            {
                continue;
            }

            var sectionTitle = NormalizeAnalysisSectionTitle(line);
            if (sectionTitle is not null)
            {
                current = new AnalysisSection(sectionTitle);
                sections.Add(current);
                continue;
            }

            if (current is null)
            {
                current = new AnalysisSection("분석 결과");
                sections.Add(current);
            }

            current.Lines.Add(line);
        }

        return sections;
    }

    private static List<AnalysisSection> ParseDisplayedAnalysisSections(string? text)
    {
        var allowed = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "공격 URL", "의심 IP", "차단 후보", "대응 방안"
        };

        return ParseAnalysisSections(text)
            .Where(section => allowed.Contains(section.Title))
            .ToList();
    }

    private static List<CountItem> GetTopIpAccess(List<ParsedLogRow> rows, int take)
    {
        return rows
            .Where(x => !IsExcludedAnalysisIp(x.Ip) && !string.IsNullOrWhiteSpace(x.Ip))
            .GroupBy(x => x.Ip.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => new CountItem(group.Key, group.Count()))
            .OrderByDescending(item => item.Count)
            .ThenBy(item => item.Value, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();
    }

    private static string? NormalizeAnalysisSectionTitle(string line)
    {
        var normalized = line.Trim();

        // Ollama may decorate the requested section marker with Markdown.
        while (normalized.StartsWith("#", StringComparison.Ordinal) ||
               normalized.StartsWith("*", StringComparison.Ordinal) ||
               normalized.StartsWith("_", StringComparison.Ordinal) ||
               normalized.StartsWith("`", StringComparison.Ordinal))
        {
            normalized = normalized[1..].TrimStart();
        }

        while (normalized.EndsWith("*", StringComparison.Ordinal) ||
               normalized.EndsWith("_", StringComparison.Ordinal) ||
               normalized.EndsWith("`", StringComparison.Ordinal))
        {
            normalized = normalized[..^1].TrimEnd();
        }

        if (normalized.StartsWith("[", StringComparison.Ordinal) &&
            normalized.EndsWith("]", StringComparison.Ordinal) &&
            normalized.Length > 2)
        {
            return normalized[1..^1].Trim();
        }

        var knownTitles = new[]
        {
            "전체 요약", "위험도", "공격 URL", "의심 IP", "차단 후보", "대응 방안", "추가 질문 답변"
        };

        return knownTitles.FirstOrDefault(title =>
            string.Equals(normalized, title, StringComparison.OrdinalIgnoreCase));
    }

