    private (DateTime? startLocal, DateTime? endLocal) GetPresetRange(string preset)
    {
        if (preset == "realtime")
        {
            return (null, null);
        }

        var endLocal = DateTime.Now;
        var startLocal = preset switch
        {
            "day" => endLocal.AddDays(-1),
            "week" => endLocal.AddDays(-7),
            "month" => endLocal.AddDays(-30),
            "year" => endLocal.AddYears(-1),
            _ => endLocal.AddMinutes(-15)
        };
        return (startLocal, endLocal);
    }

    private string GetRangeDisplay(DateTime? startLocal, DateTime? endLocal)
    {
        if (startLocal is null || endLocal is null)
