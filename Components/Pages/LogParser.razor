    };

    private List<ParsedLogRow> GetPagedRows(List<ParsedLogRow> filtered)
    {
        var totalPages = GetTotalPages(filtered.Count);
        if (CurrentPage > totalPages)
        {
            CurrentPage = totalPages;
        }

        if (CurrentPage < 1)
        {
            CurrentPage = 1;
        }

        return filtered
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private static List<KeyValuePair<string, long>> GetStatusSummary(List<ParsedLogRow> filtered)
    {
        return filtered
            .Where(x => !string.IsNullOrWhiteSpace(x.Status))
            .GroupBy(x => x.Status)
            .Select(g => new KeyValuePair<string, long>(g.Key, g.LongCount()))
            .OrderByDescending(x => x.Value)
            .ThenBy(x => x.Key, StringComparer.Ordinal)
            .ToList();
    }

    private static List<KeyValuePair<string, long>> GetTopUrls(List<ParsedLogRow> filtered, int take)
    {
        return filtered
            .Where(x => !string.IsNullOrWhiteSpace(x.Uri))
            .GroupBy(x => x.Uri)
            .Select(g => new KeyValuePair<string, long>(g.Key, g.LongCount()))
            .OrderByDescending(x => x.Value)
            .Take(take)
            .ToList();
    }

    private int GetTotalPages(int count)
    {
        if (count == 0)
        {
            return 1;
        }

        return (int)Math.Ceiling(count / (double)PageSize);
    }

    private int GetStartIndex(int count) => count == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;

    private int GetEndIndex(int count) => Math.Min(CurrentPage * PageSize, count);

    private IEnumerable<int> GetVisiblePages(int count)
    {
        var totalPages = GetTotalPages(count);
        if (totalPages <= 0)
        {
            yield break;
        }
        
        var start = Math.Max(1, CurrentPage - 2);
        var end = Math.Min(totalPages, start + 4);

        if (end - start < 4)
        {
            start = Math.Max(1, end - 4);
        }

        for (var i = start; i <= end; i++)
        {
            yield return i;
        }
    }

    private bool ShouldShowLeadingEllipsis(int count)
    {
        var totalPages = GetTotalPages(count);
        if (totalPages <= 0) return false;

        var start = Math.Max(1, CurrentPage - 2);
        var end = Math.Min(totalPages, start + 4);
        
        if (end - start < 4)
        {
            start = Math.Max(1, end - 4);
        }
        
        return start > 1; 
    }

    private bool ShouldShowTrailingEllipsis(int count)
    {
        var totalPages = GetTotalPages(count);
        if (totalPages <= 0) return false;

        var start = Math.Max(1, CurrentPage - 2);
        var end = Math.Min(totalPages, start + 4);

        return end < totalPages; 
    }

    private async Task PrevPageAsync()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await LoadWorkspacePageOnlyAsync();
        }
    }

    private async Task GoToFirstPageAsync()
    {
        CurrentPage = 1;
        await LoadWorkspacePageOnlyAsync();
    }

    private async Task NextPageAsync()
    {
        var totalPages = GetTotalPages(IsWorkspaceMode ? (int)Math.Min(WorkspaceFilteredCount, int.MaxValue) : GetFilteredRows().Count);
        if (CurrentPage < totalPages)
        {
            CurrentPage++;
            await LoadWorkspacePageOnlyAsync();
        }
    }

    private async Task GoToLastPageAsync()
    {
        CurrentPage = GetTotalPages(IsWorkspaceMode ? (int)Math.Min(WorkspaceFilteredCount, int.MaxValue) : GetFilteredRows().Count);
        await LoadWorkspacePageOnlyAsync();
    }

    private async Task GoToPageAsync(int page)
    {
