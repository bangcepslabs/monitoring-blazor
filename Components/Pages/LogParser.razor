    private static NotFoundScanIpItem BuildNotFoundScanIp(string ip, List<ParsedLogRow> rows)
    {
        var notFoundCount = rows.Count;
        var refererMissingCount = rows.Count(x => IsMissingField(x.Referrer));
        var refererMissingRatio = notFoundCount == 0 ? 0 : refererMissingCount / (double)notFoundCount;

        var urlCounts = rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Uri))
            .GroupBy(x => x.Uri.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new CountItem(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
            .Take(5)
            .ToList();

        var userAgent = rows
            .Where(x => !string.IsNullOrWhiteSpace(x.UserAgent) && !string.Equals(x.UserAgent.Trim(), "-", StringComparison.Ordinal))
            .GroupBy(x => x.UserAgent.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new CountItem(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault()?.Value ?? string.Empty;

        var adminCount = rows.Count(x => x.Uri is not null && ContainsAny(x.Uri, AdminProbeTokens));
        var backupCount = rows.Count(x => x.Uri is not null && ContainsAny(x.Uri, BackupProbeTokens));
        var configCount = rows.Count(x => x.Uri is not null && ContainsAny(x.Uri, ConfigProbeTokens));
        var sensitiveProbeCount = adminCount + backupCount + configCount;

        var reasons = new List<string>();
        var score = 0;

        if (notFoundCount >= 20)
        {
            score += 25;
            reasons.Add($"404 총 건수 과다 ({notFoundCount:N0})");
        }
        else if (notFoundCount >= 10)
        {
            score += 15;
            reasons.Add($"404 접근 다수 ({notFoundCount:N0})");
        }
        else if (notFoundCount >= 5)
        {
            score += 8;
            reasons.Add($"404 접근 관찰 ({notFoundCount:N0})");
        }

        if (adminCount > 0)
        {
            score += 10;
            reasons.Add($"관리자 경로 탐색 ({adminCount:N0})");
        }

        if (backupCount > 0)
        {
            score += 10;
            reasons.Add($"백업 파일 탐색 ({backupCount:N0})");
        }

        if (configCount > 0)
        {
            score += 10;
            reasons.Add($"설정 파일 탐색 ({configCount:N0})");
        }

        if (refererMissingRatio >= 0.8 && notFoundCount >= 5)
        {
            score += 10;
            reasons.Add($"Referer 없음 비율 높음 ({refererMissingRatio:P0})");
        }
        else if (refererMissingRatio >= 0.5 && notFoundCount >= 5)
        {
            score += 5;
            reasons.Add($"Referer 없음 비율 높음 ({refererMissingRatio:P0})");
        }

        var recommendedAction =
            sensitiveProbeCount >= 1 ? "Block" :
            notFoundCount >= 20 ? "RateLimit" :
            notFoundCount >= 5 ? "Monitor" :
            "Allow";

        if (recommendedAction is "Block" && score < 60)
        {
            score = 60;
        }
        else if (recommendedAction is "RateLimit" && score < 35)
        {
            score = 35;
        }
        else if (recommendedAction is "Monitor" && score < 15)
        {
            score = 15;
        }

        if (!string.IsNullOrWhiteSpace(userAgent))
        {
            reasons.Add($"User-Agent: {userAgent}");
        }

        return new NotFoundScanIpItem(
            ip,
            notFoundCount,
            urlCounts,
            adminCount > 0,
            backupCount > 0,
            configCount > 0,
            userAgent,
            refererMissingRatio,
            recommendedAction,
            reasons.Distinct(StringComparer.OrdinalIgnoreCase).ToList())
        {
            SensitiveProbeCount = sensitiveProbeCount,
            Score = score
        };
    }

