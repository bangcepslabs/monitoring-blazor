    private static bool IsSuspiciousUserAgent(string? userAgent)
    {
        if (string.IsNullOrWhiteSpace(userAgent) || userAgent.Trim() == "-")
        {
            return false;
        }

        var value = userAgent.Trim();
        return value.Length < 12 ||
            System.Text.RegularExpressions.Regex.IsMatch(
                value,
                @"(?i)(sqlmap|nikto|nmap|masscan|zgrab|whatweb|acunetix|nessus|wpscan|gobuster|dirbuster|python-requests|python-urllib|curl/|wget/|go-http-client|java/|libwww-perl|scrapy)");
    }

