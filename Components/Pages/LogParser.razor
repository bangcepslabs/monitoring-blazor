    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (int.TryParse(value, out var parsed) && parsed > 0)
        {
            PageSize = parsed;
            ResetPage();
            await LoadWorkspacePageOnlyAsync();
        }
