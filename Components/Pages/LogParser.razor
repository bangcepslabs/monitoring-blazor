    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        var unitIndex = 0;

        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.##} {units[unitIndex]}";
    }

    private List<ParsedLogRow> GetFilteredRows()
    {
        if (!FilterDirty)
        {
            return FilteredRows;
        }

        FilteredRows = IisLogQueryService.FilterAndSort(AllRows, BuildFilterCriteria(), Sorts);
        CachedStatusSummary = GetStatusSummary(FilteredRows);
        CachedTopUrls = GetTopUrls(FilteredRows, 8);
        CachedTopIpAccess = GetTopIpAccess(FilteredRows, 5);
        CachedUniqueIpCount = FilteredRows.Select(x => x.Ip).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).LongCount();
        CachedUniqueUrlCount = FilteredRows.Select(x => x.Uri).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).LongCount();
        FilterDirty = false;
        return FilteredRows;
    }

