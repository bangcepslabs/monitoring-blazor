                    .Select(pair => new CountItem($"{pair.Key.Uri} | {pair.Key.Status}", pair.Count()))
                    .OrderByDescending(x => x.Count)
                    .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
                    .Take(5)
                    .ToList();

                return new IpUrlStatusRepeatItem(g.Key, repeats);
            })
            .Where(x => x.Repeats.Count > 0)
            .OrderByDescending(x => x.TotalCount)
            .ThenBy(x => x.Ip, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();
    }

