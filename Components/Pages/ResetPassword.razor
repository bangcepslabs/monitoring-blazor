@page "/reset-password"
@attribute [AllowAnonymous]
@layout LoginLayout
@using Microsoft.AspNetCore.WebUtilities
@using Monitoring.Blazor.Services
@inject MemberAuthService MemberAuthService
@inject NavigationManager NavigationManager

<PageTitle>OpsEye | Reset Password</PageTitle>

<div class="login-page">
    <section class="login-shell" aria-label="Password reset form">
        <div class="login-brand">
            <div class="login-brand-mark" aria-hidden="true">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <div class="login-brand-name">OpsEye</div>
                <div class="login-brand-sub">Password reset</div>
            </div>
        </div>

        <div class="login-card card">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h1 class="h3 mb-2">Set a new password</h1>
                    <p class="text-secondary mb-0">
                        Open the password reset link sent to your email and choose a new password.
                    </p>
                </div>

                @if (string.IsNullOrWhiteSpace(_token))
                {
                    <div class="alert alert-warning" role="alert">
                        This page requires a valid password reset link from your email.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @( _isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
                }

                <div class="d-grid gap-3">
                    <div>
                        <label class="form-label" for="reset-new-password">New password</label>
                        <input id="reset-new-password" type="password" class="form-control" autocomplete="new-password" @bind="_newPassword" />
                    </div>

                    <div>
                        <label class="form-label" for="reset-confirm-password">Confirm password</label>
                        <input id="reset-confirm-password" type="password" class="form-control" autocomplete="new-password" @bind="_confirmPassword" />
                    </div>

                    <div class="alert alert-info small mb-0" role="note">
                        Password policy: at least 12 characters, uppercase, lowercase, number, special character, and no spaces.
                    </div>

                    <button type="button" class="btn btn-primary" @onclick="ResetAsync" disabled="@(!CanSubmit)">
                        Update password
                    </button>

                    <a class="btn btn-outline-secondary" href="/login">Back to login</a>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string _token = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _message;
    private bool _isError;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_token) &&
        !string.IsNullOrWhiteSpace(_newPassword) &&
        !string.IsNullOrWhiteSpace(_confirmPassword) &&
        string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal) &&
        MemberAuthService.ValidatePasswordPolicy(string.Empty, _newPassword) is null;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Token))
        {
            _token = Token!;
        }
        else
        {
            _message = "The password reset link is missing or invalid.";
            _isError = true;
        }
    }

    private async Task ResetAsync()
    {
        ClearMessage();

        if (!CanSubmit)
        {
            SetError("Please check the reset link and password policy requirements.");
            return;
        }

        try
        {
            await MemberAuthService.ResetPasswordWithTokenAsync(_token, _newPassword);
            _token = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
            SetSuccess("Password updated. You can sign in now.");
        }
        catch (Exception ex)
        {
            SetError(ex.Message);
        }
    }

    private void SetSuccess(string message)
    {
        _message = message;
        _isError = false;
    }

    private void SetError(string message)
    {
        _message = message;
        _isError = true;
    }

    private void ClearMessage()
    {
        _message = null;
        _isError = false;
    }
}
