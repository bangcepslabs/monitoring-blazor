    private List<string> ParseCandidateIpsByLabel(string label)
    {
        if (string.IsNullOrWhiteSpace(AnalyzeMessage))
        {
            return [];
        }

        var line = AnalyzeMessage
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Split('\n')
            .Select(x => x.Trim())
            .FirstOrDefault(x => x.StartsWith(label + ":", StringComparison.OrdinalIgnoreCase));

        if (string.IsNullOrWhiteSpace(line))
        {
            return [];
        }

        var value = line[(label.Length + 1)..].Trim();
        if (string.Equals(value, "없음", StringComparison.OrdinalIgnoreCase))
        {
            return [];
        }

        return value
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string BuildAnalysisJson(CompactLogAnalysisPayload payload, string? question)
    {
        var json = JsonSerializer.Serialize(payload, AnalysisJsonOptions);
        var builder = new StringBuilder();

        builder.AppendLine("아래는 IIS 로그를 압축한 보안 분석 JSON이다.");
        builder.AppendLine("이 JSON만 근거로 SOC 분석 보고서를 작성하라.");
        builder.AppendLine("반드시 한국어로 답변하라.");
        builder.AppendLine("브라우저/OS/User-Agent 일반 설명은 하지 마라.");
        builder.AppendLine("확인문구(Okay, OK, 알겠습니다, 이해했습니다)만 출력하지 마라.");
        builder.AppendLine("반드시 AttackSummary, UrlAttackDetails, TopUrlAttackCandidates, ScoredIps, NotFoundScanIps 순서로 먼저 검토하라.");
        builder.AppendLine("제외 IP 패턴과 제외 건수도 함께 확인하라.");
        builder.AppendLine("특히 UrlAttackDetails의 Top3IpRatio, Top10IpRatio, Top30IpRatio, RemainingIpCount, RemainingRequestCount, DistributedAccessScore, IsDistributedAccess, IsDistributedCrawler, IsDistributedDdosCandidate를 반드시 확인하라.");
        builder.AppendLine("분석 결과에서는 단일 IP 공격, 분산 크롤링, 분산 DDoS 의심을 명확히 구분하라.");
        builder.AppendLine("출력 형식은 반드시 [전체 요약] [위험도] [공격 URL] [의심 IP] [차단 후보] [대응 방안] 순서로 작성하라.");
        builder.AppendLine("각 섹션에는 JSON에 있는 항목과 수치를 근거로 최소 1문장 이상 작성하되, 한 문장에는 핵심 수치 3개까지만 사용하라.");

        if (!string.IsNullOrWhiteSpace(question))
        {
            builder.AppendLine();
            builder.AppendLine("추가 질문:");
            builder.AppendLine(question.Trim());
            builder.AppendLine();
            builder.AppendLine("이 질문이 있으면 기본 보안 분석 외에 반드시 질문에 직접 답하라.");
            builder.AppendLine("기본 형식은 유지하되, 마지막에 [추가 질문 답변] 섹션을 넣고 질문에 대한 결론을 명확히 작성하라.");
        }

        builder.AppendLine();
        builder.AppendLine("JSON:");
        builder.AppendLine("```json");
        builder.AppendLine(json);
        builder.AppendLine("```");

        return builder.ToString();
    }

    private static string BuildQuestionSpecificAnalysis(List<ParsedLogRow> rows, CompactLogAnalysisPayload payload, string question)
    {
        static IReadOnlyList<string> ExtractQuestionIps(string text)
        {
            var matches = System.Text.RegularExpressions.Regex.Matches(text, @"\b(?:\d{1,3}\.){3}\d{1,3}\b");
            return matches.Select(m => m.Value).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }

        static bool ContainsAny(string text, params string[] keywords)
            => keywords.Any(keyword => text.Contains(keyword, StringComparison.OrdinalIgnoreCase));

        static int GetActionRank(string action) => action switch
        {
            "Block" => 4,
            "RateLimit" => 3,
            "Monitor" => 2,
            "Allow" => 1,
            _ => 0
        };

        static string GetReviewVerdict(string action) => action switch
        {
            "Block" => "차단 유지 권고",
            "RateLimit" => "즉시 차단보다는 속도 제한 권고",
            "Monitor" => "즉시 차단 근거는 약해 모니터링 재검토 권고",
            _ => "즉시 차단 근거 부족"
        };

        static string FormatCountItems(IEnumerable<CountItem> items, int take = 5)
        {
            var values = items.Take(take).Select(x => $"{x.Value}({x.Count:N0})").ToList();
            return values.Count == 0 ? "없음" : string.Join(", ", values);
        }

        var normalizedQuestion = question.Trim();
        var questionIps = ExtractQuestionIps(normalizedQuestion);
        var isAdminQuestion = ContainsAny(normalizedQuestion, "관리자", "admin", "console", "dashboard", "manager", "login");
        var isConfigQuestion = ContainsAny(normalizedQuestion, "설정 파일", "config", "web.config", "appsettings", ".env", "credentials", "service-account", "serviceaccount");
        var isBackupQuestion = ContainsAny(normalizedQuestion, "백업", "backup", ".bak", ".old", ".zip");
        var isScriptProbeQuestion = ContainsAny(normalizedQuestion, "스크립트", "script", "shell", "phpmyadmin", "wp-admin", "wp-login", "exploit");
        var isXssQuestion = ContainsAny(normalizedQuestion, "xss", "스크립트 인젝션", "querystring", "쿼리스트링", "sql injection", "sqli", "인젝션");
        var isCrawlingQuestion = ContainsAny(normalizedQuestion, "크롤링", "크롤러", "스크래핑", "스크래퍼", "scraping", "crawler", "봇", "bot", "자동화", "대량 접근", "분산 접근", "ddos", "디도스");

        var lines = new List<string>
        {
            "[추가 질문 답변]",
            $"질문: {normalizedQuestion}"
        };

        if (questionIps.Count > 0)
        {
            lines.Add($"질문에서 추출된 IP {questionIps.Count:N0}개를 현재 필터된 원본 로그와 다시 대조해 차단 적절성을 재평가했습니다.");

            var blockIps = new List<string>();
            var rateLimitIps = new List<string>();
            var monitorIps = new List<string>();
            var matchedRowsIps = new List<string>();
            var existingCandidateIps = payload.ScoredIps.Select(x => x.Ip)
                .Concat(payload.NotFoundScanIps.Select(x => x.Ip))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            foreach (var ip in questionIps)
            {
                var ipRows = rows.Where(x => string.Equals(x.Ip?.Trim(), ip, StringComparison.OrdinalIgnoreCase)).ToList();
                if (ipRows.Count == 0)
                {
                    lines.Add($"- {ip}: 현재 분석 대상 로그에서 직접 보이지 않습니다.");
                    continue;
                }

                matchedRowsIps.Add(ip);

                var total = ipRows.Count;
                var count200 = ipRows.Count(x => string.Equals(x.Status?.Trim(), "200", StringComparison.OrdinalIgnoreCase));
                var count404 = ipRows.Count(x => string.Equals(x.Status?.Trim(), "404", StringComparison.OrdinalIgnoreCase));
                var missingReferer = ipRows.Count(x => string.IsNullOrWhiteSpace(x.Referrer) || x.Referrer == "-");
                var topUrls = ipRows.Where(x => !string.IsNullOrWhiteSpace(x.Uri))
                    .GroupBy(x => x.Uri.Trim(), StringComparer.OrdinalIgnoreCase)
                    .Select(g => new CountItem(g.Key, g.Count()))
                    .OrderByDescending(x => x.Count)
                    .Take(3)
                    .ToList();
                var topUrl = topUrls.FirstOrDefault();
                var rescored = BuildScoredIp(ip, ipRows, rows.Count);
                var rescanned404 = count404 > 0
                    ? BuildNotFoundScanIp(ip, ipRows.Where(x => string.Equals(x.Status?.Trim(), "404", StringComparison.OrdinalIgnoreCase)).ToList())
                    : null;
                var action = GetActionRank(rescored.RecommendedAction) >= GetActionRank(rescanned404?.RecommendedAction ?? string.Empty)
                    ? rescored.RecommendedAction
                    : rescanned404!.RecommendedAction;
                var reasons = rescored.Reasons
                    .Concat(rescanned404?.Reasons ?? Array.Empty<string>())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
                var dominantUrl = !string.IsNullOrWhiteSpace(rescored.DominantUrl)
                    ? $"{rescored.DominantUrl} {rescored.DominantUrlRatio:P0}"
                    : "-";
                var verdict = GetReviewVerdict(action);

                lines.Add($"- {ip}: 총 {total:N0}건, 200={count200:N0}, 404={count404:N0}, Referer 없음 {missingReferer / (double)total:P0}, 재평가 {action} ({verdict}).");
                if (topUrl is not null)
                {
                    lines.Add($"  주요 URL: {string.Join(", ", topUrls.Select(x => $"{x.Value}({x.Count:N0})"))}");
                }
                lines.Add($"  집중도: 상위 URL 비중 {rescored.DominantUrlRatio:P0}, 대표 URL {dominantUrl}");
                if (reasons.Count > 0)
                {
                    lines.Add($"  근거: {string.Join(", ", reasons.Take(4))}");
                }
                if (existingCandidateIps.Contains(ip))
                {
                    lines.Add("  기존 AI 요약 후보 목록에도 포함되어 있었습니다.");
                }

                switch (action)
                {
                    case "Block":
                        blockIps.Add(ip);
                        break;
                    case "RateLimit":
                        rateLimitIps.Add(ip);
                        break;
                    default:
                        monitorIps.Add(ip);
                        break;
                }
            }

            if (matchedRowsIps.Count > 0)
            {
                lines.Add($"질문 IP 중 현재 로그에 실제로 존재한 IP: {string.Join(", ", matchedRowsIps)}");
            }

            if (blockIps.Count > 0)
            {
                lines.Add($"결론: 즉시 차단 유지 권고 IP는 {string.Join(", ", blockIps.Distinct(StringComparer.OrdinalIgnoreCase))} 입니다.");
            }
            else if (rateLimitIps.Count > 0)
            {
                lines.Add($"결론: 우선 속도 제한 권고 IP는 {string.Join(", ", rateLimitIps.Distinct(StringComparer.OrdinalIgnoreCase))} 입니다.");
            }
            else if (monitorIps.Count > 0)
            {
                lines.Add($"결론: 현재는 모니터링 우선 대상 IP는 {string.Join(", ", monitorIps.Distinct(StringComparer.OrdinalIgnoreCase))} 입니다.");
            }

            var likelyOverblocked = monitorIps.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (likelyOverblocked.Count > 0)
            {
                lines.Add($"재검토: 즉시 차단보다는 모니터링 또는 속도 제한이 더 자연스러운 IP는 {string.Join(", ", likelyOverblocked)} 입니다.");
            }
        }

        if (isAdminQuestion || isConfigQuestion || isBackupQuestion || isScriptProbeQuestion || isXssQuestion || isCrawlingQuestion)
        {
            if (isAdminQuestion)
            {
                lines.Add(payload.AdminPageProbes.Count > 0
                    ? $"관리자 페이지 접근 시도는 있습니다. 상위 패턴은 {FormatCountItems(payload.AdminPageProbes)} 입니다."
                    : "현재 집계 기준으로는 관리자 페이지 접근 시도가 두드러지게 잡히지 않았습니다.");
            }

            if (isConfigQuestion)
            {
                lines.Add(payload.ConfigFileProbes.Count > 0
                    ? $"설정 파일 접근 시도는 있습니다. 상위 패턴은 {FormatCountItems(payload.ConfigFileProbes)} 입니다."
                    : "현재 집계 기준으로는 설정 파일 접근 시도가 두드러지게 잡히지 않았습니다.");
            }

            if (isBackupQuestion)
            {
                lines.Add(payload.BackupFileProbes.Count > 0
                    ? $"백업 파일 접근 시도는 있습니다. 상위 패턴은 {FormatCountItems(payload.BackupFileProbes)} 입니다."
                    : "현재 집계 기준으로는 백업 파일 접근 시도가 두드러지게 잡히지 않았습니다.");
            }

            if (isScriptProbeQuestion)
            {
                lines.Add(payload.ScriptProbeUrls.Count > 0
                    ? $"스크립트/관리도구/익스플로잇 탐색 시도는 있습니다. 상위 패턴은 {FormatCountItems(payload.ScriptProbeUrls)} 입니다."
                    : "현재 집계 기준으로는 스크립트/익스플로잇 탐색 시도가 두드러지게 잡히지 않았습니다.");
            }

            if (isXssQuestion)
            {
                lines.Add(payload.SuspiciousQueryStrings.Count > 0
                    ? $"의심 QueryString 또는 XSS/인젝션성 요청 흔적은 있습니다. 상위 패턴은 {string.Join(", ", payload.SuspiciousQueryStrings.Take(5).Select(x => $"{x.QueryString}({x.Count:N0}회, {string.Join("/", x.Reasons.Take(2))})"))} 입니다."
                    : "현재 집계 기준으로는 XSS/인젝션성 QueryString 흔적이 뚜렷하게 잡히지 않았습니다.");
            }

            if (isCrawlingQuestion)
            {
                var crawlerUrls = payload.UrlAttackDetails
                    .Where(x => x.IsDistributedCrawler || x.IsDistributedDdosCandidate || x.Http200Count > 0 && x.NoRefererRatio >= 0.5)
                    .OrderByDescending(x => x.Score)
                    .ThenByDescending(x => x.TotalRequests)
                    .Take(5)
                    .ToList();
                var singleIpUrls = payload.UrlAttackDetails
                    .Where(x => !x.IsDistributedAccess && x.TopIpRatio >= 0.5)
                    .OrderByDescending(x => x.Score)
                    .ThenByDescending(x => x.TotalRequests)
                    .Take(5)
                    .ToList();
                var crawlerIps = payload.ScoredIps
                    .Where(x => x.RecommendedAction is "Block" or "RateLimit" or "Monitor")
                    .Where(x => x.BoardAccessCount > 0 || x.DominantUrlRatio >= 0.7 || x.RefererMissingRatio >= 0.8)
                    .OrderByDescending(x => x.Score)
                    .Take(8)
                    .ToList();

                if (crawlerUrls.Count > 0)
                {
                    lines.Add($"크롤링/자동화 접근 후보 URL은 {string.Join("; ", crawlerUrls.Select(x => $"{x.Url}({x.RecommendedAction}, 총 {x.TotalRequests:N0}회, 200={x.Http200Count:N0}, 고유 IP {x.UniqueIpCount:N0}, Referer 없음 {x.NoRefererRatio:P0}, Top IP {x.TopIp} {x.TopIpRatio:P0})"))} 입니다.");
                    var distributed = crawlerUrls.Where(x => x.IsDistributedCrawler || x.IsDistributedDdosCandidate).ToList();
                    if (distributed.Count > 0)
                    {
                        lines.Add($"분산형 후보: {string.Join(", ", distributed.Select(x => $"{x.Url}(분산점수 {x.DistributedAccessScore}, Top10 {x.Top10IpRatio:P0})"))}. 여러 IP가 동일 URL을 반복한 패턴이라 IP 하나만 차단하기보다 URL RateLimit, 캐시/CDN, WAF를 우선 검토하세요.");
                    }
                }
                else
                {
                    lines.Add("현재 집계에서 200 정상 응답을 포함한 반복·분산 크롤링 후보 URL이 뚜렷하게 확인되지 않았습니다.");
                }

                if (singleIpUrls.Count > 0)
                {
                    lines.Add($"단일 IP 집중형 후보: {string.Join("; ", singleIpUrls.Select(x => $"{x.Url}(상위 IP {x.TopIp} {x.TopIpRatio:P0}, 총 {x.TotalRequests:N0}회)"))}. 대표 IP는 차단 또는 RateLimit을 URL 보호와 함께 적용하는 것이 적절합니다.");
                }

                if (crawlerIps.Count > 0)
                {
                    lines.Add($"크롤링 의심 IP: {string.Join(", ", crawlerIps.Select(x => $"{x.Ip}({x.RecommendedAction}, score={x.Score}, 주요 URL {x.DominantUrl} {x.DominantUrlRatio:P0}, Referer 없음 {x.RefererMissingRatio:P0})"))}");
                }

                lines.Add(crawlerUrls.Any(x => x.IsDistributedDdosCandidate)
                    ? "판단: 분산 DDoS 가능성이 있는 URL이 있어 IP 개별 차단만으로는 부족합니다. URL별 속도 제한과 WAF/CDN 방어를 우선 적용하세요."
                    : crawlerUrls.Any(x => x.IsDistributedCrawler)
                        ? "판단: 분산 크롤링/스크래핑 패턴이 우선 의심됩니다. 게시판·조회 URL의 호출 빈도와 Referer 없는 200 요청을 제한하세요."
                        : singleIpUrls.Count > 0
                            ? "판단: 현재는 단일 IP 집중형 자동화 접근이 더 뚜렷합니다. 해당 IP와 반복 URL을 함께 제한하세요."
                            : "판단: 명확한 크롤링 후보가 적어 모니터링을 유지하고 반복 URL 추이를 확인하세요.");
            }

            var related404Ips = payload.NotFoundScanIps
                .Where(x =>
                    (isAdminQuestion && x.HasAdminProbe) ||
                    (isConfigQuestion && x.HasConfigProbe) ||
                    (isBackupQuestion && x.HasBackupProbe))
                .Take(5)
                .ToList();

            if (related404Ips.Count > 0)
            {
                lines.Add($"관련 차단/제한 후보 IP: {string.Join(", ", related404Ips.Select(x => $"{x.Ip}({x.RecommendedAction}, 404={x.NotFoundCount:N0})"))}");
            }
        }

        return lines.Count > 2 ? string.Join(Environment.NewLine, lines) : string.Empty;
    }

    private static bool IsExcludedAnalysisIp(string? ip)
    {
        if (string.IsNullOrWhiteSpace(ip))
        {
            return false;
        }

        var value = ip.Trim();
        return AnalysisExcludedIpPrefixes.Any(prefix => value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
    }

    private static CompactLogAnalysisPayload BuildAnalysisPayload(List<ParsedLogRow> rows, string? question)
    {
        var total = rows.Count;
        var analyzedRows = rows
            .Where(row => !IsExcludedAnalysisIp(row.Ip))
            .ToList();
        var analyzedCount = analyzedRows.Count;
        var excludedCount = total - analyzedCount;
        var excludedPatterns = AnalysisExcludedIpPatterns.ToArray();

        var ipStats = analyzedRows
            .Where(x => !string.IsNullOrWhiteSpace(x.Ip))
            .GroupBy(x => x.Ip.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => BuildScoredIp(g.Key, g.ToList(), analyzedCount))
            .OrderByDescending(x => x.Score)
            .ThenByDescending(x => x.RequestCount)
            .ThenBy(x => x.Ip, StringComparer.OrdinalIgnoreCase)
            .Take(50)
            .ToList();

        var urlAttackDetails = BuildUrlAttackDetails(analyzedRows, 30);
        var attackSummary = BuildAttackSummary(urlAttackDetails, 10);
        var top404Urls = GetStatusUrlCounts(analyzedRows, "404", 30);
        var top404Ips = GetStatusIpCounts(analyzedRows, "404", 30);
        var adminPageProbes = GetProbeUrls(analyzedRows, AdminProbeTokens.ToArray(), 30);
        var backupFileProbes = GetProbeUrls(analyzedRows, BackupProbeTokens.ToArray(), 30);
        var configFileProbes = GetProbeUrls(analyzedRows, ConfigProbeTokens.ToArray(), 30);
        var scriptProbeUrls = GetProbeUrls(analyzedRows, ScriptProbeTokens.ToArray(), 30);
        var notFoundScanIps = GetNotFoundScanIps(analyzedRows, 50);
        var topUrlAttackCandidates = urlAttackDetails
            .Where(x => x.RecommendedAction is "Block" or "RateLimit")
            .DistinctBy(x => x.Url, StringComparer.OrdinalIgnoreCase)
            .Take(15)
            .ToList();
        var boardAttackCandidates = urlAttackDetails
            .Where(x => x.IsBoardUrl && x.RecommendedAction is "Block" or "RateLimit")
            .DistinctBy(x => x.Url, StringComparer.OrdinalIgnoreCase)
            .Take(15)
            .ToList();
        var compactScoredIps = ipStats
            .Where(x => x.RecommendedAction is "Block" or "RateLimit" or "Monitor")
            .DistinctBy(x => x.Ip, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(x => x.SensitiveProbeCount > 0)
            .ThenByDescending(x => x.RecommendedAction == "Block")
            .ThenByDescending(x => x.Score)
            .Take(15)
            .ToList();
        var compactNotFoundScanIps = notFoundScanIps
            .DistinctBy(x => x.Ip, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(x => x.SensitiveProbeCount > 0)
            .ThenByDescending(x => x.RecommendedAction == "Block")
            .ThenByDescending(x => x.Score)
            .ThenByDescending(x => x.NotFoundCount)
            .Take(15)
            .ToList();
        var compactTop404Urls = top404Urls.Take(15).ToList();
        var compactTop404Ips = top404Ips.Take(15).ToList();
        var compactSuspiciousQueryStrings = GetSuspiciousQueryStrings(analyzedRows, 15);
        var compactTopUrlAttackCandidates = topUrlAttackCandidates
            .DistinctBy(x => x.Url, StringComparer.OrdinalIgnoreCase)
            .Take(15)
            .ToList();
        var compactBoardAttackCandidates = boardAttackCandidates
            .DistinctBy(x => x.Url, StringComparer.OrdinalIgnoreCase)
            .Take(15)
            .ToList();

        return new CompactLogAnalysisPayload
        {
            GeneratedUtc = DateTime.UtcNow,
            TotalRequestCount = total,
            AnalyzedRequestCount = analyzedCount,
            ExcludedRequestCount = excludedCount,
            ExcludedIpPatterns = excludedPatterns,
            UniqueIpCount = rows.Select(x => x.Ip)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count(),
            RefererMissingRatio = analyzedCount == 0 ? 0 : GetMissingRefererCount(analyzedRows) / (double)analyzedCount,
            AttackSummary = attackSummary,
            UrlAttackDetails = urlAttackDetails,
            ScoredIps = compactScoredIps,
            NotFoundScanIps = compactNotFoundScanIps,
            TopUrlAttackCandidates = compactTopUrlAttackCandidates,
            BoardAttackCandidates = compactBoardAttackCandidates,
            SuspiciousQueryStrings = compactSuspiciousQueryStrings,
            Top404Urls = compactTop404Urls,
            Top404Ips = compactTop404Ips,
            AdminPageProbes = adminPageProbes.Take(15).ToList(),
            BackupFileProbes = backupFileProbes.Take(15).ToList(),
            ConfigFileProbes = configFileProbes.Take(15).ToList(),
            ScriptProbeUrls = scriptProbeUrls.Take(15).ToList(),
            Question = string.IsNullOrWhiteSpace(question) ? null : question.Trim()
        };
    }

    private static ScoredIpItem BuildScoredIp(string ip, List<ParsedLogRow> rows, int totalCount)
    {
        var requestCount = rows.Count;
        var refererMissingCount = rows.Count(x => IsMissingField(x.Referrer));
        var errorCount = rows.Count(x => IsErrorStatus(x.Status));
        var suspiciousQueryCount = rows.Count(x => ExtractSuspiciousQueryString(x.Uri) is not null);
        var http200Rows = rows.Where(x => string.Equals(x.Status?.Trim(), "200", StringComparison.OrdinalIgnoreCase)).ToList();
        var http200Count = http200Rows.Count;
        var http200RefererMissingCount = http200Rows.Count(x => IsMissingField(x.Referrer));

        var urlCounts = rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Uri))
            .GroupBy(x => x.Uri.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new { Url = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToList();

        var http200UrlCounts = http200Rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Uri))
            .GroupBy(x => x.Uri.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new { Url = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToList();

        var board200Rows = http200Rows
            .Where(x => IsBoardUrl(x.Uri))
            .ToList();
        var board200Count = board200Rows.Count;
        var board200UrlCounts = board200Rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Uri))
            .GroupBy(x => x.Uri.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new { Url = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToList();

        var uaCounts = rows
            .Where(x => !string.IsNullOrWhiteSpace(x.UserAgent) && !string.Equals(x.UserAgent.Trim(), "-", StringComparison.Ordinal))
            .GroupBy(x => x.UserAgent.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new { UserAgent = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToList();

        var repeatUrlCount = urlCounts.FirstOrDefault()?.Count ?? 0;
        var http200RepeatUrlCount = http200UrlCounts.FirstOrDefault()?.Count ?? 0;
        var repeatUaCount = uaCounts.FirstOrDefault()?.Count ?? 0;
        var topUrl = urlCounts.FirstOrDefault();
        var topUrlValue = topUrl?.Url ?? string.Empty;
        var topUrlCount = topUrl?.Count ?? 0;
        var top200Url = http200UrlCounts.FirstOrDefault();
        var top200UrlValue = top200Url?.Url ?? string.Empty;
        var top200UrlCount = top200Url?.Count ?? 0;
        var topBoardUrl = board200UrlCounts.FirstOrDefault();
        var topBoardUrlValue = topBoardUrl?.Url ?? string.Empty;
        var topBoardUrlCount = topBoardUrl?.Count ?? 0;
        var dominantUrlRatio = requestCount == 0 ? 0 : topUrlCount / (double)requestCount;
        var boardUrlRatio = requestCount == 0 ? 0 : board200Count / (double)requestCount;
        var adminProbeCount = rows.Count(x => x.Uri is not null && ContainsAny(x.Uri, AdminProbeTokens));
        var adminProbeErrorCount = rows.Count(x => x.Uri is not null && ContainsAny(x.Uri, AdminProbeTokens) && IsErrorStatus(x.Status));
        var backupProbeCount = rows.Count(x => x.Uri is not null && ContainsAny(x.Uri, BackupProbeTokens));
        var configProbeCount = rows.Count(x => x.Uri is not null && ContainsAny(x.Uri, ConfigProbeTokens));
        var scriptProbeCount = rows.Count(x => x.Uri is not null && ContainsAny(x.Uri, ScriptProbeTokens));
        var sensitiveProbeCount = adminProbeCount + backupProbeCount + configProbeCount + scriptProbeCount;

        var reasons = new List<string>();
        var score = 0;

        // 민감 경로 탐색은 단순 트래픽 양보다 우선해 차단 후보에 반영한다.
        if (configProbeCount > 0)
        {
            score += 70;
            reasons.Add($"설정 파일 접근 시도 ({configProbeCount:N0})");
        }

        if (backupProbeCount > 0)
        {
            score += 60;
            reasons.Add($"백업 파일 접근 시도 ({backupProbeCount:N0})");
        }

        if (scriptProbeCount > 0)
        {
            score += 55;
            reasons.Add($"스크립트/관리 도구 탐색 ({scriptProbeCount:N0})");
        }

        if (adminProbeCount > 0)
        {
            score += adminProbeCount >= 2 || adminProbeErrorCount > 0 ? 45 : 25;
            reasons.Add($"관리자 경로 접근 시도 ({adminProbeCount:N0})");
        }

        var requestRatio = totalCount == 0 ? 0 : requestCount / (double)totalCount;
        if (requestCount >= 100)
        {
            score += 25;
            reasons.Add($"요청 수 과다 ({requestCount:N0})");
        }
        else if (requestCount >= 50)
        {
            score += 15;
            reasons.Add($"요청 수 증가 ({requestCount:N0})");
        }

        var refererMissingRatio = requestCount == 0 ? 0 : refererMissingCount / (double)requestCount;
        if (refererMissingRatio >= 0.8 && requestCount >= 20)
        {
            score += 15;
            reasons.Add($"Referer 없음 비율 높음 ({refererMissingRatio:P0})");
        }
        else if (refererMissingRatio >= 0.5 && requestCount >= 10)
        {
            score += 8;
            reasons.Add($"Referer 없음 비율 높음 ({refererMissingRatio:P0})");
        }

        if (repeatUrlCount >= 20)
        {
            score += 20;
            reasons.Add($"동일 URL 반복 호출 ({urlCounts[0].Url} x{repeatUrlCount})");
        }
        else if (repeatUrlCount >= 10)
        {
            score += 10;
            reasons.Add($"동일 URL 반복 호출 ({urlCounts[0].Url} x{repeatUrlCount})");
        }

        if (http200RepeatUrlCount >= 20)
        {
            score += 30;
            reasons.Add($"HTTP 200 동일 URL 반복 호출 ({top200UrlValue} x{http200RepeatUrlCount})");
        }
        else if (http200RepeatUrlCount >= 10)
        {
            score += 15;
            reasons.Add($"HTTP 200 동일 URL 반복 호출 ({top200UrlValue} x{http200RepeatUrlCount})");
        }

        if (board200Count >= 20 && (boardUrlRatio >= 0.5 || topBoardUrlCount >= 10))
        {
            score += 30;
            reasons.Add($"게시판 URL 집중 접근 ({topBoardUrlValue} x{topBoardUrlCount}, {boardUrlRatio:P0})");
        }
        else if (board200Count >= 10)
        {
            score += 15;
            reasons.Add($"게시판 URL 접근 다수 ({board200Count:N0})");
        }

        if (http200RefererMissingCount >= 20)
        {
            var http200NoRefererRatio = http200Count == 0 ? 0 : http200RefererMissingCount / (double)http200Count;
            score += 20;
            reasons.Add($"Referer 없는 200 요청 다수 ({http200RefererMissingCount:N0}, {http200NoRefererRatio:P0})");
        }
        else if (http200RefererMissingCount >= 10)
        {
            score += 10;
            reasons.Add($"Referer 없는 200 요청 다수 ({http200RefererMissingCount:N0})");
        }

        if (dominantUrlRatio >= 0.7 && requestCount >= 20)
        {
            score += 20;
            reasons.Add($"전체 요청 중 특정 URL 비율 높음 ({topUrlValue}, {dominantUrlRatio:P0})");
        }

        if (errorCount >= 20)
        {
            score += 20;
            reasons.Add($"4xx/5xx 오류 다수 ({errorCount:N0})");
        }
        else if (errorCount >= 10)
        {
            score += 10;
            reasons.Add($"4xx/5xx 오류 다수 ({errorCount:N0})");
        }

        if (suspiciousQueryCount >= 10)
        {
            score += 20;
            reasons.Add($"의심 QueryString 포함 ({suspiciousQueryCount:N0})");
        }
        else if (suspiciousQueryCount >= 3)
        {
            score += 10;
            reasons.Add($"의심 QueryString 포함 ({suspiciousQueryCount:N0})");
        }

        if (requestRatio >= 0.2 && requestCount >= 20)
        {
            score += 5;
            reasons.Add($"전체 트래픽 비중 높음 ({requestRatio:P0})");
        }

        if (repeatUaCount >= 10)
        {
            score += 5;
            reasons.Add($"동일 User-Agent 반복 ({uaCounts[0].UserAgent} x{repeatUaCount})");
        }

        var botMatch = rows
            .Select(x => ClassifyBot(x.UserAgent))
            .Count(x => x is not null);
        var isBot = botMatch > 0;

        var recommendedAction = GetRecommendedAction(score, requestCount, refererMissingRatio, errorCount, suspiciousQueryCount, isBot);
        if (board200Count >= 20 && (boardUrlRatio >= 0.5 || dominantUrlRatio >= 0.7))
        {
            recommendedAction = score >= 80 ? "Block" : "RateLimit";
        }
        else if (http200RepeatUrlCount >= 20 && dominantUrlRatio >= 0.7)
        {
            recommendedAction = score >= 80 ? "Block" : "RateLimit";
        }

        if (configProbeCount > 0 || backupProbeCount > 0 || scriptProbeCount > 0 || adminProbeCount >= 2 || adminProbeErrorCount > 0)
        {
            recommendedAction = "Block";
        }
        else if (adminProbeCount > 0 || sensitiveProbeCount > 0)
        {
            recommendedAction = "RateLimit";
        }

        if (score == 0 && requestCount > 0)
        {
            score = Math.Min(5, requestCount);
            reasons.Add("기본 관찰 대상");
            recommendedAction = "Allow";
        }

        return new ScoredIpItem(
            ip,
            requestCount,
            score,
            reasons.Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
            topUrlValue,
            topUrlCount,
            refererMissingRatio,
            errorCount,
            suspiciousQueryCount,
            uaCounts.Count,
            isBot,
            recommendedAction,
            urlCounts.Take(5).Select(x => new CountItem(x.Url, x.Count)).ToList(),
            uaCounts.Take(5).Select(x => new CountItem(x.UserAgent, x.Count)).ToList())
        {
            RefererMissingRatio = refererMissingRatio,
            Http200Count = http200Count,
            Top200Url = top200UrlValue,
            Top200UrlCount = top200UrlCount,
            DominantUrl = topUrlValue,
            BoardAccessCount = board200Count,
            NoReferer200Count = http200RefererMissingCount,
            DominantUrlRatio = dominantUrlRatio,
            AdminProbeCount = adminProbeCount,
            BackupProbeCount = backupProbeCount,
            ConfigProbeCount = configProbeCount,
            ScriptProbeCount = scriptProbeCount,
            SensitiveProbeCount = sensitiveProbeCount
        };
    }

    private static List<IpRepeatItem> BuildIpRepeats(List<ParsedLogRow> rows, Func<ParsedLogRow, string> selector, int take)
    {
        return rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Ip))
            .GroupBy(x => x.Ip.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var values = g
                    .Select(selector)
                    .Where(value => !string.IsNullOrWhiteSpace(value))
                    .Select(value => value.Trim())
                    .GroupBy(value => value, StringComparer.OrdinalIgnoreCase)
                    .Select(valueGroup => new CountItem(valueGroup.Key, valueGroup.Count()))
                    .OrderByDescending(x => x.Count)
                    .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
                    .Take(5)
                    .ToList();

                return new IpRepeatItem(g.Key, values);
            })
            .Where(x => x.Repeats.Count > 0)
            .OrderByDescending(x => x.TotalCount)
            .ThenBy(x => x.Ip, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();
    }

    private static List<IpUrlStatusRepeatItem> BuildIpUrlStatusRepeats(List<ParsedLogRow> rows, int take)
    {
        return rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Ip))
            .GroupBy(x => x.Ip.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var repeats = g
                    .Where(x => !string.IsNullOrWhiteSpace(x.Uri) || !string.IsNullOrWhiteSpace(x.Status))
                    .GroupBy(x => new
                    {
                        Uri = (x.Uri ?? string.Empty).Trim(),
                        Status = (x.Status ?? string.Empty).Trim()
                    })
                    .Select(pair => new CountItem($"{pair.Key.Uri} | {pair.Key.Status}", pair.Count()))
                    .OrderByDescending(x => x.Count)
                    .ThenBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
                    .Take(5)
                    .ToList();

                return new IpUrlStatusRepeatItem(g.Key, repeats);
            })
            .Where(x => x.Repeats.Count > 0)
            .OrderByDescending(x => x.TotalCount)
            .ThenBy(x => x.Ip, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();
    }

