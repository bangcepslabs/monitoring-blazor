    private async Task ApplyWorkspaceFiltersAsync()
    {
        CancelPendingWorkspaceFilterSearch();
        ResetPage();
        await RefreshWorkspacePageAsync();
    }

    private void QueueWorkspaceFilterSearch()
    {
        if (!IsWorkspaceMode || IsPreviewing || IsSaving) return;

        CancelPendingWorkspaceFilterSearch();
        var debounceCts = new CancellationTokenSource();
        _workspaceFilterDebounceCts = debounceCts;
        _ = ApplyWorkspaceFiltersAfterDebounceAsync(debounceCts);
    }

    private async Task ApplyWorkspaceFiltersAfterDebounceAsync(CancellationTokenSource debounceCts)
    {
        try
        {
            await Task.Delay(WorkspaceFilterDebounceMilliseconds, debounceCts.Token);
            while (IsLoadingWorkspacePage)
            {
                await Task.Delay(50, debounceCts.Token);
            }

            if (debounceCts.IsCancellationRequested || !ReferenceEquals(_workspaceFilterDebounceCts, debounceCts) || !IsWorkspaceMode) return;
            ResetPage();
            await RefreshWorkspacePageAsync();
        }
        catch (OperationCanceledException)
        {
            // A more recent edit replaced this pending search.
        }
        finally
        {
            if (ReferenceEquals(_workspaceFilterDebounceCts, debounceCts)) _workspaceFilterDebounceCts = null;
            debounceCts.Dispose();
        }
    }

    private void CancelPendingWorkspaceFilterSearch()
    {
        var pending = _workspaceFilterDebounceCts;
        _workspaceFilterDebounceCts = null;
        if (pending is null) return;
        pending.Cancel();
        pending.Dispose();
    }

    private async Task RefreshWorkspacePageAsync()
    {
        if (!IsWorkspaceMode || IsLoadingWorkspacePage) return;

        IsLoadingWorkspacePage = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var criteria = BuildFilterCriteria();
            var workspaceData = await QueryWorkspacePageAsync(WorkspaceId!, criteria, Sorts, CurrentPage, PageSize, CancellationToken.None);
            AppliedWorkspaceCriteria = criteria;
            WorkspaceSummary = workspaceData.Summary;
            WorkspaceFilteredCount = WorkspaceSummary.TotalRows;
            var totalPages = GetTotalPages((int)Math.Min(WorkspaceFilteredCount, int.MaxValue));
            CurrentPage = Math.Clamp(CurrentPage, 1, totalPages);
            if (CurrentPage != workspaceData.Page)
            {
                workspaceData = await QueryWorkspacePageAsync(WorkspaceId!, criteria, Sorts, CurrentPage, PageSize, CancellationToken.None);
            }
            WorkspacePageRows = workspaceData.Rows;
        }
        catch (Exception exception)
        {
            UploadMessage = $"Could not query the full log workspace: {exception.Message}";
        }
        finally
        {
            IsLoadingWorkspacePage = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadWorkspacePageOnlyAsync()
    {
        if (!IsWorkspaceMode || IsLoadingWorkspacePage) return;

        CurrentPage = Math.Clamp(
            CurrentPage,
            1,
            GetTotalPages((int)Math.Min(WorkspaceFilteredCount, int.MaxValue)));
        IsLoadingWorkspacePage = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var stableSorts = Sorts.Select(sort => new LogRowSort(sort.Column, sort.Ascending)).ToList();
            WorkspacePageRows = await Task.Run(
                () => LogWorkspaceStore.GetPageAsync(
                    WorkspaceId!,
                    AppliedWorkspaceCriteria,
                    stableSorts,
                    CurrentPage,
                    PageSize,
                    CancellationToken.None));
        }
        catch (Exception exception)
        {
            UploadMessage = $"Could not load the workspace page: {exception.Message}";
        }
        finally
        {
            IsLoadingWorkspacePage = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task<(IisLogWorkspaceSummary Summary, List<ParsedLogRow> Rows, int Page)> QueryWorkspacePageAsync(
        string workspaceId,
        IisLogFilterCriteria criteria,
        IReadOnlyList<LogRowSort> sorts,
        int page,
        int pageSize,
        CancellationToken cancellationToken)
    {
        var stableSorts = sorts.Select(sort => new LogRowSort(sort.Column, sort.Ascending)).ToList();
        var requestedPage = Math.Max(1, page);
        return Task.Run(async () =>
        {
            var summary = await LogWorkspaceStore.GetSummaryAsync(workspaceId, criteria, cancellationToken);
            var rows = await LogWorkspaceStore.GetPageAsync(workspaceId, criteria, stableSorts, requestedPage, pageSize, cancellationToken);
            return (summary, rows, requestedPage);
        }, cancellationToken);
    }

    private void ResetPage() => CurrentPage = 1;

