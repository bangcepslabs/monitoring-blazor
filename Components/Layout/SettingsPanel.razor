    private void ShowBasicTab() => ActiveSettingsTab = "basic";
    private void ShowCollectionTab() => ActiveSettingsTab = "collection";
    private void ShowAnalysisTab() => ActiveSettingsTab = "analysis";
    private void ShowIntegrationsTab() => ActiveSettingsTab = "integrations";

    private async Task CheckOllamaConnectionAsync()
    {
        if (IsCheckingOllama) return;
        IsCheckingOllama = true;
        StatusMessage = null;
        try
        {
            var status = await ReadJsonAsync<OllamaClient.ConnectionStatus>("api/runtime/ollama/status");
            StatusMessage = status is null
                ? Language.T("Ollama 상태 응답을 받지 못했습니다.", "No Ollama status response was received.")
                : GetOllamaStatusMessage(status);
        }
        catch (Exception ex)
        {
            StatusMessage = Language.IsKorean
                ? $"Ollama 연결 상태를 확인하지 못했습니다. 앱 설정과 서버 로그를 확인하세요. ({ex.Message})"
                : $"Could not check the Ollama connection. Review the app settings and server logs. ({ex.Message})";
        }
        finally
        {
            IsCheckingOllama = false;
        }
    }

    private string GetOllamaStatusMessage(OllamaClient.ConnectionStatus status)
    {
        if (!status.Enabled)
        {
            return Language.T("앱 설정에서 Ollama가 비활성화되어 있습니다. AI 분석 설정을 켜고 저장한 뒤 다시 확인하세요.", "Ollama is disabled in the app settings. Enable AI analysis, save, and check again.");
        }

        if (!status.Reachable)
        {
            return Language.T("Ollama 서버에 연결하지 못했습니다. 설정된 주소와 서버 실행 상태를 확인하세요.", "Could not reach Ollama. Check the configured URL and make sure the server is running.");
        }

        if (!status.ModelAvailable)
        {
            return Language.T($"Ollama에는 연결됐지만 '{status.Model}' 모델이 설치되어 있지 않습니다.", $"Ollama is reachable, but model '{status.Model}' is not installed.");
        }

        return Language.T($"Ollama 연결과 '{status.Model}' 모델을 확인했습니다.", $"Ollama is reachable and model '{status.Model}' is available.");
    }

    private string TabButtonClass(string tabKey)
        => ActiveSettingsTab == tabKey ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";

    private TimeOnly? MaintenanceWindowStartValue
    {
        get => TryParseTimeOnly(AlertSettings.MaintenanceWindowStart, out var value) ? value : null;
        set => AlertSettings.MaintenanceWindowStart = value?.ToString("HH:mm") ?? string.Empty;
    }

    private TimeOnly? MaintenanceWindowEndValue
    {
        get => TryParseTimeOnly(AlertSettings.MaintenanceWindowEnd, out var value) ? value : null;
        set => AlertSettings.MaintenanceWindowEnd = value?.ToString("HH:mm") ?? string.Empty;
    }

    public async Task OpenAsync()
    {
        NavigationManager.NavigateTo("/settings");
    }

    public Task CloseAsync()
    {
        NavigationManager.NavigateTo("/");
        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        SettingsLoaded = false;
        try
        {
            StatusMessage = null;
            var settings = await ReadJsonAsync<AlertSettings>("api/alerts/settings");
            if (settings is not null)
            {
                AlertSettings = settings;
            }

            var securitySettings = await ReadJsonAsync<SecuritySettings>("api/security/settings");
            if (securitySettings is not null)
            {
                SecuritySettings = securitySettings;
            }

            var ollamaResponse = await ReadJsonAsync<OllamaRuntimeSettings>("api/runtime/ollama");
            if (ollamaResponse is not null)
            {
                OllamaSettings = ollamaResponse;
            }

            var logExportResponse = await ReadJsonAsync<LogExportRuntimeSettings>("api/runtime/log-export");
            if (logExportResponse is not null)
            {
                LogExportSettings = logExportResponse;
            }

            var logImportResponse = await ReadJsonAsync<LogImportRuntimeSettings>("api/runtime/log-import");
            if (logImportResponse is not null)
            {
                LogImportSettings = logImportResponse;
            }

            var logAnalysisResponse = await ReadJsonAsync<LogAnalysisRuntimeSettings>("api/runtime/log-analysis-rules");
            if (logAnalysisResponse is not null)
            {
                LogAnalysisSettings = logAnalysisResponse;
            }

            var emailResponse = await ReadJsonAsync<EmailSettings>("api/email/settings");
            if (emailResponse is not null)
            {
                EmailSettings = emailResponse;
            }

            var notificationResponse = await ReadJsonAsync<NotificationSettings>("api/notification/settings");
            if (notificationResponse is not null)
            {
                NotificationSettings = notificationResponse;
            }
            SettingsLoaded = true;
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        if (IsSaving || !SettingsLoaded)
        {
            return;
        }

        IsSaving = true;
        StatusMessage = null;
        try
        {
            await SaveJsonAsync("api/alerts/settings", AlertSettings);

            await SaveJsonAsync("api/security/settings", SecuritySettings);

            await SaveJsonAsync("api/email/settings", EmailSettings);

            await SaveJsonAsync("api/notification/settings", NotificationSettings);

            await SaveJsonAsync("api/runtime/ollama", OllamaSettings);

            await SaveJsonAsync("api/runtime/log-export", LogExportSettings);

            await SaveJsonAsync("api/runtime/log-import", LogImportSettings);

            await SaveJsonAsync("api/runtime/log-analysis-rules", LogAnalysisSettings);

            StatusMessage = Language.T("설정을 저장했습니다.", "Settings saved.");
            await JS.InvokeVoidAsync("monitorSettings.showToast", StatusMessage, "success");
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
            await JS.InvokeVoidAsync("monitorSettings.showToast", Language.T("설정 저장에 실패했습니다.", "Settings could not be saved."), "danger");
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateBackupAsync()
    {
        try
        {
            var backup = await ReadJsonAsync<JsonElement>("api/settings/backup");
            _backupJson = backup.GetRawText();
            StatusMessage = Language.T("백업 JSON을 생성했습니다.", "Backup JSON generated.");
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadLatestIisReportAsync()
    {
        try
        {
            var latest = await ReadJsonAsync<OllamaAnalysisEntry>("api/ollama/latest");
            _iisReportSummary = latest?.Response ?? string.Empty;
            _iisReportRawJson = latest is null
                ? string.Empty
                : JsonSerializer.Serialize(latest, new JsonSerializerOptions { WriteIndented = true });
            ShowIisReportJson = false;
            StatusMessage = latest is null
                ? Language.T("저장된 IIS 분석 결과가 없습니다.", "No IIS analysis found.")
                : Language.T("최근 IIS 분석 결과를 불러왔습니다.", "Latest IIS analysis loaded.");
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadIisReportAsync()
    {
        if (string.IsNullOrWhiteSpace(_iisReportRawJson))
        {
            StatusMessage = Language.T("내려받을 IIS 보고서가 없습니다.", "No IIS report is available to download.");
            await InvokeAsync(StateHasChanged);
            return;
        }

        var fileName = $"iis-report-{DateTime.Now:yyyyMMdd-HHmmss}.json";
        await JS.InvokeVoidAsync("monitorSettings.downloadText", fileName, _iisReportRawJson, "application/json");
        StatusMessage = Language.T($"다운로드를 시작했습니다: {fileName}", $"Download started: {fileName}.");
        await InvokeAsync(StateHasChanged);
    }

    private Task ToggleIisReportJsonView()
    {
        ShowIisReportJson = !ShowIisReportJson;
        return InvokeAsync(StateHasChanged);
    }

    private async Task RunLogExportNowAsync()
    {
        try
        {
            await SaveJsonAsync("api/log-export/run", new { });
            StatusMessage = Language.T("로그 내보내기를 완료했습니다.", "Log export completed.");
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadBackupAsync()
    {
        if (string.IsNullOrWhiteSpace(_backupJson))
        {
            StatusMessage = Language.T("백업 JSON을 먼저 생성하거나 파일을 선택하세요.", "Generate backup JSON or choose a file first.");
            await InvokeAsync(StateHasChanged);
            return;
        }

        var fileName = $"settings-backup-{DateTime.Now:yyyyMMdd-HHmmss}.json";
        await JS.InvokeVoidAsync("monitorSettings.downloadText", fileName, _backupJson, "application/json");
        StatusMessage = Language.T($"다운로드를 시작했습니다: {fileName}", $"Download started: {fileName}.");
        await InvokeAsync(StateHasChanged);
    }

    private async Task RestoreBackupAsync()
    {
        if (string.IsNullOrWhiteSpace(_backupJson))
        {
            StatusMessage = Language.T("백업 JSON을 먼저 생성하거나 파일을 선택하세요.", "Generate backup JSON or choose a file first.");
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var payload = JsonSerializer.Deserialize<SettingsBackupPayload>(_backupJson);
            if (payload is null)
            {
                throw new InvalidOperationException(Language.T("올바른 백업 JSON이 아닙니다.", "Invalid backup JSON."));
            }

            await SaveJsonAsync("api/settings/restore", payload);
            await LoadAsync();
            StatusMessage = Language.T("백업을 복원했습니다.", "Backup restored.");
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadBackupFileAsync(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;
            if (file is null)
            {
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            _backupJson = await reader.ReadToEndAsync();
            StatusMessage = Language.T($"백업 파일을 불러왔습니다: {file.Name}", $"Loaded backup file: {file.Name}.");
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task ClearBackupAsync()
    {
        _backupJson = string.Empty;
        StatusMessage = Language.T("백업 JSON 입력을 비웠습니다.", "Backup JSON cleared.");
        return InvokeAsync(StateHasChanged);
    }

    private async Task SaveJsonAsync<T>(string endpoint, T payload)
    {
        var response = await JS.InvokeAsync<BrowserApiResponse>("monitorSettings.postJson", endpoint, payload);
        if (!response.Ok)
        {
            var detail = string.IsNullOrWhiteSpace(response.Body) ? "no response body" : response.Body.Trim();
            throw new InvalidOperationException($"{endpoint} failed ({response.Status}): {detail}");
        }
    }

    private sealed record BrowserApiResponse(bool Ok, int Status, string? Body);

    private async Task<T?> ReadJsonAsync<T>(string endpoint)
    {
        var response = await JS.InvokeAsync<BrowserApiResponse>("monitorSettings.getJson", endpoint);
        if (!response.Ok)
            throw new InvalidOperationException(Language.T($"조회에 실패했습니다. (HTTP {response.Status})", $"Could not load data. (HTTP {response.Status})"));
        return string.IsNullOrWhiteSpace(response.Body) ? default : JsonSerializer.Deserialize<T>(response.Body, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    }

    private static bool TryParseTimeOnly(string? value, out TimeOnly time)
    {
        if (TimeOnly.TryParse(value, out time))
        {
            return true;
        }

        time = default;
        return false;
    }

    private static List<string> SplitLines(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        return value
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
