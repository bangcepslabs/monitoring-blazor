<label class="file-picker">
    <i class="bi bi-upload" aria-hidden="true"></i>
    <span>@Language.T("파일 선택", Multiple ? "Choose files" : "Choose a file")</span>
    <InputFile OnChange="OnChange" multiple="@Multiple" disabled="@Disabled" accept="@Accept"
               class="file-picker-input" aria-label="@Language.T("업로드할 파일 선택", "Choose files to upload")" />
</label>

@code {
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Accept { get; set; }
}
