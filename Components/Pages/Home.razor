        var culture = CultureInfo.GetCultureInfo("ko-KR");
        return $"{startLocal.Value.ToString("yyyy. MM. dd. tt h:mm:ss", culture)} - {endLocal.Value.ToString("yyyy. MM. dd. tt h:mm:ss", culture)}";
    }

