        _ => Language.T("설정", "Settings")
    };

    private string TabSummaryText => ActiveSettingsTab switch
    {
        "basic" => Language.T("서버 상태 알림과 계정 보안을 설정합니다.", "Server health alerts and account security."),
        "collection" => Language.T("IIS 로그를 수집하고 내보낼 위치와 실행 시간을 설정합니다.", "Where IIS logs are picked up, exported, and imported."),
