    private async Task RunAnalyze()
    {
        if (IsAnalyzing)
        {
            return;
        }

        if (!UseOllama)
        {
            AnalyzeMessage = "Ollama is disabled. Set Ollama to Y to enable AI analysis.";
            LastAnalysisUsedFallback = false;
            LastAnalysisSourceLabel = "disabled";
            return;
        }

        IsAnalyzing = true;
        AnalyzeMessage = "AI 분석을 실행 중입니다. 완료되면 결과가 한 번에 표시됩니다.";
        LastAnalysisUsedFallback = false;
        LastAnalysisSourceLabel = "running";
        _analysisCts?.Dispose();
        _analysisCts = new CancellationTokenSource();
        var ct = _analysisCts.Token;
        try
        {
            ApplyRuntimeAnalysisSettings(LogAnalysisSettings);
            var filtered = GetFilteredRows();
            var question = AiQuestion.Trim();
            var analysisPayload = BuildAnalysisPayload(filtered, question);
            var analysisJson = BuildAnalysisJson(analysisPayload, question);
            var status5xxCount = filtered.Count(x => x.Status.StartsWith("5", StringComparison.Ordinal));
            var ratio = filtered.Count == 0 ? 0 : status5xxCount / (double)filtered.Count;
            var logDate = GetLogDate(filtered);
            var systemPrompt = string.IsNullOrWhiteSpace(LogAnalysisSettings.AnalysisSystemPrompt)
                ? LogAnalysisPromptDefaults.SystemPrompt
                : LogAnalysisSettings.AnalysisSystemPrompt.Trim();
            var effectiveSystemPrompt = string.IsNullOrWhiteSpace(question)
                ? systemPrompt
                : systemPrompt +
                  " " +
                  (string.IsNullOrWhiteSpace(LogAnalysisSettings.QuestionInstructions)
                      ? LogAnalysisPromptDefaults.QuestionInstructions
                      : LogAnalysisSettings.QuestionInstructions.Trim());
            _http ??= CreateAnalysisClient();
            var requestPayload = new
            {
                prompt = analysisJson,
                systemPrompt = effectiveSystemPrompt,
                source = "manual-aggregated",
                logDate,
                totalRows = filtered.Count,
                status5xxCount,
                status5xxRatio = ratio,
                userQuestion = string.IsNullOrWhiteSpace(question) ? null : question
            };

            using var response = await _http.PostAsJsonAsync("api/ollama/analyze", requestPayload, ct);

            if (!response.IsSuccessStatusCode)
            {
                var errorText = await response.Content.ReadAsStringAsync(ct);
                AnalyzeMessage = string.IsNullOrWhiteSpace(errorText)
                    ? $"AI 분석 실패: HTTP {(int)response.StatusCode}"
                    : $"AI 분석 실패: {errorText}";
                LastAnalysisSourceLabel = "http-error";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<OllamaAnalyzeResponse>(cancellationToken: ct);
            var analysisText = result?.Response;
            // Retry only when the model returned an actually trivial answer or
            // failed to address an explicit question. A malformed/English answer
            // is handled by the local Korean card fallback below, avoiding a
            // second slow Ollama call.
            // A retry can nearly double the wait time. For an additional question we can
            // reliably add a data-backed answer locally below, so reserve retries for a
            // genuinely unusable base report only.
            if (string.IsNullOrWhiteSpace(question) && LooksTrivialAnalysis(analysisText))
            {
                var retrySystemPrompt =
                    effectiveSystemPrompt +
                    " 이전 응답이 너무 짧았다. 확인만 하지 말고 반드시 보안 분석 결과를 작성하라. " +
                    "공격 URL, 의심 IP, 차단 후보를 각각 최소 2개 이상 포함하라. " +
                    "모르면 모른다고 쓰지 말고 JSON에 있는 항목만 근거로 판단하라. " +
                    (string.IsNullOrWhiteSpace(question) ? string.Empty : "사용자 질문에 직접 답하는 [추가 질문 답변] 섹션을 반드시 포함하라.");

                using var retryResponse = await _http.PostAsJsonAsync("api/ollama/analyze", new
                {
                    prompt = analysisJson,
                    systemPrompt = retrySystemPrompt,
                    source = "manual-aggregated-retry",
                    logDate,
                    totalRows = filtered.Count,
                    status5xxCount,
                    status5xxRatio = ratio,
                    userQuestion = string.IsNullOrWhiteSpace(question) ? null : question
                }, ct);

                if (retryResponse.IsSuccessStatusCode)
                {
                    var retryResult = await retryResponse.Content.ReadFromJsonAsync<OllamaAnalyzeResponse>(cancellationToken: ct);
                    analysisText = retryResult?.Response;
                }
            }

            var finalText = analysisText ?? "AI 분석이 완료되었지만 응답이 비어 있습니다.";
            var hasQuestion = !string.IsNullOrWhiteSpace(question);
            var hasQuestionSection = finalText.Contains("[추가 질문 답변]", StringComparison.Ordinal);
            var questionReport = hasQuestion && !hasQuestionSection
                ? BuildQuestionSpecificAnalysis(filtered, analysisPayload, question)
                : string.Empty;
            var isTrivialAnalysis = NeedsStructuredAnalysisFallback(finalText);

            if (isTrivialAnalysis)
            {
                if (hasQuestion)
                {
                    // An additional question must never replace the base report.
                    // Keep the normal Korean card report and append the question result.
                    AnalyzeMessage = string.IsNullOrWhiteSpace(questionReport)
                        ? BuildFallbackAnalysisReport(analysisPayload, question)
                        : string.Concat(
                            BuildFallbackAnalysisReport(analysisPayload, null),
                            Environment.NewLine,
                            Environment.NewLine,
                            questionReport);
                }
                else
                {
                    AnalyzeMessage = BuildFallbackAnalysisReport(analysisPayload, null);
                }
                LastAnalysisUsedFallback = true;
            }
            else
            {
                // Preserve the AI's section cards. If it omitted the requested question
                // section, append the same deterministic, log-backed card instead of
                // issuing a second complete model request.
                AnalyzeMessage = string.IsNullOrWhiteSpace(questionReport)
                    ? finalText
                    : string.Concat(finalText.Trim(), Environment.NewLine, Environment.NewLine, questionReport);
                LastAnalysisUsedFallback = false;
            }

            LastAnalysisSourceLabel = LastAnalysisUsedFallback ? "manual-fallback" : "ollama";
            await LoadRecentAnalysisHistoryAsync();
        }
        catch (TaskCanceledException)
        {
            IsAnalyzing = false;
            AnalyzeMessage = "AI 분석 요청이 시간 초과되었습니다. 로그 양이 많으면 시간이 오래 걸릴 수 있어요. 잠시 후 다시 시도해주세요.";
            LastAnalysisUsedFallback = false;
            LastAnalysisSourceLabel = "timeout";
        }
        catch (Exception ex)
        {
            AnalyzeMessage = ex.Message;
            LastAnalysisUsedFallback = false;
            LastAnalysisSourceLabel = "error";
        }
        finally
        {
            IsAnalyzing = false;
            _analysisCts?.Dispose();
            _analysisCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

