    private async Task<(List<T>? Data, string? Error)> FetchListAsync<T>(string url)
    {
        if (_http is null)
        {
            return (null, "HTTP client not ready.");
        }

        try
        {
            using var response = await _http.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                var message = string.IsNullOrWhiteSpace(body)
                    ? $"Request failed: {(int)response.StatusCode}"
                    : body;
                return (null, message);
            }

            var data = await response.Content.ReadFromJsonAsync<List<T>>();
            return (data ?? [], null);
        }
        catch (Exception ex)
        {
            return (null, ex.Message);
        }
    }

    private static bool IsWarning(MonitoringInfo info)
    {
        return info.Dynamic.CpuInfo.Usage >= 60 || info.Dynamic.MemoryInfo.Usage >= 75 || info.Dynamic.DiskInfo.Percent >= 85;
    }

    private static bool IsCritical(MonitoringInfo info)
    {
        return info.Dynamic.CpuInfo.Usage >= 85 || info.Dynamic.MemoryInfo.Usage >= 90 || info.Dynamic.DiskInfo.Percent >= 95;
    }

    private static string GetUsageClass(double value, double warningThreshold, double criticalThreshold)
    {
        if (value >= criticalThreshold)
        {
            return "bg-danger";
        }

        return value >= warningThreshold ? "bg-warning" : "bg-success";
    }

