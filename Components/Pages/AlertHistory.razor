@page "/alerts/history"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using Monitoring.Blazor.Models
@using Monitoring.Blazor.Services
@inject IDbContextFactory<MonitoringDbContext> DbFactory
@inject MonitorStateService MonitorState
@inject AlertSuppressor AlertSuppressor
@inject IJSRuntime JS

<PageTitle>OpsEye | @Language.T("알림 이력", "Alert History")</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <div class="text-uppercase text-muted small mb-1">@Language.T("운영", "Operations")</div>
            <h1 class="h3 mb-1">@Language.T("알림 이력", "Alert history")</h1>
            <p class="text-secondary mb-0">@Language.T("임계값, 측정값, 복구 상황을 포함한 상세 알림 이벤트입니다.", "Detailed alert events with thresholds, values, and recovery context.")</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="() => ReloadAsync()">@Language.T("새로고침", "Refresh")</button>
            <a class="btn btn-outline-primary" href="/">@Language.T("대시보드로 돌아가기", "Back to dashboard")</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("불러온 알림", "Alerts loaded")</div>
                    <div class="fs-4 fw-semibold">@TotalAlertCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("임계값", "Threshold")</div>
                    <div class="fs-4 fw-semibold">@ThresholdCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("복구", "Recovery")</div>
                    <div class="fs-4 fw-semibold">@RecoveryCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("이상 징후", "Anomaly")</div>
                    <div class="fs-4 fw-semibold">@AnomalyCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-12 col-md-3">
                    <input class="form-control" placeholder="@Language.T("호스트 / 지표 / 메시지 검색", "Search host / metric / message")" @bind="SearchText" @bind:event="oninput" />
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select" @bind="HostFilter">
                        <option value="">@Language.T("모든 호스트", "All hosts")</option>
                        @foreach (var host in Hosts)
                        {
                            <option value="@host">@host</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select" @bind="TypeFilter">
                        <option value="">@Language.T("모든 유형", "All types")</option>
                        <option value="@AlertType.Threshold.ToString()">@Language.T("임계값", "Threshold")</option>
                        <option value="@AlertType.Recovery.ToString()">@Language.T("복구", "Recovery")</option>
                        <option value="@AlertType.Anomaly.ToString()">@Language.T("이상 징후", "Anomaly")</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <input class="form-control" type="date" @bind="FromDate" />
                </div>
                <div class="col-6 col-md-2">
                    <input class="form-control" type="date" @bind="ToDate" />
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select" @bind="StatusFilter">
                        <option value="">All statuses</option>
                        <option value="open">Open</option>
                        <option value="acknowledged">Acknowledged</option>
                    </select>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters">@Language.T("초기화", "Clear")</button>
                    <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                        <span class="text-muted small">@Language.T("페이지당 행 수", "Rows per page")</span>
                        <select class="form-select form-select-sm w-auto" @bind="PageSize">
                            <option value="10">10</option>
                            <option value="30">30</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>@Language.T("시간", "Time")</th>
                            <th>@Language.T("호스트", "Host")</th>
                            <th>@Language.T("지표", "Metric")</th>
                            <th>@Language.T("유형", "Type")</th>
                            <th>@Language.T("값 / 임계값", "Value / Threshold")</th>
                            <th>@Language.T("비율", "Ratio")</th>
                            <th>@Language.T("메시지", "Message")</th>
                            <th>IP</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedAlerts.Any())
                        {
                            @foreach (var alert in PagedAlerts)
                            {
                                var ratio = alert.Threshold <= 0 ? 0 : alert.Value / alert.Threshold * 100d;
                                <tr>
                                    <td>@alert.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@alert.Hostname</td>
                                    <td><span class="badge text-bg-primary">@alert.Metric</span></td>
                                    <td><span class="badge @(GetAlertTypeBadge(alert.Type))">@alert.Type</span></td>
                                    <td>@alert.Value.ToString("0.0") / @alert.Threshold.ToString("0.0")</td>
                                    <td>@ratio.ToString("0.0")%</td>
                                    <td class="text-break">@alert.Message</td>
                                    <td>@alert.Ip</td>
                                    <td>
                                        @if (IsAcknowledged(alert))
                                        {
                                            <span class="badge text-bg-secondary">Acknowledged</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AcknowledgeAsync(alert)">Acknowledge</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-secondary py-4">@Language.T("알림 이벤트가 없습니다.", "No alert events found.")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                <div class="text-muted small">
                    @(Language.IsKorean ? $"{DisplayRangeStart}-{DisplayRangeEnd}개 중 {FilteredAlerts.Count}개 항목" : $"Showing {DisplayRangeStart}-{DisplayRangeEnd} of {FilteredAlerts.Count} item(s)")
                </div>
                <div class="btn-group" role="group" aria-label="Pagination">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousPage" disabled="@IsFirstPage">@Language.T("이전", "Previous")</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@IsLastPage">@Language.T("다음", "Next")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly List<AlertMessage> _alerts = [];
    private string _searchText = string.Empty;
    private string _hostFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int _pageSize = 30;
    private int _currentPage = 1;
    private int _totalAlertCount;
    private int _thresholdCount;
    private int _recoveryCount;
    private int _anomalyCount;
    private int TotalAlertCount => _totalAlertCount;
    private int ThresholdCount => _thresholdCount;
    private int RecoveryCount => _recoveryCount;
    private int AnomalyCount => _anomalyCount;
    private bool _preferencesLoaded;
    private const string SearchKey = "alertHistory.searchText";
    private const string HostKey = "alertHistory.hostFilter";
    private const string TypeKey = "alertHistory.typeFilter";
    private const string StatusKey = "alertHistory.statusFilter";
    private const string FromDateKey = "alertHistory.fromDate";
    private const string ToDateKey = "alertHistory.toDate";
    private const string PageSizeKey = "alertHistory.pageSize";

    private string SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _currentPage = 1;
            if (_preferencesLoaded)
            {
                _ = PersistPreferencesAsync();
                _ = ReloadAsync(false);
            }
        }
    }

    private string HostFilter
    {
        get => _hostFilter;
        set
        {
            _hostFilter = value;
            _currentPage = 1;
            if (_preferencesLoaded) { _ = PersistPreferencesAsync(); _ = ReloadAsync(false); }
        }
    }

    private string TypeFilter
    {
        get => _typeFilter;
        set
        {
            _typeFilter = value;
            _currentPage = 1;
            if (_preferencesLoaded) { _ = PersistPreferencesAsync(); _ = ReloadAsync(false); }
        }
    }

    private string StatusFilter
    {
        get => _statusFilter;
        set
        {
            _statusFilter = value;
            _currentPage = 1;
            if (_preferencesLoaded)
            {
                _ = PersistPreferencesAsync();
                _ = ReloadAsync(false);
            }
        }
    }

    private DateTime? FromDate
    {
        get => _fromDate;
        set
        {
            _fromDate = value;
            _currentPage = 1;
            if (_preferencesLoaded) { _ = PersistPreferencesAsync(); _ = ReloadAsync(false); }
        }
    }

    private DateTime? ToDate
    {
        get => _toDate;
        set
        {
            _toDate = value;
            _currentPage = 1;
            if (_preferencesLoaded) { _ = PersistPreferencesAsync(); _ = ReloadAsync(false); }
        }
    }

    private int PageSize
    {
        get => _pageSize;
        set
        {
            _pageSize = value is 10 or 30 or 50 or 100 ? value : 30;
            _currentPage = 1;
            if (_preferencesLoaded) { _ = PersistPreferencesAsync(); _ = ReloadAsync(false); }
        }
    }

    private IEnumerable<string> Hosts => _alerts.Select(x => x.Hostname).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);

    private List<AlertMessage> FilteredAlerts => _alerts;

    private List<AlertMessage> PagedAlerts => FilteredAlerts;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalAlertCount / (double)_pageSize));
    private bool IsFirstPage => _currentPage <= 1;
    private bool IsLastPage => _currentPage >= TotalPages;
    private int DisplayRangeStart => _totalAlertCount == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
    private int DisplayRangeEnd => Math.Min(_currentPage * _pageSize, _totalAlertCount);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadPreferencesAsync();
        _preferencesLoaded = true;
        await ReloadAsync(false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync(bool resetPage = true)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.AlertEvents.AsNoTracking().AsQueryable();
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(x => x.Hostname.Contains(_searchText) || x.Metric.Contains(_searchText) || x.Message.Contains(_searchText) || x.Ip.Contains(_searchText));
        }
        if (!string.IsNullOrWhiteSpace(_hostFilter)) query = query.Where(x => x.Hostname == _hostFilter);
        if (Enum.TryParse<AlertType>(_typeFilter, true, out var type)) query = query.Where(x => x.Type == type);
        if (_fromDate.HasValue) query = query.Where(x => x.TimestampUtc >= _fromDate.Value.Date.ToUniversalTime());
        if (_toDate.HasValue) query = query.Where(x => x.TimestampUtc < _toDate.Value.Date.AddDays(1).ToUniversalTime());

        var acknowledgedKeys = AlertSuppressor.List()
            .Where(x => x.UntilUtc > DateTime.UtcNow && string.Equals(x.Kind, "ack", StringComparison.OrdinalIgnoreCase))
            .Select(x => $"{x.Hostname}::{x.Metric}")
            .ToList();
        if (_statusFilter == "acknowledged" && acknowledgedKeys.Count > 0) query = query.Where(x => acknowledgedKeys.Contains(x.Hostname + "::" + x.Metric));
        if (_statusFilter == "acknowledged" && acknowledgedKeys.Count == 0) query = query.Where(_ => false);
        if (_statusFilter == "open" && acknowledgedKeys.Count > 0) query = query.Where(x => !acknowledgedKeys.Contains(x.Hostname + "::" + x.Metric));

        _totalAlertCount = await query.CountAsync();
        _thresholdCount = await query.CountAsync(x => x.Type == AlertType.Threshold);
        _recoveryCount = await query.CountAsync(x => x.Type == AlertType.Recovery);
        _anomalyCount = await query.CountAsync(x => x.Type == AlertType.Anomaly);
        if (resetPage) _currentPage = 1;
        _currentPage = Math.Min(_currentPage, TotalPages);
        _alerts.Clear();
        _alerts.AddRange(await db.AlertEvents
            .Where(x => query.Select(y => y.Id).Contains(x.Id))
            .OrderByDescending(x => x.TimestampUtc)
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .Select(x => new AlertMessage(x.Hostname, x.Ip, x.Os, x.Metric, x.Value, x.Threshold, x.Message, x.Type, x.TimestampUtc))
            .ToListAsync());
        await InvokeAsync(StateHasChanged);
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _hostFilter = string.Empty;
        _typeFilter = string.Empty;
        _statusFilter = string.Empty;
        _fromDate = null;
        _toDate = null;
        _currentPage = 1;
        if (_preferencesLoaded)
        {
            _ = PersistPreferencesAsync();
            _ = ReloadAsync(false);
        }
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            _ = ReloadAsync(false);
        }
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            _ = ReloadAsync(false);
        }
    }

    private async Task LoadPreferencesAsync()
    {
        _searchText = await JS.InvokeAsync<string>("monitorSettings.get", SearchKey, _searchText) ?? string.Empty;
        _hostFilter = await JS.InvokeAsync<string>("monitorSettings.get", HostKey, _hostFilter) ?? string.Empty;
        _typeFilter = await JS.InvokeAsync<string>("monitorSettings.get", TypeKey, _typeFilter) ?? string.Empty;
        _statusFilter = await JS.InvokeAsync<string>("monitorSettings.get", StatusKey, _statusFilter) ?? string.Empty;
        _fromDate = await LoadDateAsync(FromDateKey);
        _toDate = await LoadDateAsync(ToDateKey);
        _pageSize = await JS.InvokeAsync<int>("monitorSettings.get", PageSizeKey, _pageSize);
        _pageSize = _pageSize is 10 or 30 or 50 or 100 ? _pageSize : 30;
        _currentPage = 1;
    }

    private async Task PersistPreferencesAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("monitorSettings.set", SearchKey, _searchText);
            await JS.InvokeVoidAsync("monitorSettings.set", HostKey, _hostFilter);
            await JS.InvokeVoidAsync("monitorSettings.set", TypeKey, _typeFilter);
            await JS.InvokeVoidAsync("monitorSettings.set", StatusKey, _statusFilter);
            await JS.InvokeVoidAsync("monitorSettings.set", FromDateKey, _fromDate?.ToString("yyyy-MM-dd"));
            await JS.InvokeVoidAsync("monitorSettings.set", ToDateKey, _toDate?.ToString("yyyy-MM-dd"));
            await JS.InvokeVoidAsync("monitorSettings.set", PageSizeKey, _pageSize);
        }
        catch
        {
        }
    }

    private async Task<DateTime?> LoadDateAsync(string key)
    {
        var value = await JS.InvokeAsync<string>("monitorSettings.get", key, null);
        return DateTime.TryParse(value, out var parsed) ? parsed.Date : null;
    }

    private static string GetAlertTypeBadge(AlertType type) => type switch
    {
        AlertType.Recovery => "text-bg-success",
        AlertType.Anomaly => "text-bg-warning",
        _ => "text-bg-danger"
    };

    private bool IsAcknowledged(AlertMessage alert) =>
        AlertSuppressor.List().Any(x => string.Equals(x.Hostname, alert.Hostname, StringComparison.OrdinalIgnoreCase)
            && string.Equals(x.Metric, alert.Metric, StringComparison.OrdinalIgnoreCase)
            && x.UntilUtc > DateTime.UtcNow
            && string.Equals(x.Kind, "ack", StringComparison.OrdinalIgnoreCase));

    private async Task AcknowledgeAsync(AlertMessage alert)
    {
        await AlertSuppressor.SetPersistedAsync(
            alert.Hostname,
            alert.Metric,
            DateTime.UtcNow.AddHours(24),
            "Acknowledged from alert history",
            "ack");
        await InvokeAsync(StateHasChanged);
    }
}
