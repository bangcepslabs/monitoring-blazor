@page "/ip-analysis"
@attribute [Authorize]
@using System.Globalization
@using System.Net
@using System.IO.Compression
@using System.Text
@using Monitoring.Blazor.Models
@using Monitoring.Blazor.Services
@inject IpApiService IpService
@inject IJSRuntime JSRuntime

<PageTitle>@Language.T("IP 분석", "IP Analysis")</PageTitle>

<div class="page-header mb-4">
    <h3 class="mb-1">@Language.T("IP 분석", "IP Analysis")</h3>
    <div class="text-muted">IP 위치, ISP, ASN 정보를 확인하고 단일 또는 다중 조회 결과를 엑셀로 내려받을 수 있습니다.</div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-transparent">
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == IpAnalysisTab.Single ? "active" : string.Empty)" @onclick="() => SetTabAsync(IpAnalysisTab.Single)">
                    Single Lookup
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ActiveTab == IpAnalysisTab.Batch ? "active" : string.Empty)" @onclick="() => SetTabAsync(IpAnalysisTab.Batch)">
                    Batch Lookup
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body">
        @if (ActiveTab == IpAnalysisTab.Single)
        {
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label class="form-label">@Language.T("IP 조회", "Find IP")</label>
                    <input class="form-control"
                           @bind="IpInput"
                           @bind:event="oninput"
                           placeholder="예: 8.8.8.8" />
                </div>
                <div class="col-12 col-lg-3">
                    <button class="btn btn-primary w-100"
                            @onclick="AnalyzeIpAsync"
                            disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>@Language.T("분석 중...", "Analyzing...")</span>
                        }
                        else
                        {
                            <span>@Language.T("분석", "Analyze")</span>
                        }
                    </button>
                </div>
                <div class="col-12 col-lg-3">
                    <button class="btn btn-outline-secondary w-100" @onclick="ClearResultAsync" disabled="@IsLoading">
                        Clear
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">@Language.T("IP 일괄 조회", "Batch IPs")</label>
                    <textarea class="form-control batch-input"
                              rows="7"
                              @bind="BatchInput"
                              @bind:event="oninput"
                              placeholder="한 줄에 한 개씩 IP를 입력하세요. 최대 20개까지 조회됩니다."></textarea>
                    <div class="form-text mt-2">줄바꿈, 콤마, 공백으로 구분해도 됩니다. 중복은 자동 제거됩니다.</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(BatchWarningMessage))
                {
                    <div class="col-12">
                        <div class="alert alert-warning mb-0" role="alert">@BatchWarningMessage</div>
                    </div>
                }
                <div class="col-12 col-lg-4">
                    <button class="btn btn-primary w-100" @onclick="AnalyzeBatchAsync" disabled="@IsLoadingBatch">
                        @if (IsLoadingBatch)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>@Language.T("분석 중...", "Analyzing...")</span>
                        }
                        else
                        {
                            <span>@Language.T("일괄 분석", "Analyze Batch")</span>
                        }
                    </button>
                </div>
                <div class="col-12 col-lg-4">
                    <button class="btn btn-outline-primary w-100" @onclick="ExportBatchToExcelAsync" disabled="@(!BatchResults.Any() || IsLoadingBatch)">
                        Export Excel
                    </button>
                </div>
                <div class="col-12 col-lg-4">
                    <button class="btn btn-outline-secondary w-100" @onclick="ClearBatchResultAsync" disabled="@IsLoadingBatch">
                        Clear
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(BatchInfoMessage))
                {
                    <div class="col-12">
                        <div class="alert alert-info mb-0" role="alert">@BatchInfoMessage</div>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">
                @ErrorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(InfoMessage))
        {
            <div class="alert alert-info mt-3 mb-0" role="alert">
                @InfoMessage
            </div>
        }
    </div>
</div>

@if (ActiveTab == IpAnalysisTab.Single)
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("선택한 IP", "Selected IP")</div>
                    <div class="fs-5 fw-semibold">@DisplayIp</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("상태", "Status")</div>
                    <div class="fs-5 fw-semibold">@(ipResult?.Status ?? "-")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("위치", "Location")</div>
                    <div class="fs-5 fw-semibold">@LocationSummary</div>
                </div>
            </div>
        </div>
    </div>
}
else if (BatchResults.Count > 0)
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("요청 수", "Requested")</div>
                    <div class="fs-5 fw-semibold">@BatchRequestedCount</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("성공", "Succeeded")</div>
                    <div class="fs-5 fw-semibold">@BatchSuccessCount</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("실패", "Failed")</div>
                    <div class="fs-5 fw-semibold">@BatchFailureCount</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-5">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-transparent">
                <strong>@(ActiveTab == IpAnalysisTab.Single ? "IP Information" : "Batch Details")</strong>
            </div>
            <div class="card-body">
                @if (ActiveTab == IpAnalysisTab.Single)
                {
                    @if (ipResult is null)
                    {
                        <div class="text-muted">IP를 조회하면 상세 정보가 여기에 표시됩니다.</div>
                    }
                    else
                    {
                        <dl class="row mb-0 ip-analysis-dl">
                            <dt class="col-5">IP</dt><dd class="col-7">@ipResult.Ip</dd>
                            <dt class="col-5">@Language.T("국가", "Country")</dt><dd class="col-7">@DisplayOrDash(ipResult.Country)</dd>
                            <dt class="col-5">@Language.T("국가 코드", "Country Code")</dt><dd class="col-7">@DisplayOrDash(ipResult.CountryCode)</dd>
                            <dt class="col-5">@Language.T("지역", "Region")</dt><dd class="col-7">@DisplayRegion</dd>
                            <dt class="col-5">@Language.T("도시", "City")</dt><dd class="col-7">@DisplayOrDash(ipResult.City)</dd>
                            <dt class="col-5">우편번호</dt><dd class="col-7">@DisplayOrDash(ipResult.Zip)</dd>
                            <dt class="col-5">위도</dt><dd class="col-7">@FormatCoordinate(ipResult.Lat)</dd>
                            <dt class="col-5">경도</dt><dd class="col-7">@FormatCoordinate(ipResult.Lon)</dd>
                            <dt class="col-5">시간대</dt><dd class="col-7">@DisplayOrDash(ipResult.Timezone)</dd>
                            <dt class="col-5">ISP</dt><dd class="col-7">@DisplayOrDash(ipResult.Isp)</dd>
                            <dt class="col-5">조직</dt><dd class="col-7">@DisplayOrDash(ipResult.Org)</dd>
                            <dt class="col-5">AS</dt><dd class="col-7">@DisplayOrDash(ipResult.As)</dd>
                        </dl>
                    }
                }
                else
                {
                    @if (BatchResults.Count == 0)
                    {
                        <div class="text-muted">다중 조회를 실행하면 결과 요약과 상세 목록이 여기에 표시됩니다.</div>
                    }
                    else
                    {
                        <dl class="row mb-0 ip-analysis-dl">
                            <dt class="col-5">Requested</dt><dd class="col-7">@BatchRequestedCount</dd>
                            <dt class="col-5">Succeeded</dt><dd class="col-7">@BatchSuccessCount</dd>
                            <dt class="col-5">Failed</dt><dd class="col-7">@BatchFailureCount</dd>
                            <dt class="col-5">Limit</dt><dd class="col-7">20 IPs</dd>
                        </dl>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                <strong>@(ActiveTab == IpAnalysisTab.Single ? "Map" : "Batch Result")</strong>
                <span class="text-muted small">@MapStatusText</span>
            </div>
            <div class="card-body p-0">
                @if (ActiveTab == IpAnalysisTab.Single)
                {
                    <div id="map" class="ip-map"></div>
                }
                else
                {
                    <div class="table-responsive batch-result-table">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                            <tr>
                                <th>IP</th>
                                <th>Status</th>
                                <th>Country</th>
                                <th>City</th>
                                <th>ISP</th>
                                <th>AS</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in BatchResults)
                            {
                                <tr>
                                    <td>@item.Ip</td>
                                    <td>@item.Status</td>
                                    <td>@DisplayOrDash(item.Country)</td>
                                    <td>@DisplayOrDash(item.City)</td>
                                    <td class="text-truncate" style="max-width: 220px;" title="@item.Isp">@DisplayOrDash(item.Isp)</td>
                                    <td class="text-truncate" style="max-width: 220px;" title="@item.As">@DisplayOrDash(item.As)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (ActiveTab == IpAnalysisTab.Single && ipResult is not null)
{
    <div class="card shadow-sm">
        <div class="card-header bg-transparent">
            <strong>@Language.T("분석 요약", "Analysis Snapshot")</strong>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="analysis-pill">
                        <div class="text-muted small">@Language.T("요약", "Summary")</div>
                        <div class="fw-semibold">@LocationSummary</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="analysis-pill">
                        <div class="text-muted small">@Language.T("네트워크", "Network")</div>
                        <div class="fw-semibold">@DisplayOrDash(ipResult.Isp)</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="analysis-pill">
                        <div class="text-muted small">ASN</div>
                        <div class="fw-semibold">@DisplayOrDash(ipResult.As)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ActiveTab == IpAnalysisTab.Batch && BatchResults.Count > 0)
{
    <div class="card shadow-sm mt-3">
        <div class="card-header bg-transparent">
            <strong>@Language.T("일괄 내보내기 미리보기", "Batch Export Preview")</strong>
        </div>
        <div class="card-body">
            <div class="text-muted mb-2">엑셀로 내려받을 때 동일한 컬럼으로 저장됩니다.</div>
            <div class="small text-muted">총 @BatchResults.Count 개의 결과가 준비되었습니다.</div>
        </div>
    </div>
}

@code {
    private enum IpAnalysisTab
    {
        Single,
        Batch
    }

    private IpApiResult? ipResult;
    private string IpInput { get; set; } = string.Empty;
    private string BatchInput { get; set; } = string.Empty;
    private bool IsLoading { get; set; }
    private bool IsLoadingBatch { get; set; }
    private string? ErrorMessage { get; set; }
    private string? InfoMessage { get; set; }
    private string? BatchInfoMessage { get; set; }
    private string? BatchWarningMessage { get; set; }
    private List<IpApiResult> BatchResults { get; set; } = [];
    private IpAnalysisTab ActiveTab { get; set; } = IpAnalysisTab.Single;
    private DateTimeOffset? _lastBatchAnalyzeUtc;
    private bool _mapInitializationPending;

    private string DisplayIp => ipResult?.Ip ?? "-";
    private string LocationSummary
        => ipResult is null
            ? "-"
            : JoinOrDash(", ", ipResult.Country, ipResult.RegionName, ipResult.City);

    private string DisplayRegion
        => JoinOrDash(" / ", ipResult?.Region, ipResult?.RegionName);

    private string MapStatusText
        => ActiveTab == IpAnalysisTab.Single
            ? (ipResult is null
                ? "No location loaded"
                : HasValidCoordinates(ipResult)
                    ? "Location pinned"
                    : "Coordinates unavailable")
            : BatchResults.Count == 0
                ? "No batch results"
                : $"{BatchResults.Count} results ready";

    private int BatchRequestedCount => GetBatchInputs().Count;
    private int BatchSuccessCount => BatchResults.Count(IsSuccess);
    private int BatchFailureCount => BatchResults.Count(x => !IsSuccess(x));

    private static string DisplayOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string JoinOrDash(string separator, params string?[] values)
    {
        var text = string.Join(separator, values.Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(text) ? "-" : text;
    }

    private static string FormatCoordinate(double value)
        => Math.Abs(value) < 0.000001 ? "-" : value.ToString("0.000000");

    private async Task AnalyzeIpAsync()
    {
        ErrorMessage = null;
        InfoMessage = null;

        var input = IpInput.Trim();
        if (!TryValidateIp(input, out var validationError))
        {
            ErrorMessage = validationError;
            ipResult = null;
            return;
        }

        IsLoading = true;
        try
        {
            var result = await IpService.GetIpInfoAsync(input);
            ipResult = result;

            if (IsSuccess(result))
            {
                if (HasValidCoordinates(result))
                {
                    // The map is initialized after the result is rendered, so the target element
                    // is guaranteed to exist even when the user has just changed tabs.
                    _mapInitializationPending = true;
                }
                else
                {
                    InfoMessage = "위치 정보는 조회되었지만 좌표가 없어 지도를 표시할 수 없습니다.";
                }
            }
            else
            {
                ErrorMessage = "IP 정보를 가져오지 못했습니다. 다시 시도해 주세요.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"IP 분석 중 오류가 발생했습니다: {ex.Message}";
            ipResult = null;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ClearResultAsync()
    {
        ipResult = null;
        _mapInitializationPending = false;
        ErrorMessage = null;
        InfoMessage = null;
        IpInput = string.Empty;
        await Task.CompletedTask;
    }

    private Task SetTabAsync(IpAnalysisTab tab)
    {
        ActiveTab = tab;
        ErrorMessage = null;
        InfoMessage = null;

        if (tab == IpAnalysisTab.Single && ipResult is not null && HasValidCoordinates(ipResult))
        {
            // The #map element is conditionally rendered. Deferring this until
            // OnAfterRenderAsync prevents Leaflet from receiving a missing element.
            _mapInitializationPending = true;
        }
        else if (tab == IpAnalysisTab.Batch)
        {
            _mapInitializationPending = false;
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mapInitializationPending || ActiveTab != IpAnalysisTab.Single || ipResult is null || !HasValidCoordinates(ipResult))
        {
            return;
        }

        _mapInitializationPending = false;
        await JSRuntime.InvokeVoidAsync("setupMap", "map", ipResult.Lat, ipResult.Lon);
    }

    private async Task AnalyzeBatchAsync()
    {
        ErrorMessage = null;
        BatchInfoMessage = null;
        BatchWarningMessage = null;

        var now = DateTimeOffset.UtcNow;
        if (_lastBatchAnalyzeUtc is not null && now - _lastBatchAnalyzeUtc.Value < TimeSpan.FromSeconds(10))
        {
            BatchWarningMessage = "다중 조회는 너무 빠르게 반복할 수 없도록 10초 쿨다운이 적용됩니다. 잠시 후 다시 시도해 주세요.";
            return;
        }

        var parseResult = ParseBatchInputs();
        var ips = parseResult.Inputs;
        if (HasLooseBatchSeparators(BatchInput))
        {
            BatchWarningMessage = "권장 형식은 한 줄에 IP 하나씩입니다. 현재 입력은 구분자를 자동 해석했습니다.";
        }

        if (parseResult.InvalidCount > 0)
        {
            BatchWarningMessage = $"유효하지 않은 항목 {parseResult.InvalidCount}개를 제외했습니다. IP는 한 줄에 하나씩 넣는 것이 가장 안전합니다.";
        }

        if (parseResult.DuplicateCount > 0)
        {
            BatchWarningMessage = AppendWarning(BatchWarningMessage, $"중복 IP {parseResult.DuplicateCount}개를 자동으로 제거했습니다.");
        }

        if (parseResult.Truncated)
        {
            BatchWarningMessage = AppendWarning(BatchWarningMessage, $"입력된 IP가 {parseResult.OriginalCount}개라서 처음 20개만 조회합니다.");
        }

        if (ips.Count == 0)
        {
            BatchResults = [];
            BatchInfoMessage = "최소 1개 이상의 유효한 IP를 입력해 주세요.";
            return;
        }

        IsLoadingBatch = true;
        try
        {
            var results = new List<IpApiResult>(ips.Count);
            for (var index = 0; index < ips.Count; index++)
            {
                var ip = ips[index];
                BatchInfoMessage = $"조회 중: {index + 1}/{ips.Count} - {ip}";
                results.Add(await IpService.GetIpInfoAsync(ip));
            }

            BatchResults = results;
            _lastBatchAnalyzeUtc = now;
            BatchInfoMessage = $"다중 조회 완료: {BatchSuccessCount}개 성공, {BatchFailureCount}개 실패.";
        }
        catch (Exception ex)
        {
            BatchResults = [];
            BatchInfoMessage = $"다중 조회 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            IsLoadingBatch = false;
        }
    }

    private async Task ClearBatchResultAsync()
    {
        BatchResults = [];
        BatchInput = string.Empty;
        BatchInfoMessage = null;
        BatchWarningMessage = null;
        await Task.CompletedTask;
    }

    private async Task ExportBatchToExcelAsync()
    {
        if (BatchResults.Count == 0)
        {
            BatchInfoMessage = "내보낼 결과가 없습니다.";
            return;
        }

        var bytes = BuildBatchExcel(BatchResults);
        await JSRuntime.InvokeVoidAsync(
            "exporter.downloadBinary",
            $"ip-analysis-{DateTime.UtcNow:yyyyMMdd-HHmmss}.xlsx",
            bytes,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private (List<string> Inputs, int OriginalCount, int InvalidCount, int DuplicateCount, bool Truncated) ParseBatchInputs()
    {
        var tokens = (BatchInput ?? string.Empty)
            .Split(new[] { '\r', '\n', ',', ';', '\t', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        var valid = new List<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var invalidCount = 0;
        var duplicateCount = 0;
        foreach (var ip in tokens)
        {
            if (!TryValidateIp(ip, out _))
            {
                invalidCount++;
                continue;
            }

            if (!seen.Add(ip))
            {
                duplicateCount++;
                continue;
            }

            valid.Add(ip);
        }

        var truncated = valid.Count > 20;
        if (truncated)
        {
            return (valid.Take(20).ToList(), tokens.Count, invalidCount, duplicateCount, true);
        }

        return (valid, tokens.Count, invalidCount, duplicateCount, false);
    }

    private List<string> GetBatchInputs()
    {
        return ParseBatchInputs().Inputs;
    }

    private static string AppendWarning(string? existing, string next)
        => string.IsNullOrWhiteSpace(existing) ? next : $"{existing} {next}";

    private static bool HasLooseBatchSeparators(string? input)
        => !string.IsNullOrWhiteSpace(input) && (input.Contains(',') || input.Contains(';') || input.Contains('\t'));

    private static byte[] BuildBatchExcel(IReadOnlyList<IpApiResult> rows)
    {
        using var memoryStream = new MemoryStream();
        using (var zip = new ZipArchive(memoryStream, ZipArchiveMode.Create, leaveOpen: true))
        {
            WriteZipEntry(zip, "[Content_Types].xml", BuildContentTypesXml());
            WriteZipEntry(zip, "_rels/.rels", BuildRootRelsXml());
            WriteZipEntry(zip, "xl/workbook.xml", BuildWorkbookXml());
            WriteZipEntry(zip, "xl/_rels/workbook.xml.rels", BuildWorkbookRelsXml());
            WriteZipEntry(zip, "xl/styles.xml", BuildStylesXml());
            WriteZipEntry(zip, "xl/worksheets/sheet1.xml", BuildWorksheetXml(rows));
        }

        return memoryStream.ToArray();
    }

    private static void WriteZipEntry(ZipArchive zip, string path, string content)
    {
        var entry = zip.CreateEntry(path, CompressionLevel.Fastest);
        using var stream = entry.Open();
        using var writer = new StreamWriter(stream, new UTF8Encoding(false));
        writer.Write(content);
    }

    private static string BuildContentTypesXml() => """
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
