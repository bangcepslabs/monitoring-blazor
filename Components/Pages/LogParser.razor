@page "/log-parser"
@attribute [Authorize]
@implements IDisposable
@using Monitoring.Blazor.Models
@using Monitoring.Blazor.Services
@using Microsoft.EntityFrameworkCore
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text
@using System.Globalization
@inject IDbContextFactory<MonitoringDbContext> DbFactory
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IisLogWorkspaceStore LogWorkspaceStore
@inject IisLogPreviewService LogPreviewService

<PageTitle>@Language.T("IIS 로그 파서", "IIS Log Parser")</PageTitle>

<div class="log-analyzer-page">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
        <h1>@Language.T("IIS 로그 파서", "IIS Log Parser")</h1>
        <p class="text-muted mb-3">@Language.T("소규모 로그를 분석하고 입력과 동시에 결과를 필터링합니다.", "Analyze smaller log files and filter results as you type.")</p>
    </div>
    <a class="btn btn-outline-primary" href="/log-parser/batch">@Language.T("대량 로그 파서 열기", "Open batch log parser")</a>
</div>

@if (IsAnalyzing)
{
    <div class="ai-analysis-overlay" aria-live="polite" aria-busy="true">
        <div class="ai-analysis-overlay__panel">
            <div class="spinner-border text-light" role="status" aria-hidden="true"></div>
            <div class="ai-analysis-overlay__title">@Language.T("AI 분석 중", "AI analysis in progress")</div>
            <div class="ai-analysis-overlay__text">@Language.T("결과를 준비하고 있습니다. 잠시만 기다려 주세요.", "Preparing the results. Please wait.")</div>
            <button class="btn btn-light btn-sm mt-3" @onclick="CancelAnalyzeAsync">@Language.T("분석 취소", "Cancel analysis")</button>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label">@Language.T("서버 이름", "Server Name")</label>
                <input class="form-control" @bind="ServerName" placeholder="HOST-01" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">Ollama</label>
                <select class="form-select" @bind="OllamaEnabledChoice">
                    <option value="Y">@Language.T("사용", "Enabled")</option>
                    <option value="N">@Language.T("사용 안 함", "Disabled")</option>
                </select>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <FilePicker OnChange="HandleFiles" Multiple="true" />
            <button class="btn btn-primary" @onclick="UpdateToServerAsync" disabled="@(IsPreviewing || IsSaving || ParsedAggregates.Count == 0)">
                @Language.T("서버에 반영", "Apply to server")
            </button>
            <button class="btn btn-warning" @onclick="CancelUploadAsync" disabled="@(!(IsPreviewing || IsSaving))">
                @Language.T("업로드 취소", "Cancel upload")
            </button>
            <button class="btn btn-outline-secondary" @onclick="ClearSelectedFiles" disabled="@((IsPreviewing || IsSaving) || SelectedFiles.Count == 0)">
                @Language.T("파일 지우기", "Clear files")
            </button>
        </div>
        <div class="form-text mb-3">
            @Language.T(
                $"일반 파서는 최대 {MaxUploadFiles}개 파일, 전체 {FormatBytes(MaxUploadBytes)}까지입니다. 더 큰 배치는 대량 로그 파서를 이용하세요.",
                $"The standard parser supports up to {MaxUploadFiles} files ({FormatBytes(MaxUploadBytes)} total). Use the batch parser for larger uploads.")
        </div>
        @if (!string.IsNullOrWhiteSpace(UploadMessage))
        {
            <div class="alert alert-warning py-2 mb-3" role="alert">@Language.Localize(UploadMessage)</div>
        }
        @if (SelectedFiles.Count > 0)
        {
            <div class="text-muted mb-2">@Language.T($"선택 파일: {SelectedFiles.Count}개 | 파싱된 행: {TotalParsedRows:N0} | 미리보기 행: {AllRows.Count:N0}", $"Selected files: {SelectedFiles.Count} | Parsed rows: {TotalParsedRows:N0} | Preview rows: {AllRows.Count:N0}")</div>
        }
        @if (IsWorkspaceMode)
        {
            <div class="alert alert-info py-2 mb-3" role="status">
                @Language.T(
                    $"전체 {TotalParsedRows:N0}행을 서버 임시 작업공간에 보관했습니다(24시간 후 자동 삭제). 표·필터·페이지·요약·CSV 내보내기는 전체 데이터 기준이며, AI 보안 분석은 대량 데이터에서 비활성화됩니다.",
                    $"All {TotalParsedRows:N0} rows are stored in a temporary server-side workspace and deleted automatically after 24 hours. The table, filters, pagination, summaries, and CSV export use the full dataset. AI security analysis is disabled for large batches.")
            </div>
            <a class="btn btn-sm btn-outline-primary mb-3" href="@($"/log-parser/batch?workspaceId={Uri.EscapeDataString(WorkspaceId!)}")">@Language.T("전체 로그를 대량 로그 파서에서 열기", "Open the full dataset in the batch parser")</a>
            @if (WorkspaceFilteredCount > 1_048_575)
            {
                <div class="alert alert-warning py-2 mb-3" role="status">
                    @Language.T(
                        $"현재 조건의 {WorkspaceFilteredCount:N0}행은 CSV로 모두 내려받지만, Excel 한 시트는 헤더 포함 최대 1,048,576행까지만 표시합니다. 전체 행이 필요하면 CSV를 데이터 도구로 분할/가져오세요.",
                        $"All {WorkspaceFilteredCount:N0} matching rows will download as CSV, but an Excel worksheet displays at most 1,048,576 rows including the header. Split the CSV or use a data tool to work with every row.")
                </div>
            }
        }
        @if (IsPreviewing)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted">@PreviewStage</span>
                    <span class="text-muted">@PreviewProgress.ToString("0")%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar" role="progressbar" style="width: @($"{PreviewProgress:0}%")"></div>
                </div>
            </div>
        }
        @if (IsSaving)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted">@Language.Localize(SaveStage)</span>
                    <span class="text-muted">@SaveProgress.ToString("0")%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: @($"{SaveProgress:0}%")"></div>
                </div>
            </div>
        }
        <div class="log-filter-header">
            <div>
                <strong>@Language.T("로그 필터", "Log Filters")</strong>
                <span class="text-muted small ms-2">@Language.T("분석 범위를 좁혀 빠르게 확인합니다.", "Narrow the analysis scope.")</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleFilters">
                @(IsFiltersCollapsed ? Language.T("필터 열기", "Show filters") : Language.T("필터 접기", "Hide filters"))
            </button>
        </div>
        @if (!IsFiltersCollapsed)
        {
        <div class="row g-2">
            <div class="col-12 col-md-2">
                <label class="form-label">@Language.T("상태 그룹", "Status Group")</label>
                <select class="form-select" @bind="StatusGroup" @bind:after="QueueWorkspaceFilterSearch">
                    <option value="">@Language.T("전체", "All")</option>
                    <option value="2">2xx</option>
                    <option value="3">3xx</option>
                    <option value="4">4xx</option>
                    <option value="5">5xx</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">@Language.T("상태 코드", "Status Code")</label>
                <input class="form-control" @bind="StatusCode" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="@Language.T("예: 404", "e.g. 404")" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("URL 포함", "URL Contains")</label>
                <input class="form-control" @bind="UrlQuery" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="/api/users" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">@Language.T("메서드", "Method")</label>
                <select class="form-select" @bind="MethodQuery" @bind:after="QueueWorkspaceFilterSearch">
                    <option value="">@Language.T("전체 메서드", "All methods")</option>
                    <option value="GET">GET</option>
                    <option value="POST">POST</option>
                    <option value="PUT">PUT</option>
                    <option value="PATCH">PATCH</option>
                    <option value="DELETE">DELETE</option>
                    <option value="HEAD">HEAD</option>
                    <option value="OPTIONS">OPTIONS</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("IP / 텍스트 검색", "IP / Text Search")</label>
                <input class="form-control" @bind="TextQuery" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="@Language.T("192.168 또는 검색어", "192.168 or keyword")" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("제외 IP", "Exclude IPs")</label>
                <input class="form-control" @bind="ExcludeIpQuery" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="192.168.0.1, 10.0.0.2" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("프리셋", "Presets")</label>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => ApplyPreset("5xx")'>5xx</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => ApplyPreset("/api")'>/api</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => ApplyPreset("POST")'>POST</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">@Language.T("초기화", "Clear")</button>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Language.T("표시 방식", "Display mode")</label>
                <div class="d-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input" @bind="UseVirtualize" disabled="@IsWorkspaceMode" />
                    <span class="text-muted">@Language.T("가상 스크롤", "Virtual scroll")</span>
                </div>
            </div>
        </div>
        }
    </div>
</div>

@{
    var filtered = GetFilteredRows();
    var statusSummary = IsWorkspaceMode && WorkspaceSummary is not null ? WorkspaceSummary.StatusCounts : CachedStatusSummary;
    var topUrls = IsWorkspaceMode && WorkspaceSummary is not null ? WorkspaceSummary.TopUrls : CachedTopUrls;
    var pageRows = IsWorkspaceMode ? WorkspacePageRows : UseVirtualize ? filtered : GetPagedRows(filtered);
    var resultCount = IsWorkspaceMode ? (int)Math.Min(WorkspaceFilteredCount, int.MaxValue) : filtered.Count;
    var totalPages = GetTotalPages(resultCount);
    var blockCandidateIps = GetBlockCandidateIps();
    var rateLimitCandidateIps = GetRateLimitCandidateIps();
}

@if (IsWorkspaceMode)
{
    <div class="alert @(IsLoadingWorkspacePage ? "alert-primary" : "alert-light border") d-flex align-items-center gap-2 py-2 mb-3" role="status" aria-live="polite" aria-busy="@(IsLoadingWorkspacePage || _workspaceFilterDebounceCts is not null)">
        @if (IsLoadingWorkspacePage || _workspaceFilterDebounceCts is not null)
        {
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            @if (IsLoadingWorkspacePage)
            {
                <span>@Language.T($"전체 {TotalParsedRows:N0}행에서 조건을 검색하고 요약을 계산하는 중입니다. 데이터가 많으면 잠시 걸릴 수 있습니다.", $"Searching and summarizing all {TotalParsedRows:N0} rows. This may take a while for large datasets.")</span>
            }
            else
            {
                <span>@Language.T("입력을 멈추면 자동으로 검색합니다.", "Search runs automatically when you stop typing.")</span>
            }
        }
        else
        {
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>@Language.T("입력을 멈추면 필터가 전체 로그에 자동 적용됩니다.", "Filters are applied to the full dataset when you stop typing.")</span>
        }
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="metric-label">@Language.T("전체 요청 수", "Total Requests")</div>
                <div class="metric-value">@((IsWorkspaceMode ? WorkspaceFilteredCount : filtered.Count).ToString("N0"))</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="metric-label">@Language.T("고유 IP 수", "Unique IPs")</div>
                <div class="metric-value">@((IsWorkspaceMode && WorkspaceSummary is not null ? WorkspaceSummary.UniqueIps : CachedUniqueIpCount).ToString("N0"))</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="metric-label">@Language.T("탐지된 URL", "Detected URLs")</div>
                <div class="metric-value">@((IsWorkspaceMode && WorkspaceSummary is not null ? WorkspaceSummary.UniqueUrls : CachedUniqueUrlCount).ToString("N0"))</div>
            </div>
        </div>
    </div>
</div>

@if (!IsPreviewTruncated && !string.IsNullOrWhiteSpace(AnalyzeMessage) && (blockCandidateIps.Count > 0 || rateLimitCandidateIps.Count > 0))
{
    <section class="candidate-summary-card mb-3" aria-label="@Language.T("IP 대응 후보", "IP response candidates")">
        <div class="candidate-summary-card__header">
            <div>
                <div class="candidate-summary-card__eyebrow">@Language.T("AI 보안 대응", "AI security actions")</div>
                <h2>@Language.T("우선 대응 IP", "Priority IPs to Review")</h2>
                <p>@Language.T("AI 분석 근거에 따라 검토할 IP입니다. 자동 차단은 수행하지 않습니다.", "IPs to review based on the analysis. No automatic blocking is performed.")</p>
            </div>
            <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        </div>
        <div class="candidate-summary-card__grid">
            <div class="candidate-summary-card__item candidate-summary-card__item--block">
                <div class="candidate-summary-card__label">@Language.T("즉시 차단 검토", "Block Candidates")</div>
                <div class="candidate-summary-card__value">@(blockCandidateIps.Count > 0 ? string.Join(", ", blockCandidateIps) : Language.T("없음", "None"))</div>
                <button class="btn btn-sm btn-outline-danger" @onclick="CopyBlockCandidatesAsync" disabled="@(blockCandidateIps.Count == 0)">
                    @Language.T("IP 복사", "Copy IPs")
                </button>
            </div>
            <div class="candidate-summary-card__item candidate-summary-card__item--limit">
                <div class="candidate-summary-card__label">@Language.T("속도 제한 검토", "Rate-Limit Candidates")</div>
                <div class="candidate-summary-card__value">@(rateLimitCandidateIps.Count > 0 ? string.Join(", ", rateLimitCandidateIps) : Language.T("없음", "None"))</div>
                <button class="btn btn-sm btn-outline-warning" @onclick="CopyRateLimitCandidatesAsync" disabled="@(rateLimitCandidateIps.Count == 0)">
                    @Language.T("IP 복사", "Copy IPs")
                </button>
            </div>
        </div>
    </section>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><strong>@Language.T("상태 코드 분석", "Status Analysis")</strong></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead>
                    <tr><th>@Language.T("상태", "Status")</th><th class="text-end">@Language.T("건수", "Count")</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in statusSummary)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td class="text-end">@item.Value.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><strong>@Language.T("상위 URL", "Top URLs")</strong></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead>
                    <tr><th>URL</th><th class="text-end">@Language.T("호출 수", "Hits")</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in topUrls)
                    {
                        <tr>
                            <td class="text-truncate" style="max-width: 420px;" title="@item.Key">@item.Key</td>
                            <td class="text-end">@item.Value.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

    <div class="card log-entries-card">
    <div class="card-header log-entries-header">
        <div class="log-entries-header__title">
            <strong>@Language.T("로그 항목", "Log Entries")</strong>
            <div class="text-muted small">@Language.T("현재 표시된 로그를 필터링·분석하거나 내보냅니다.", "Filter, analyze, or export the currently displayed logs.")</div>
        </div>
        <div class="log-entries-actions">
            <div class="log-entries-action-group" aria-label="@Language.T("분석 작업", "Analysis actions")">
                <button class="btn btn-sm btn-outline-secondary" @onclick="RunExportNow" disabled="@IsRunningExport">@Language.T("지금 내보내기 실행", "Run Export Now")</button>
                <button class="btn btn-sm btn-primary" @onclick="RunAnalyze" disabled="@(!CanRunAnalyze)" title="@(IsPreviewTruncated ? Language.T("일부 미리보기만으로는 AI 분석을 실행할 수 없습니다.", "AI analysis is unavailable for a partial preview.") : null)">@Language.T("AI 분석", "Analyze with AI")</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="CancelAnalyzeAsync" disabled="@(!IsAnalyzing)">@Language.T("AI 분석 취소", "Cancel AI analysis")</button>
            </div>
            <div class="log-entries-action-group log-entries-action-group--candidates" aria-label="@Language.T("대응 후보 작업", "Candidate actions")">
                <button class="btn btn-sm btn-outline-dark" @onclick="CopyBlockCandidatesAsync" disabled="@(!CanCopyBlockCandidates)">@Language.T("차단 IP 복사", "Copy Block IPs")</button>
                <button class="btn btn-sm btn-outline-dark" @onclick="CopyRateLimitCandidatesAsync" disabled="@(!CanCopyRateLimitCandidates)">@Language.T("속도 제한 대상 IP 복사", "Copy Rate-Limit IPs")</button>
            </div>
            <div class="log-entries-action-group log-entries-action-group--view" aria-label="@Language.T("표 옵션", "Table options")">
                <label class="form-label mb-0">@Language.T("다중 정렬", "Multi-sort")</label>
                <input type="checkbox" class="form-check-input" @bind="MultiSort" />
                <span class="badge @(UseOllama ? "text-bg-success" : "text-bg-secondary")">Ollama: @(UseOllama ? Language.T("사용", "On") : Language.T("사용 안 함", "Off"))</span>
                <span class="badge text-bg-info">@Language.T("제외 IP 필터 적용됨", "Excluded-IP filter active")</span>
                <label class="form-label mb-0">@Language.T("행", "Rows")</label>
                <select class="form-select form-select-sm w-auto" value="@PageSize" @onchange="OnPageSizeChanged" disabled="@(!IsWorkspaceMode && UseVirtualize)">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                @if (IsWorkspaceMode)
                {
                    <button class="btn btn-sm btn-primary d-inline-flex align-items-center gap-2" @onclick="ApplyWorkspaceFiltersAsync" disabled="@IsLoadingWorkspacePage" aria-busy="@IsLoadingWorkspacePage">
                        @if (IsLoadingWorkspacePage || _workspaceFilterDebounceCts is not null)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            @(IsLoadingWorkspacePage ? Language.T("전체 로그 검색 중...", "Searching all logs...") : Language.T("잠시 후 자동 검색...", "Auto-searching shortly..."))
                        }
                        else
                        {
                            @Language.T("지금 검색", "Search now")
                        }
                    </button>
                }
                <button class="btn btn-sm btn-outline-primary" @onclick="ExportToExcel">@Language.T("CSV 다운로드 (Excel 호환)", "Download CSV (Excel-compatible)")</button>
            </div>
        </div>
    </div>
    <div class="card-body log-entries-body">
        @if (IsLoadingWorkspacePage)
        {
            <div class="alert alert-primary d-flex align-items-center gap-2 py-2 mb-3" role="status" aria-live="polite" aria-busy="true">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>@Language.T("전체 로그를 검색하고 페이지를 불러오는 중입니다...", "Searching the full dataset and loading this page...")</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ExportMessage))
        {
            <div class="analysis-inline-message mb-3">
                <div class="analysis-inline-message__label">@Language.T("내보내기", "Export")</div>
                <div class="analysis-inline-message__text">@Language.Localize(ExportMessage)</div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(AnalyzeMessage))
        {
            var reportSections = LogAnalysisPresentationService.ParseDisplayedSections(AnalyzeMessage);
            var topIpAccess = IsWorkspaceMode && WorkspaceSummary is not null
                ? WorkspaceSummary.TopIps.Select(item => new CountItem(item.Key, (int)Math.Min(item.Value, int.MaxValue))).ToList()
                : CachedTopIpAccess;
            <section class="analysis-inline-report mb-3" aria-label="@Language.T("AI 분석 보고서", "AI analysis report")">
                <div class="analysis-inline-report__header">
                    <button type="button" class="analysis-inline-report__toggle" @onclick="ToggleAnalysisReportCollapsed" aria-expanded="@(!IsAnalysisReportCollapsed)">
                        <span class="analysis-inline-report__icon">
                            <i class="bi @(IsAnalysisReportCollapsed ? "bi-chevron-right" : "bi-chevron-down")"></i>
                        </span>
                        <span class="analysis-inline-report__content">
                            <span class="analysis-inline-report__eyebrow">@Language.T("AI 분석 보고서", "AI analysis report")</span>
                            <span class="analysis-inline-report__subtitle">@Language.T("공격 의심 URL과 IP, 대응 권고를 한곳에서 확인할 수 있습니다.", "Review suspicious URLs and IPs, along with recommended actions.")</span>
                        </span>
                    </button>
                    <div class="analysis-inline-report__meta">
                        <button type="button" class="analysis-inline-report__action" @onclick="ToggleAnalysisReportCollapsed">
                            @(IsAnalysisReportCollapsed ? Language.T("펼치기", "Expand") : Language.T("접기", "Collapse"))
                        </button>
                    </div>
                </div>

                @if (!IsAnalysisReportCollapsed && reportSections.Count > 0)
                {
                    @if (LastAnalysisUsedFallback)
                    {
                        <div class="analysis-inline-report__notice">
                            @Language.T("자동 요약이 충분하지 않아 집계 데이터 기반 결과를 표시합니다.", "The summary was insufficient, so results based on aggregated data are shown.")
                        </div>
                    }
                    <div class="analysis-section-grid">
                        @foreach (var section in reportSections)
                        {
                            <article class="analysis-section-card">
                                <div class="analysis-section-card__header">
                                    <h3>@section.Title</h3>
                                </div>
                                <div class="analysis-section-card__body">
                                    @{
                                        var primaryLine = section.Lines.FirstOrDefault();
                                        var detailLines = section.Lines.Skip(1).ToList();
                                    }

                                    @if (!string.IsNullOrWhiteSpace(primaryLine))
                                    {
                                        <div class="analysis-section-card__primary">@primaryLine</div>
                                    }

                                    @if (detailLines.Count > 0)
                                    {
                                        <div class="analysis-section-card__list">
                                            @foreach (var line in detailLines)
                                            {
                                                if (line.StartsWith("- "))
                                                {
                                                    <div class="analysis-section-card__bullet">@line.Substring(2)</div>
                                                }
                                                else
                                                {
                                                    <p>@line</p>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                    @if (topIpAccess.Count > 0)
                    {
                        <div class="analysis-ip-chart-card" aria-label="@Language.T("IP 요청 상위 5개", "Top 5 IPs by requests")">
                            <div class="analysis-ip-chart-card__header">
                                <div>
                                    <h3>@Language.T("IP 접근 상위 5개", "Top 5 IPs by request count")</h3>
                                    <p>@Language.T("현재 필터에 해당하는 로그에서 요청이 가장 많은 IP입니다.", "These IPs have the most requests in the currently filtered logs.")</p>
                                </div>
                                <span class="analysis-ip-chart-card__badge">@Language.T("요청 수", "Requests")</span>
                            </div>
                            <div class="analysis-ip-chart-card__canvas-wrap">
                            <canvas id="logParserTopIpChart" aria-label="@Language.T("IP 요청 상위 5개 차트", "Top 5 IP request chart")"></canvas>
                            </div>
                        </div>
                    }
                }
                else if (!IsAnalysisReportCollapsed)
                {
                    <pre class="analysis-pre">@Language.Localize(AnalyzeMessage)</pre>
                }
                else
                {
                    <div class="analysis-inline-report__collapsed-note">@Language.T("AI 분석 보고서가 접혀 있습니다. 펼치기를 눌러 상세 내용을 확인하세요.", "The AI report is collapsed. Expand it to view the details.")</div>
                }
            </section>
        }
        @if (RecentAnalysisEntries.Count > 0)
        {
            <section class="analysis-history-panel" aria-label="@Language.T("최근 분석 기록", "Recent analysis history")">
                <div class="analysis-history-panel__header">
                    <button type="button" class="analysis-inline-report__toggle" @onclick="ToggleRecentReportsCollapsed">
                        <span class="analysis-inline-report__icon">
                            <i class="bi @(IsRecentReportsCollapsed ? "bi-chevron-right" : "bi-chevron-down")"></i>
                        </span>
                        <span class="analysis-inline-report__content">
                            <span class="analysis-inline-report__eyebrow">@Language.T("분석 기록", "Analysis history")</span>
                            <span class="analysis-history-panel__subtitle">@Language.T("최근 분석 결과를 선택해 다시 확인할 수 있습니다.", "Select a recent result to review it again.")</span>
                        </span>
                    </button>
                    <div class="analysis-inline-report__meta">
                        <button class="analysis-inline-report__action analysis-inline-report__action--secondary" @onclick="LoadRecentAnalysisHistoryAsync">@Language.T("새로고침", "Refresh")</button>
                        <button type="button" class="analysis-inline-report__action" @onclick="ToggleRecentReportsCollapsed">
                            @(IsRecentReportsCollapsed ? Language.T("펼치기", "Expand") : Language.T("접기", "Collapse"))
                        </button>
                    </div>
                </div>
                @if (!IsRecentReportsCollapsed)
                {
                    <div class="analysis-history-list">
                        @foreach (var entry in RecentAnalysisEntries)
                        {
                            <button type="button" class="analysis-history-item" @onclick="() => LoadHistoryEntry(entry)">
                                <div class="analysis-history-item__top">
                                    <strong>@entry.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong>
                                </div>
                                <div class="analysis-history-item__meta">
                                    <span>@(entry.LogDate?.ToString() ?? "-")</span>
                                    <span>@Language.T($"{entry.TotalRows:N0}행", $"{entry.TotalRows:N0} rows")</span>
                                    @if (IsFallbackResponse(entry.Response))
                                    {
                                        <span>@Language.T("집계 데이터 기반", "Based on aggregated data")</span>
                                    }
                                </div>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="analysis-inline-report__collapsed-note">@Language.T("최근 분석 기록이 접혀 있습니다. 펼치기를 눌러 목록을 확인하세요.", "Recent analysis history is collapsed. Expand it to view the list.")</div>
                }
            </section>
        }
    </div>
    <div class="log-entries-toolbar">
        <div class="log-entries-toolbar__hint">
            <i class="bi bi-arrows-expand-vertical"></i>
            @Language.T("헤더 오른쪽 경계를 드래그해 열 너비를 조절할 수 있습니다.", "Drag a column header's right edge to resize it.")
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetColumnWidthsAsync">@Language.T("열 너비 초기화", "Reset column widths")</button>
    </div>
    <div class="table-responsive log-entries-table">
        <table id="log-entries-grid" class="table table-sm table-striped mb-0 log-entries-grid">
            <colgroup>
                <col class="col-date" data-column="date" />
                <col class="col-time" data-column="time" />
                <col class="col-ip" data-column="ip" />
                <col class="col-method" data-column="method" />
                <col class="col-uri" data-column="uri" />
                <col class="col-status" data-column="status" />
                <col class="col-referer" data-column="referer" />
                <col class="col-agent" data-column="agent" />
            </colgroup>
            <thead>
            <tr>
                <th class="cell-compact" data-column="date"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Date))">@Language.T("날짜", "Date") <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Date))"></i></span></button><span class="column-resizer" data-column="date" title="@Language.T("날짜 열 너비 조절", "Resize date column")"></span></div></th>
                <th class="cell-compact" data-column="time"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Time))">@Language.T("시간", "Time") <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Time))"></i></span></button><span class="column-resizer" data-column="time" title="@Language.T("시간 열 너비 조절", "Resize time column")"></span></div></th>
                <th class="cell-ip" data-column="ip"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Ip))">IP <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Ip))"></i></span></button><span class="column-resizer" data-column="ip" title="@Language.T("IP 열 너비 조절", "Resize IP column")"></span></div></th>
                <th class="cell-compact" data-column="method"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Method))">@Language.T("메서드", "Method") <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Method))"></i></span></button><span class="column-resizer" data-column="method" title="@Language.T("메서드 열 너비 조절", "Resize method column")"></span></div></th>
                <th class="cell-wide" data-column="uri"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Uri))">URI <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Uri))"></i></span></button><span class="column-resizer" data-column="uri" title="@Language.T("URI 열 너비 조절", "Resize URI column")"></span></div></th>
                <th class="cell-compact" data-column="status"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Status))">@Language.T("상태", "Status") <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Status))"></i></span></button><span class="column-resizer" data-column="status" title="@Language.T("상태 열 너비 조절", "Resize status column")"></span></div></th>
                <th class="cell-medium" data-column="referer"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.Referrer))">@Language.T("리퍼러", "Referrer") <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.Referrer))"></i></span></button><span class="column-resizer" data-column="referer" title="@Language.T("리퍼러 열 너비 조절", "Resize referrer column")"></span></div></th>
                <th class="cell-agent" data-column="agent"><div class="log-header-cell"><button class="btn btn-sm btn-link sort-btn" @onclick="() => ToggleSort(nameof(ParsedLogRow.UserAgent))">User-Agent <span class="sort-icon"><i class="@SortIconClass(nameof(ParsedLogRow.UserAgent))"></i></span></button><span class="column-resizer" data-column="agent" title="@Language.T("User-Agent 열 너비 조절", "Resize User-Agent column")"></span></div></th>
            </tr>
            <tr class="table-filter-row">
                <th class="cell-compact"><input class="form-control form-control-sm" @bind="DateFilter" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="yyyy-mm-dd" /></th>
                <th class="cell-compact"><input class="form-control form-control-sm" @bind="TimeFilter" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="hh:mm" /></th>
                <th class="cell-ip"><input class="form-control form-control-sm" @bind="IpFilter" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="IP" /></th>
                <th class="cell-compact"><input class="form-control form-control-sm" @bind="MethodFilter" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="GET" /></th>
                <th class="cell-wide"><input class="form-control form-control-sm" @bind="UriFilter" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="/api" /></th>
                <th class="cell-compact"><input class="form-control form-control-sm" @bind="StatusFilter" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="200" /></th>
                <th class="cell-medium"><input class="form-control form-control-sm" @bind="ReferrerFilter" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="ref" /></th>
                <th class="cell-agent"><input class="form-control form-control-sm" @bind="AgentFilter" @bind:event="oninput" @bind:after="QueueWorkspaceFilterSearch" placeholder="agent" /></th>
            </tr>
            </thead>
            <tbody @key="CurrentPage">
            @if (UseVirtualize && !IsWorkspaceMode)
            {
                <Virtualize Items="filtered" Context="row" ItemSize="36" OverscanCount="12">
                    <tr @key="row" class="@GetRowClass(row)">
                        <td class="cell-compact">@row.Date</td>
                        <td class="cell-compact">@row.Time</td>
                        <td class="cell-ip">@row.Ip</td>
                        <td class="cell-compact"><span class="@GetMethodBadgeClass(row.Method)">@row.Method</span></td>
                        <td class="cell-wide text-truncate" title="@row.Uri">@row.Uri</td>
                        <td class="cell-compact"><span class="@GetStatusBadgeClass(row.Status)">@row.Status</span></td>
                        <td class="cell-medium text-truncate" title="@row.Referrer">@row.Referrer</td>
                        <td class="cell-agent text-truncate" title="@row.UserAgent">@row.UserAgent</td>
                    </tr>
                </Virtualize>
            }
            else
            {
                @foreach (var row in pageRows)
                {
                    <tr @key="row" class="@GetRowClass(row)">
                        <td class="cell-compact">@row.Date</td>
                        <td class="cell-compact">@row.Time</td>
                        <td class="cell-ip">@row.Ip</td>
                        <td class="cell-compact"><span class="@GetMethodBadgeClass(row.Method)">@row.Method</span></td>
                        <td class="cell-wide text-truncate" title="@row.Uri">@row.Uri</td>
                        <td class="cell-compact"><span class="@GetStatusBadgeClass(row.Status)">@row.Status</span></td>
                        <td class="cell-medium text-truncate" title="@row.Referrer">@row.Referrer</td>
                        <td class="cell-agent text-truncate" title="@row.UserAgent">@row.UserAgent</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
        @if (!UseVirtualize || IsWorkspaceMode)
        {
            <div class="text-muted">@(Language.IsKorean ? $"전체 {GetStartIndex(resultCount)}-{GetEndIndex(resultCount)} / {resultCount}행 | {CurrentPage} / {totalPages}페이지" : $"Showing {GetStartIndex(resultCount)}-{GetEndIndex(resultCount)} of {resultCount} rows | Page {CurrentPage} / {totalPages}")</div>
            <div class="d-flex align-items-center gap-2">
                @if (IsLoadingWorkspacePage)
                {
                    <span class="small text-primary d-inline-flex align-items-center gap-2" role="status" aria-live="polite">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        @Language.T("페이지 불러오는 중", "Loading page")
                    </span>
                }
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GoToFirstPageAsync" disabled="@(CurrentPage <= 1 || IsLoadingWorkspacePage)">@Language.T("처음", "First")</button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="PrevPageAsync" disabled="@(CurrentPage <= 1 || IsLoadingWorkspacePage)">@Language.T("이전", "Previous")</button>
                @if (ShouldShowLeadingEllipsis(resultCount))
                {
                    <span class="text-muted px-1">...</span>
                }
                @foreach (var pageNumber in GetVisiblePages(resultCount))
                {
                    <button type="button" class="btn btn-sm @(pageNumber == CurrentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => GoToPageAsync(pageNumber)" disabled="@IsLoadingWorkspacePage">@pageNumber</button>
                }
                @if (ShouldShowTrailingEllipsis(resultCount))
                {
                    <span class="text-muted px-1">...</span>
                }
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="NextPageAsync" disabled="@(CurrentPage >= totalPages || IsLoadingWorkspacePage)">@Language.T("다음", "Next")</button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GoToLastPageAsync" disabled="@(CurrentPage >= totalPages || IsLoadingWorkspacePage)">@Language.T("마지막", "Last")</button>
            </div>
        }
    </div>
</div>

<button class="scroll-top-btn" title="@Language.T("맨 위로", "Back to top")" @onclick="ScrollToTop">↑</button>
</div>

@code {
    private HttpClient? _http;
    private bool IsRunningExport { get; set; }
    private string? ExportMessage { get; set; }
    private bool IsAnalyzing { get; set; }
    private string? AnalyzeMessage { get; set; }
    private bool IsAnalysisReportCollapsed { get; set; }
    private bool IsRecentReportsCollapsed { get; set; }
    private bool IsFiltersCollapsed { get; set; }
    private bool LastAnalysisUsedFallback { get; set; }
    private string LastAnalysisSourceLabel { get; set; } = string.Empty;
    private string ServerName { get; set; } = string.Empty;
    private List<IBrowserFile> SelectedFiles { get; set; } = [];
    private List<ParsedLogRow> AllRows { get; set; } = [];
    private List<ParsedLogRow> FilteredRows { get; set; } = [];
    private List<KeyValuePair<string, long>> CachedStatusSummary { get; set; } = [];
    private List<KeyValuePair<string, long>> CachedTopUrls { get; set; } = [];
    private List<CountItem> CachedTopIpAccess { get; set; } = [];
    private long CachedUniqueIpCount { get; set; }
    private long CachedUniqueUrlCount { get; set; }
    private string? WorkspaceId { get; set; }
    private List<ParsedLogRow> WorkspacePageRows { get; set; } = [];
    private long WorkspaceFilteredCount { get; set; }
    private IisLogWorkspaceSummary? WorkspaceSummary { get; set; }
    private IisLogFilterCriteria AppliedWorkspaceCriteria { get; set; } = new();
    private bool IsLoadingWorkspacePage { get; set; }
    private bool IsWorkspaceMode => IsPreviewTruncated && !string.IsNullOrWhiteSpace(WorkspaceId);
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 25;
    private bool UseVirtualize { get; set; } = false;
    private bool IsPreviewing { get; set; }
    private bool IsSaving { get; set; }
    private bool IsCancelling { get; set; }
    private double PreviewProgress { get; set; }
    private double SaveProgress { get; set; }
    private string PreviewStage { get; set; } = "Idle";
    private string SaveStage { get; set; } = "Idle";
    private bool FilterDirty { get; set; } = true;
    private bool UseOllama { get; set; } = true;
    private bool CanRunAnalyze => UseOllama && !IsAnalyzing && !IsPreviewTruncated;
    private DotNetObjectReference<LogParser>? _settingsRef;
    private CancellationTokenSource? _uploadCts;
    private CancellationTokenSource? _analysisCts;
    private CancellationTokenSource? _workspaceFilterDebounceCts;
    private const int WorkspaceFilterDebounceMilliseconds = 350;
    private LogAnalysisRuntimeSettings LogAnalysisSettings { get; set; } = new();
    private List<OllamaAnalysisEntry> RecentAnalysisEntries { get; set; } = [];
    private static readonly JsonSerializerOptions AnalysisJsonOptions = new()
    {
        WriteIndented = false,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    };
    private static readonly string[] DefaultAnalysisExcludedIpPatterns =
    [
        "121.131.195.*"
    ];
    private static readonly string[] DefaultAnalysisExcludedIpPrefixes =
    [
        "121.131.195."
    ];
    private static IReadOnlyList<string> AnalysisExcludedIpPatterns = DefaultAnalysisExcludedIpPatterns;
    private static IReadOnlyList<string> AnalysisExcludedIpPrefixes = DefaultAnalysisExcludedIpPrefixes;
    private const int MaxUploadFiles = 5;
    private const long MaxUploadBytes = 512L * 1024 * 1024;
    private string? UploadMessage { get; set; }
    private List<LogIpAggregate> ParsedAggregates { get; set; } = [];
    private long TotalParsedRows { get; set; }
    private bool IsPreviewTruncated { get; set; }
    private bool CanCopyBlockCandidates => !IsPreviewTruncated && GetBlockCandidateIps().Count > 0;
    private bool CanCopyRateLimitCandidates => !IsPreviewTruncated && GetRateLimitCandidateIps().Count > 0;
    private string OllamaEnabledChoice
    {
        get => UseOllama ? "Y" : "N";
        set
        {
            var next = string.Equals(value, "Y", StringComparison.OrdinalIgnoreCase);
            if (UseOllama == next)
            {
                return;
            }

            UseOllama = next;
            _ = SaveOllamaPreferenceAsync();
        }
    }

    private string _statusGroup = string.Empty;
    private string _statusCode = string.Empty;
    private string _urlQuery = string.Empty;
    private string _methodQuery = string.Empty;
    private string _textQuery = string.Empty;
