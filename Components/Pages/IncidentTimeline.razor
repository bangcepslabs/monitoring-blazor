@page "/incident-timeline"
@attribute [Authorize]
@using Monitoring.Blazor.Services
@inject EventTimelineService TimelineService

<PageTitle>OpsEye | @Language.T("인시던트 타임라인", "Incident Timeline")</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <div class="text-uppercase text-muted small mb-1">@Language.T("운영", "Operations")</div>
            <h1 class="h3 mb-1">@Language.T("인시던트 타임라인", "Incident timeline")</h1>
            <p class="text-secondary mb-0">@Language.T("보안·알림·구성 변경 이벤트를 인시던트 우선순위로 확인합니다.", "Security, alert, and configuration events prioritized as incidents.")</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="ReloadAsync">@Language.T("새로고침", "Refresh")</button>
            <a class="btn btn-outline-primary" href="/">@Language.T("대시보드로 돌아가기", "Back to dashboard")</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("활성 인시던트", "Active incidents")</div>
                    <div class="fs-4 fw-semibold">@IncidentRows.Count(x => x.IsActive)</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("알림", "Alerts")</div>
                    <div class="fs-4 fw-semibold">@IncidentRows.Count(x => x.Category == "Alert")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("로그인 실패", "Failed logins")</div>
                    <div class="fs-4 fw-semibold">@IncidentRows.Count(x => x.Category == "Login" && x.Severity == "Medium")</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@Language.T("구성 변경", "Config changes")</div>
                    <div class="fs-4 fw-semibold">@IncidentRows.Count(x => x.Category == "Audit" && (x.Severity is "High" or "Critical"))</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-12 col-md-4">
                    <input class="form-control" placeholder="@Language.T("호스트 / 작업 / 메시지 검색", "Search host / action / message")" @bind="SearchText" @bind:event="oninput" />
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select" @bind="CategoryFilter">
                        <option value="">@Language.T("모든 카테고리", "All categories")</option>
                        <option value="Alert">@Language.T("알림", "Alert")</option>
                        <option value="Login">@Language.T("로그인", "Login")</option>
                        <option value="Audit">@Language.T("감사", "Audit")</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select" @bind="SeverityFilter">
                        <option value="">@Language.T("모든 심각도", "All severity")</option>
                        <option value="Critical">@Language.T("위험", "Critical")</option>
                        <option value="High">@Language.T("높음", "High")</option>
                        <option value="Medium">@Language.T("중간", "Medium")</option>
                        <option value="Low">@Language.T("낮음", "Low")</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <input class="form-control" type="date" @bind="FromDate" />
                </div>
                <div class="col-6 col-md-2">
                    <input class="form-control" type="date" @bind="ToDate" />
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters">@Language.T("초기화", "Clear")</button>
                    <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                        <span class="text-muted small">@Language.T("페이지당 행 수", "Rows per page")</span>
                        <select class="form-select form-select-sm w-auto" @bind="PageSize">
                            <option value="10">10</option>
                            <option value="30">30</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>

            @if (PagedRows.Count == 0)
            {
                <div class="text-muted">@Language.T("인시던트가 없습니다.", "No incidents found.")</div>
            }
            else
            {
                <div class="timeline-list d-grid gap-2">
                    @foreach (var row in PagedRows)
                    {
                        <div class="border rounded-3 p-3">
                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <div class="fw-semibold">@row.Title</div>
                                <div class="d-flex gap-2">
                                    <span class="badge text-bg-secondary">@row.Category</span>
                                    <span class="badge @GetSeverityBadge(row.Severity)">@row.Severity</span>
                                </div>
                            </div>
                            <div class="text-secondary small">@row.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                            <div class="mt-2">
                                <span class="badge text-bg-light text-dark border me-2">@row.Subject</span>
                                <span class="text-break">@row.Message</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(row.Detail))
                            {
                                <div class="text-muted small mt-1 text-break">@row.Detail</div>
                            }
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                    <div class="text-muted small">
                        @(Language.IsKorean ? $"{DisplayRangeStart}-{DisplayRangeEnd}개 중 {FilteredRows.Count}개 항목" : $"Showing {DisplayRangeStart}-{DisplayRangeEnd} of {FilteredRows.Count} item(s)")
                    </div>
                    <div class="btn-group" role="group" aria-label="Pagination">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousPage" disabled="@IsFirstPage">@Language.T("이전", "Previous")</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@IsLastPage">@Language.T("다음", "Next")</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly List<EventTimelineEntry> _items = [];
    private string _searchText = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _severityFilter = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int _pageSize = 30;
    private int _currentPage = 1;

    private string SearchText
    {
        get => _searchText;
        set { _searchText = value; _currentPage = 1; }
    }

    private string CategoryFilter
    {
        get => _categoryFilter;
        set { _categoryFilter = value; _currentPage = 1; }
    }

    private string SeverityFilter
    {
        get => _severityFilter;
        set { _severityFilter = value; _currentPage = 1; }
    }

    private DateTime? FromDate
    {
        get => _fromDate;
        set { _fromDate = value; _currentPage = 1; }
    }

    private DateTime? ToDate
    {
        get => _toDate;
        set { _toDate = value; _currentPage = 1; }
    }

    private int PageSize
    {
        get => _pageSize;
        set
        {
            _pageSize = value is 10 or 30 or 50 or 100 ? value : 30;
            _currentPage = 1;
        }
    }

    private List<IncidentRow> FilteredRows =>
        _items
            .Select(MapRow)
            .Where(row =>
                string.IsNullOrWhiteSpace(_searchText) ||
                row.Subject.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                row.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                row.Message.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                row.Detail.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            .Where(row => string.IsNullOrWhiteSpace(_categoryFilter) || string.Equals(row.Category, _categoryFilter, StringComparison.OrdinalIgnoreCase))
            .Where(row => string.IsNullOrWhiteSpace(_severityFilter) || string.Equals(row.Severity, _severityFilter, StringComparison.OrdinalIgnoreCase))
            .Where(row => !_fromDate.HasValue || row.TimestampUtc.ToLocalTime() >= _fromDate.Value.Date)
            .Where(row => !_toDate.HasValue || row.TimestampUtc.ToLocalTime() < _toDate.Value.Date.AddDays(1))
            .OrderByDescending(row => row.Priority)
            .ThenByDescending(row => row.TimestampUtc)
            .ToList();

    private List<IncidentRow> IncidentRows => FilteredRows;

    private List<IncidentRow> PagedRows =>
        FilteredRows
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count / (double)_pageSize));
    private bool IsFirstPage => _currentPage <= 1;
    private bool IsLastPage => _currentPage >= TotalPages;
    private int DisplayRangeStart => FilteredRows.Count == 0 ? 0 : ((_currentPage - 1) * _pageSize) + 1;
    private int DisplayRangeEnd => Math.Min(_currentPage * _pageSize, FilteredRows.Count);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _items.Clear();
        _items.AddRange(await TimelineService.GetRecentEventsAsync(200));
        _currentPage = 1;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _categoryFilter = string.Empty;
        _severityFilter = string.Empty;
        _fromDate = null;
        _toDate = null;
        _currentPage = 1;
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
        }
    }

    private static IncidentRow MapRow(EventTimelineEntry item)
    {
        var severity = GetSeverity(item);
        var priority = severity switch
        {
            "Critical" => 4,
            "High" => 3,
            "Medium" => 2,
            _ => 1
        };

        return new IncidentRow
        {
            TimestampUtc = item.TimestampUtc,
            Category = item.Category,
            Subject = item.Subject,
            Title = item.Title,
            Message = item.Message,
            Detail = item.Detail,
            Severity = severity,
            Priority = priority,
            IsActive = severity is "Critical" or "High"
        };
    }

    private static string GetSeverity(EventTimelineEntry item)
    {
        if (item.Category == "Alert")
        {
            return item.Title.Contains("Recovery", StringComparison.OrdinalIgnoreCase) ? "Low"
                : item.Title.Contains("Anomaly", StringComparison.OrdinalIgnoreCase) ? "High"
                : "High";
        }

        if (item.Category == "Login")
        {
            return string.Equals(item.Message, "Failed", StringComparison.OrdinalIgnoreCase) ? "Medium" : "Low";
        }

        if (item.Category == "Audit")
        {
            if (item.Title.Contains("settings_restore", StringComparison.OrdinalIgnoreCase) ||
                item.Title.Contains("member_role", StringComparison.OrdinalIgnoreCase) ||
                item.Title.Contains("security_settings_update", StringComparison.OrdinalIgnoreCase))
            {
                return "Critical";
            }

            if (item.Title.Contains("notification_settings_update", StringComparison.OrdinalIgnoreCase) ||
                item.Title.Contains("email_settings_update", StringComparison.OrdinalIgnoreCase) ||
                item.Title.Contains("sql_target_update", StringComparison.OrdinalIgnoreCase) ||
                item.Title.Contains("member_active", StringComparison.OrdinalIgnoreCase))
            {
                return "High";
            }

            return "Medium";
        }

        return "Low";
    }

    private static string GetSeverityBadge(string severity) => severity switch
    {
        "Critical" => "text-bg-danger",
        "High" => "text-bg-warning",
        "Medium" => "text-bg-primary",
        _ => "text-bg-secondary"
    };

    private sealed class IncidentRow
    {
        public DateTime TimestampUtc { get; set; }
        public string Category { get; set; } = string.Empty;
        public string Subject { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string Detail { get; set; } = string.Empty;
        public string Severity { get; set; } = string.Empty;
        public int Priority { get; set; }
        public bool IsActive { get; set; }
    }
}
