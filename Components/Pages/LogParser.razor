    private static string BuildFallbackAnalysisReport(CompactLogAnalysisPayload payload, string? question)
    {
        static IReadOnlyList<string> ExtractQuestionIps(string? text)
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return [];
            }

            var matches = System.Text.RegularExpressions.Regex.Matches(text, @"\b(?:\d{1,3}\.){3}\d{1,3}\b");
            return matches.Select(m => m.Value).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }

        static string FormatReasons(IReadOnlyList<string> reasons, int take = 3)
            => reasons.Count == 0 ? "근거 없음" : string.Join(", ", reasons.Take(take));

        static string DescribeUrlPattern(UrlAttackDetailItem item)
        {
            if (item.IsDistributedDdosCandidate)
            {
                return "분산 DDoS 또는 분산형 대량 호출 의심";
            }

            if (item.IsDistributedCrawler)
            {
                return "분산 크롤링 또는 분산 스크래핑 의심";
            }

            if (item.TopIpRatio >= 0.7)
            {
                return "단일 IP 집중형 스크래핑 의심";
            }

            if (item.Http404Count > 0 && item.Http404Count >= item.Http200Count)
            {
                return "404 기반 스캐닝 또는 탐색성 접근 의심";
            }

            if (item.Http200Count > 0 && item.NoRefererRatio >= 0.5)
            {
                return "정상 응답 기반 자동화 접근 의심";
            }

            return "반복 접근 패턴 관찰";
        }

        static string DescribeAction(string action) => action switch
        {
            "Block" => "즉시 차단 권고",
            "RateLimit" => "속도 제한 권고",
            "Monitor" => "모니터링 권고",
            _ => "관찰 필요"
        };

        static string FormatIpList(IEnumerable<string> ips, int take = 8)
        {
            var values = ips
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(take)
                .ToList();

            return values.Count == 0 ? "없음" : string.Join(", ", values);
        }

        var topAttackUrls = payload.TopUrlAttackCandidates.Take(3).ToList();
        var topScoredIps = payload.ScoredIps
            .Where(x => x.RecommendedAction is "Block" or "RateLimit" or "Monitor")
            .Take(5)
            .ToList();
        var top404Ips = payload.NotFoundScanIps.Take(5).ToList();
        var boardUrls = payload.BoardAttackCandidates.Take(3).ToList();
        var top404Urls = payload.Top404Urls.Take(3).ToList();

        var blockCandidates = payload.ScoredIps
            .Where(x => x.RecommendedAction == "Block")
            .Select(x => x.Ip)
            .Concat(payload.NotFoundScanIps.Where(x => x.RecommendedAction == "Block").Select(x => x.Ip))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .ToList();
        var rateLimitCandidates = payload.ScoredIps
            .Where(x => x.RecommendedAction == "RateLimit")
            .Select(x => x.Ip)
            .Concat(payload.NotFoundScanIps.Where(x => x.RecommendedAction == "RateLimit").Select(x => x.Ip))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .ToList();
        var monitorCandidates = payload.ScoredIps
            .Where(x => x.RecommendedAction == "Monitor")
            .Select(x => x.Ip)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .ToList();
        var suspiciousQueries = payload.SuspiciousQueryStrings.Take(5).ToList();
        var topAttack = payload.AttackSummary;
        var blockUrlCount = payload.UrlAttackDetails.Count(x => x.RecommendedAction == "Block");
        var rateLimitUrlCount = payload.UrlAttackDetails.Count(x => x.RecommendedAction == "RateLimit");
        var distributedUrls = payload.UrlAttackDetails.Where(x => x.IsDistributedAttackCandidate).OrderByDescending(x => x.Score).Take(3).ToList();
        var singleIpUrls = payload.UrlAttackDetails.Where(x => !x.IsDistributedAttackCandidate && x.TopIpRatio >= 0.7).OrderByDescending(x => x.Score).Take(3).ToList();
        var highRisk404Ips = payload.NotFoundScanIps.Where(x => x.RecommendedAction is "Block" or "RateLimit").Take(5).ToList();
        var adminProbes = payload.AdminPageProbes.Take(5).ToList();
        var backupProbes = payload.BackupFileProbes.Take(5).ToList();
        var configProbes = payload.ConfigFileProbes.Take(5).ToList();
        var scriptProbes = payload.ScriptProbeUrls.Take(5).ToList();
        var topBlockUrl = topAttackUrls.FirstOrDefault(x => x.RecommendedAction == "Block") ?? topAttackUrls.FirstOrDefault();
        var topBlockIp = payload.ScoredIps.FirstOrDefault(x => x.RecommendedAction == "Block")
            ?? payload.ScoredIps.FirstOrDefault(x => x.RecommendedAction == "RateLimit")
            ?? payload.ScoredIps.FirstOrDefault();

        var summaryText = topAttack.TopTargetUrlRequestCount > 0
            ? $"최우선 대상은 {topAttack.TopTargetUrl}이며, {topAttack.TopTargetUrlRequestCount:N0}건의 요청이 집중되었습니다."
            : "뚜렷한 단일 공격 대상 URL은 제한적이지만, 반복 접근과 404 스캐닝 흔적은 확인됩니다.";

        var riskText =
            blockUrlCount >= 3 || blockCandidates.Count >= 5
                ? "높음 — 즉시 차단 또는 속도 제한이 필요한 항목이 확인되었습니다."
                : rateLimitUrlCount >= 2 || rateLimitCandidates.Count >= 3
                    ? "중간 이상 — 선제적인 속도 제한과 추적이 필요합니다."
                    : "관찰 필요 — 반복 접근 패턴을 계속 추적하세요.";

        var lines = new List<string>
        {
            "[전체 요약]",
            $"분석 대상 {payload.AnalyzedRequestCount:N0}건 · 제외 {payload.ExcludedRequestCount:N0}건 · Referer 없음 {payload.RefererMissingRatio:P0}",
            summaryText,
            topBlockUrl is not null
                ? $"우선 조치 URL: {topBlockUrl.Url} · {DescribeAction(topBlockUrl.RecommendedAction)}"
                : string.Empty,
            topBlockIp is not null
                ? $"우선 조치 IP: {topBlockIp.Ip} · {DescribeAction(topBlockIp.RecommendedAction)}"
                : string.Empty,
            "",
            "[위험도]",
            riskText,
            distributedUrls.Count > 0
                ? $"분산 접근 후보 {distributedUrls.Count:N0}개 — IP 차단만으로는 부족할 수 있습니다."
                : "현재 후보는 단일 IP 또는 소수 IP 집중형 패턴이 우세합니다.",
            "",
            "[공격 URL]",
            topAttackUrls.Count > 0
                ? string.Join(Environment.NewLine, topAttackUrls.Select(x =>
                    $"- {x.Url} · {DescribeAction(x.RecommendedAction)} · 요청 {x.TotalRequests:N0} · 고유 IP {x.UniqueIpCount:N0} · 상위 IP 점유 {x.TopIpRatio:P0}"))
                : "뚜렷한 공격 URL 후보가 충분하지 않습니다.",
            boardUrls.Count > 0
                ? $"게시판/조회성 URL: {string.Join(" · ", boardUrls.Select(x => $"{x.Url} ({x.TotalRequests:N0}건)"))}"
                : string.Empty,
            distributedUrls.Count > 0
                ? $"분산 접근: {string.Join(" · ", distributedUrls.Select(x => $"{x.Url} (고유 IP {x.UniqueIpCount:N0})"))}"
                : string.Empty,
            singleIpUrls.Count > 0
                ? $"단일 IP 집중: {string.Join(" · ", singleIpUrls.Select(x => $"{x.Url} ({x.TopIpRatio:P0})"))}"
                : string.Empty,
            "",
            "[의심 IP]",
            topScoredIps.Count > 0
                ? string.Join(Environment.NewLine, topScoredIps.Select(x =>
                    $"- {x.Ip} · {DescribeAction(x.RecommendedAction)} · 점수 {x.Score} · 요청 {x.RequestCount:N0} · 주요 URL {x.DominantUrl}"))
                : "차단 또는 제한 후보 IP가 충분하지 않습니다.",
            top404Ips.Count > 0
                ? $"404 스캔: {string.Join(" · ", top404Ips.Select(x => $"{x.Ip} (404 {x.NotFoundCount:N0})"))}"
                : string.Empty,
            adminProbes.Count > 0
                ? $"관리자 페이지 접근 시도: {string.Join("; ", adminProbes.Select(x => $"{x.Value}({x.Count:N0})"))}"
                : string.Empty,
            backupProbes.Count > 0
                ? $"백업 파일 접근 시도: {string.Join("; ", backupProbes.Select(x => $"{x.Value}({x.Count:N0})"))}"
                : string.Empty,
            configProbes.Count > 0
                ? $"설정 파일 접근 시도: {string.Join("; ", configProbes.Select(x => $"{x.Value}({x.Count:N0})"))}"
                : string.Empty,
            scriptProbes.Count > 0
                ? $"스크립트/익스플로잇 탐색 시도: {string.Join("; ", scriptProbes.Select(x => $"{x.Value}({x.Count:N0})"))}"
                : string.Empty,
            suspiciousQueries.Count > 0
                ? $"의심 QueryString: {string.Join("; ", suspiciousQueries.Select(x => $"{x.QueryString}({x.Count:N0}회, {FormatReasons(x.Reasons, 2)})"))}"
                : string.Empty,
            "",
            "[차단 후보]",
            $"즉시 차단: {FormatIpList(blockCandidates)}" + Environment.NewLine +
            $"속도 제한: {FormatIpList(rateLimitCandidates)}" + Environment.NewLine +
            $"모니터링: {FormatIpList(monitorCandidates)}",
            topBlockUrl is not null
                ? $"우선 보호 URL: {topBlockUrl.Url} ({DescribeUrlPattern(topBlockUrl)}, {DescribeAction(topBlockUrl.RecommendedAction)})"
                : string.Empty,
            "",
            "[대응 방안]",
            BuildFallbackResponsePlan(topAttackUrls, topScoredIps, top404Ips, payload.SuspiciousQueryStrings)
        };

        if (top404Urls.Count > 0 || highRisk404Ips.Count > 0)
        {
            lines.Add($"404 집중 URL: {(top404Urls.Count > 0 ? string.Join(", ", top404Urls.Select(x => $"{x.Value}({x.Count:N0})")) : "없음")}");
            lines.Add($"404 우선 차단/제한 IP: {(highRisk404Ips.Count > 0 ? string.Join(", ", highRisk404Ips.Select(x => $"{x.Ip}({x.RecommendedAction})")) : "없음")}");
        }

        if (!string.IsNullOrWhiteSpace(question))
        {
            var questionIps = ExtractQuestionIps(question);
            var questionIpLocations = questionIps
                .Select(ip =>
                {
                    var hitKinds = new List<string>();
                    if (topScoredIps.Any(x => x.Ip.Equals(ip, StringComparison.OrdinalIgnoreCase)))
                    {
                        hitKinds.Add("ScoredIps");
                    }
                    if (top404Ips.Any(x => x.Ip.Equals(ip, StringComparison.OrdinalIgnoreCase)))
                    {
                        hitKinds.Add("NotFoundScanIps");
                    }
                    if (topAttackUrls.Any(x => x.TopIp.Equals(ip, StringComparison.OrdinalIgnoreCase)))
                    {
                        hitKinds.Add("TopUrlAttackCandidates");
                    }
                    if (boardUrls.Any(x => x.TopIp.Equals(ip, StringComparison.OrdinalIgnoreCase)))
                    {
                        hitKinds.Add("BoardAttackCandidates");
                    }

                    return new { Ip = ip, HitKinds = hitKinds };
                })
                .ToList();

            var matchedQuestionIps = questionIpLocations.Where(x => x.HitKinds.Count > 0).Select(x => x.Ip).ToList();
            var unmatchedQuestionIps = questionIpLocations.Where(x => x.HitKinds.Count == 0).Select(x => x.Ip).ToList();

            lines.Add("");
            lines.Add("[추가 질문 답변]");
            lines.Add($"질문: {question.Trim()}");
            if (questionIps.Count > 0)
            {
                lines.Add($"질문에서 추출한 IP {questionIps.Count:N0}개 중 현재 분석 근거와 겹치는 IP는 {matchedQuestionIps.Count:N0}개입니다.");
                if (matchedQuestionIps.Count > 0)
                {
                    lines.Add($"겹치는 IP: {string.Join(", ", questionIpLocations.Where(x => x.HitKinds.Count > 0).Select(x => $"{x.Ip}({string.Join("+", x.HitKinds)})"))}");
                }
                if (unmatchedQuestionIps.Count > 0)
                {
                    lines.Add($"현재 요약에서 바로 보이지 않는 IP: {string.Join(", ", unmatchedQuestionIps)}");
                }
            }

            lines.Add("현재 답변은 LLM 본문이 아니라 로컬 집계 기반 fallback 응답입니다.");
        }

        return string.Join(Environment.NewLine, lines.Where(line => !string.IsNullOrWhiteSpace(line)));
    }

    private static string BuildFallbackResponsePlan(
        IReadOnlyList<UrlAttackDetailItem> topAttackUrls,
        IReadOnlyList<ScoredIpItem> topScoredIps,
        IReadOnlyList<NotFoundScanIpItem> top404Ips,
        IReadOnlyList<SuspiciousQueryItem> suspiciousQueries)
    {
        var actions = new List<string>();

        if (topAttackUrls.Any(x => x.IsDistributedDdosCandidate))
        {
            actions.Add("분산 접근 후보 URL은 특정 IP 차단만으로는 효과가 제한적일 수 있으므로 URL 단위 RateLimit, 캐싱, CDN/WAF 보호를 우선 적용하세요.");
        }

        if (topAttackUrls.Any(x => x.Http200Count > 0 && x.TopIpRatio >= 0.5))
        {
            actions.Add("200 정상 응답 기반 반복 호출이 상위 IP에 집중된 URL은 스크래핑 가능성이 높으므로 해당 IP 차단과 함께 대상 URL의 호출 빈도 제어를 병행하세요.");
        }

        if (top404Ips.Any())
        {
            actions.Add("404 스캐닝 IP는 관리자 페이지, 백업 파일, 설정 파일 탐색 여부를 기준으로 우선 차단하고, 반복 패턴이 약한 경우에는 속도 제한으로 단계 대응하세요.");
        }

        if (topScoredIps.Any(x => x.SuspiciousQueryCount > 0) || suspiciousQueries.Any())
        {
            actions.Add("의심 QueryString 요청은 애플리케이션 로그와 WAF 로그를 함께 대조해 실제 취약점 탐색인지 추가 확인하세요.");
        }

        if (topScoredIps.Any(x => x.BoardAccessCount >= 20))
        {
            actions.Add("게시판/조회성 페이지에 반복 접근이 집중되면 robots 정책, 캐시 정책, 세션·쿠키 검증, URL별 요청 제한을 함께 점검하세요.");
        }

        if (actions.Count == 0)
        {
            actions.Add("상위 공격 URL과 의심 IP를 기준으로 차단, 속도 제한, 모니터링 대상을 나눠 순차 대응하세요.");
        }

        return string.Join(" ", actions);
    }

    private static bool IsFallbackResponse(string? response)
    {
        if (string.IsNullOrWhiteSpace(response))
        {
            return false;
        }

        return response.Contains("로컬 집계 기반 fallback", StringComparison.OrdinalIgnoreCase)
            || response.Contains("[전체 요약]", StringComparison.Ordinal)
               && response.Contains("[차단 후보]", StringComparison.Ordinal)
               && response.Contains("[대응 방안]", StringComparison.Ordinal);
    }

    private static bool LooksTrivialAnalysis(string? response)
    {
        if (string.IsNullOrWhiteSpace(response))
        {
            return true;
        }

        var trimmed = response.Trim();
        var normalized = trimmed.Replace(".", string.Empty, StringComparison.Ordinal)
            .Replace("!", string.Empty, StringComparison.Ordinal)
            .Replace("?", string.Empty, StringComparison.Ordinal)
            .Replace(" ", string.Empty, StringComparison.Ordinal)
            .ToLowerInvariant();

        if (normalized is "ok" or "okay" or "alright" or "done" or "complete" or "완료" or "알겠습니다" or "이해했습니다")
        {
            return true;
        }

        if (trimmed.Length < 40)
        {
            return !(trimmed.Contains("위험도", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("공격 URL", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("차단", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("대응", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("공격", StringComparison.OrdinalIgnoreCase)
                || trimmed.Contains("의심", StringComparison.OrdinalIgnoreCase));
        }

        return false;
    }

    private static bool NeedsStructuredAnalysisFallback(string? response)
    {
        if (LooksTrivialAnalysis(response) || string.IsNullOrWhiteSpace(response))
        {
            return true;
        }

        // Do not show an English/free-form answer as the Korean report UI.
        var koreanCharacterCount = response.Count(character => character is >= '\uAC00' and <= '\uD7A3');
        if (koreanCharacterCount < 5)
        {
            return true;
        }

        // The report renderer is card-based; a response without section markers
        // cannot be presented consistently, even when its prose is otherwise valid.
        return ParseAnalysisSections(response).Count < 2;
    }

}








