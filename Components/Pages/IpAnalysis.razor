    private static string BuildWorksheetXml(IReadOnlyList<IpApiResult> rows)
    {
        static string Col(int index)
        {
            var dividend = index;
            var columnName = string.Empty;
            while (dividend > 0)
            {
                var modulo = (dividend - 1) % 26;
                columnName = Convert.ToChar('A' + modulo) + columnName;
                dividend = (dividend - modulo) / 26;
            }

            return columnName;
        }

        static string Escape(string? value)
            => System.Security.SecurityElement.Escape(value ?? string.Empty) ?? string.Empty;

        void AppendCell(StringBuilder builder, int column, int row, string? value)
        {
            builder.Append("<c r=\"").Append(Col(column)).Append(row).Append("\" t=\"inlineStr\"><is><t>")
                .Append(Escape(value))
                .AppendLine("</t></is></c>");
        }

        var headers = new[]
        {
            "IP", "Status", "Country", "CountryCode", "Region", "RegionName", "City", "Zip",
            "Lat", "Lon", "Timezone", "ISP", "Org", "AS"
        };

        var sb = new StringBuilder();
        sb.AppendLine("""<?xml version="1.0" encoding="UTF-8" standalone="yes"?>""");
        sb.AppendLine("""<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">""");
        sb.AppendLine("<sheetData>");
        sb.AppendLine("<row r=\"1\">");
        for (var i = 0; i < headers.Length; i++)
        {
            sb.Append("<c r=\"").Append(Col(i + 1)).Append("1\" t=\"inlineStr\"><is><t>")
                .Append(Escape(headers[i]))
                .AppendLine("</t></is></c>");
        }
        sb.AppendLine("</row>");

        for (var rowIndex = 0; rowIndex < rows.Count; rowIndex++)
        {
            var row = rows[rowIndex];
            var excelRow = rowIndex + 2;
            sb.Append("<row r=\"").Append(excelRow).AppendLine("\">");
            AppendCell(sb, 1, excelRow, row.Ip);
            AppendCell(sb, 2, excelRow, row.Status);
            AppendCell(sb, 3, excelRow, row.Country);
            AppendCell(sb, 4, excelRow, row.CountryCode);
            AppendCell(sb, 5, excelRow, row.Region);
            AppendCell(sb, 6, excelRow, row.RegionName);
            AppendCell(sb, 7, excelRow, row.City);
            AppendCell(sb, 8, excelRow, row.Zip);
            AppendCell(sb, 9, excelRow, row.Lat == 0 ? string.Empty : row.Lat.ToString("0.000000", CultureInfo.InvariantCulture));
            AppendCell(sb, 10, excelRow, row.Lon == 0 ? string.Empty : row.Lon.ToString("0.000000", CultureInfo.InvariantCulture));
            AppendCell(sb, 11, excelRow, row.Timezone);
            AppendCell(sb, 12, excelRow, row.Isp);
            AppendCell(sb, 13, excelRow, row.Org);
            AppendCell(sb, 14, excelRow, row.As);
            sb.AppendLine("</row>");
        }

        sb.AppendLine("</sheetData>");
        sb.AppendLine("</worksheet>");
        return sb.ToString();
    }

    private static bool TryValidateIp(string input, out string errorMessage)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            errorMessage = "IP를 입력해 주세요.";
            return false;
        }

        if (!IPAddress.TryParse(input, out _))
        {
            errorMessage = "올바른 IP 형식이 아닙니다.";
            return false;
        }

        errorMessage = string.Empty;
        return true;
    }

    private static bool IsSuccess(IpApiResult result)
        => string.Equals(result.Status, "success", StringComparison.OrdinalIgnoreCase);

    private static bool HasValidCoordinates(IpApiResult result)
        => Math.Abs(result.Lat) > 0.000001 || Math.Abs(result.Lon) > 0.000001;
}
