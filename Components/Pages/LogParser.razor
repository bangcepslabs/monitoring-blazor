    private static void ApplyRuntimeAnalysisSettings(LogAnalysisRuntimeSettings settings)
    {
        AnalysisExcludedIpPatterns = MergeTokens(DefaultAnalysisExcludedIpPatterns, settings.ExcludedIpPatterns, treatAsPatterns: true);
        AnalysisExcludedIpPrefixes = AnalysisExcludedIpPatterns
            .Select(ToPrefixFromPattern)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        PriorityUrlTokens = MergeTokens(DefaultPriorityUrlTokens, settings.PriorityUrlTokens);
        AdminProbeTokens = MergeTokens(DefaultAdminProbeTokens, settings.AdminProbeTokens);
        BackupProbeTokens = MergeTokens(DefaultBackupProbeTokens, settings.BackupProbeTokens);
        ConfigProbeTokens = MergeTokens(DefaultConfigProbeTokens, settings.ConfigProbeTokens);
        ScriptProbeTokens = MergeTokens(DefaultScriptProbeTokens, settings.ScriptProbeTokens);
    }

    private static List<string> MergeTokens(IEnumerable<string> defaults, IEnumerable<string>? custom, bool treatAsPatterns = false)
    {
        var values = defaults
            .Concat(custom ?? [])
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!treatAsPatterns)
        {
            return values;
        }

        return values
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string ToPrefixFromPattern(string pattern)
    {
        var trimmed = pattern.Trim();
        return trimmed.EndsWith(".*", StringComparison.Ordinal) ? trimmed[..^1] : trimmed;
    }

    private async Task HandleFiles(InputFileChangeEventArgs args)
    {
        UploadMessage = null;
        if (args.FileCount > MaxUploadFiles)
        {
            await RejectUpload(Language.T(
                $"파일을 {args.FileCount}개 선택했습니다. 한 번에 최대 {MaxUploadFiles}개까지 가능합니다.",
                $"You selected {args.FileCount} files. The limit is {MaxUploadFiles} files per batch."));
            return;
        }

        var files = args.GetMultipleFiles(MaxUploadFiles).ToList();
        var totalBytes = files.Sum(x => (long)x.Size);
        if (totalBytes > MaxUploadBytes)
        {
            await RejectUpload(Language.T(
                $"선택한 파일은 총 {FormatBytes(totalBytes)}입니다. 현재 한 번에 올릴 수 있는 최대 용량은 {FormatBytes(MaxUploadBytes)}입니다.",
                $"The selected files total {FormatBytes(totalBytes)}. The batch limit is {FormatBytes(MaxUploadBytes)}."));
            return;
        }

        await LogWorkspaceStore.DeleteAsync(WorkspaceId);
        WorkspaceId = null;
        SelectedFiles = files;
        UploadMessage = null;
        AnalyzeMessage = $"Selected {files.Count} file(s), {FormatBytes(totalBytes)} total.";

        await ParseSelectedFilesAsync();
    }

    private async Task RejectUpload(string message)
    {
        await LogWorkspaceStore.DeleteAsync(WorkspaceId);
        WorkspaceId = null;
        UploadMessage = message;
        AnalyzeMessage = null;
        SelectedFiles = [];
        AllRows = [];
        FilteredRows = [];
        ParsedAggregates = [];
        TotalParsedRows = 0;
        IsPreviewTruncated = false;
        WorkspacePageRows = [];
        WorkspaceFilteredCount = 0;
        WorkspaceSummary = null;
        FilterDirty = true;
        ResetPage();
    }

    private async Task ParseSelectedFilesAsync()
    {
        if (SelectedFiles.Count == 0)
        {
            AnalyzeMessage = "Please select one or more log files first.";
            return;
        }

        IsPreviewing = true;
        IsCancelling = false;
        _uploadCts?.Dispose();
        _uploadCts = new CancellationTokenSource();
        var token = _uploadCts.Token;
        PreviewProgress = 0;
        PreviewStage = "Preparing preview";
        UploadMessage = null;
        AnalyzeMessage = null;
        AllRows = [];
        FilteredRows = [];
        ParsedAggregates = [];
        TotalParsedRows = 0;
        IsPreviewTruncated = false;
        WorkspacePageRows = [];
        WorkspaceFilteredCount = 0;
        WorkspaceSummary = null;
        WorkspaceId = null;
        FilterDirty = true;
        ResetPage();
        await InvokeAsync(StateHasChanged);

        try
        {
            var parseResult = await LogPreviewService.ParseFilesAsync(
                SelectedFiles,
                MaxUploadBytes,
                DateTime.UtcNow,
                async (stage, progress) =>
                {
                    PreviewStage = stage;
                    PreviewProgress = progress;
                    await InvokeAsync(StateHasChanged);
                },
                token);

            AllRows = parseResult.PreviewRows;
            ParsedAggregates = parseResult.Aggregates;
            TotalParsedRows = parseResult.TotalRows;
            IsPreviewTruncated = parseResult.IsPreviewTruncated;
            if (IsPreviewTruncated)
            {
                UseVirtualize = false;
                WorkspaceId = parseResult.WorkspaceId;
                PreviewStage = "Calculating full-data summaries";
                PreviewProgress = 95;
                await InvokeAsync(StateHasChanged);
                AppliedWorkspaceCriteria = BuildFilterCriteria();
                var workspaceData = await QueryWorkspacePageAsync(WorkspaceId, AppliedWorkspaceCriteria, Sorts, 1, PageSize, token);
                WorkspaceSummary = workspaceData.Summary;
                WorkspaceFilteredCount = WorkspaceSummary.TotalRows;
                WorkspacePageRows = workspaceData.Rows;
            }
            else
            {
                await LogWorkspaceStore.DeleteAsync(parseResult.WorkspaceId, token);
                WorkspaceId = null;
            }
            FilteredRows = [];
            FilterDirty = true;
            ResetPage();

            PreviewStage = "Finalizing";
            PreviewProgress = 100;
            await InvokeAsync(StateHasChanged);
            AnalyzeMessage = $"Preview ready: {SelectedFiles.Count} file(s), {TotalParsedRows:N0} rows parsed.";
        }
        catch (OperationCanceledException)
        {
            AnalyzeMessage = "Parsing cancelled by user.";
        }
        catch (Exception ex)
        {
            AnalyzeMessage = $"Log parse failed: {ex.Message}";
        }
        finally
        {
            PreviewProgress = 100;
            PreviewStage = IsCancelling ? "Cancelling..." : "Done";
            IsPreviewing = false;
            IsCancelling = false;
            _uploadCts?.Dispose();
            _uploadCts = null;
        }
    }

    private async Task UpdateToServerAsync()
    {
        if (ParsedAggregates.Count == 0)
        {
            AnalyzeMessage = "No parsed rows available. Select files first.";
            return;
        }

        IsSaving = true;
        IsCancelling = false;
        _uploadCts?.Dispose();
        _uploadCts = new CancellationTokenSource();
        var token = _uploadCts.Token;
        SaveProgress = 0;
        SaveStage = "Preparing database save";
        AnalyzeMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var serverName = string.IsNullOrWhiteSpace(ServerName) ? "unknown" : ServerName.Trim();
            var nowUtc = DateTime.UtcNow;
            var aggregateMap = ParsedAggregates;

            await using var db = await DbFactory.CreateDbContextAsync();
            await LogIpDailyStatsPersistenceService.AddAggregatesAsync(
                db,
                serverName,
                aggregateMap,
                nowUtc,
                async (index, total) =>
                {
                    SaveStage = $"Saving aggregate {index:N0}/{total:N0}";
                    SaveProgress = total == 0 ? 100 : index * 100.0 / total;
                    await InvokeAsync(StateHasChanged);
                },
                token);
            AnalyzeMessage = $"Database update completed: {aggregateMap.Count:N0} aggregate rows saved from {TotalParsedRows:N0} requests.";
        }
        catch (OperationCanceledException)
        {
            AnalyzeMessage = "Database update cancelled by user.";
        }
        catch (Exception ex)
        {
            AnalyzeMessage = $"DB update failed: {ex.Message}";
        }
        finally
        {
            SaveProgress = 100;
            SaveStage = IsCancelling ? "Cancelling..." : "Done";
            IsSaving = false;
            IsCancelling = false;
            _uploadCts?.Dispose();
            _uploadCts = null;
        }
    }

    private Task CancelUploadAsync()
    {
        if (!(IsPreviewing || IsSaving))
        {
            return Task.CompletedTask;
        }

        IsCancelling = true;
        PreviewStage = "Cancelling...";
        SaveStage = "Cancelling...";
        _uploadCts?.Cancel();
        return InvokeAsync(StateHasChanged);
    }

