    private static int GetHostSeverity(HostState host)
    {
        if (!host.IsOnline)
        {
            return 3;
        }

        if (IsCritical(host.Info))
        {
            return 2;
        }

        if (IsWarning(host.Info))
        {
            return 1;
        }

        return 0;
    }

    private string GetServerGroup(string hostname)
    {
        return ServerCatalog.TryGetValue(hostname, out var metadata) ? metadata.Group : string.Empty;
    }

    private IReadOnlyList<string> GetServerTags(string hostname)
    {
        if (!ServerCatalog.TryGetValue(hostname, out var metadata) || string.IsNullOrWhiteSpace(metadata.Tags))
        {
            return Array.Empty<string>();
        }

        return metadata.Tags
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(5)
            .ToList();
    }

