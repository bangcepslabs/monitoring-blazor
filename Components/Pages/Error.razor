@page "/Error"
@using System.Diagnostics

<PageTitle>@Language.T("오류", "Error")</PageTitle>

<h1 class="text-danger">@Language.T("오류가 발생했습니다.", "Something went wrong.")</h1>
<h2 class="text-danger">@Language.T("요청을 처리하는 중 문제가 발생했습니다.", "An error occurred while processing your request.")</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Language.T("요청 ID:", "Request ID:")</strong> <code>@RequestId</code>
    </p>
}

<h3>@Language.T("개발 모드", "Development mode")</h3>
<p>
    @Language.T("Development 환경에서는 발생한 오류에 대한 자세한 정보가 표시됩니다.", "The Development environment displays more detailed information about the error.")
</p>
<p>
    <strong>@Language.T("배포된 애플리케이션에서는 Development 환경을 사용하지 마세요.", "Do not enable the Development environment in deployed applications.")</strong>
    @Language.T("예외에 포함된 민감한 정보가 사용자에게 노출될 수 있습니다.", "Exception details may contain sensitive information that would be exposed to users.")
    @Language.T("로컬에서 디버깅할 때만 ASPNETCORE_ENVIRONMENT를 Development로 설정하고 앱을 다시 시작하세요.", "For local debugging only, set ASPNETCORE_ENVIRONMENT to Development and restart the app.")
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
