    private static bool IsErrorStatus(string? value)
    {
        if (!int.TryParse(value, out var status))
        {
            return false;
        }

        return status is >= 400 and <= 599;
    }

    private static string GetRecommendedAction(
        int score,
        int requestCount,
        double refererMissingRatio,
        int errorCount,
        int suspiciousQueryCount,
        bool isBot)
    {
        if (isBot && score < 30)
        {
            return "Allow";
        }

        var errorRate = requestCount == 0 ? 0 : errorCount / (double)requestCount;
        if (score >= 80 || suspiciousQueryCount >= 10 || errorRate >= 0.6)
        {
            return "Block";
        }

        if (score >= 50 || suspiciousQueryCount >= 5 || errorRate >= 0.3 || refererMissingRatio >= 0.8)
        {
            return "RateLimit";
        }

        if (score >= 20 || refererMissingRatio >= 0.5 || errorRate >= 0.15)
        {
            return "Monitor";
        }

        return "Allow";
    }

