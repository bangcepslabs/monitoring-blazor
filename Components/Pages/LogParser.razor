                ["uri"] = criteria.Uri,
                ["status"] = criteria.Status,
                ["referrer"] = criteria.Referrer,
                ["userAgent"] = criteria.UserAgent,
                ["sorts"] = string.Join(',', Sorts.Select(sort => $"{sort.Column}:{(sort.Ascending ? "asc" : "desc")}"))
            };
            var queryString = string.Join('&', values.Select(pair => $"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(pair.Value)}"));
            var exportUri = new Uri(new Uri(NavigationManager.BaseUri), $"api/log-parser/workspaces/{WorkspaceId}/export?{queryString}");
            NavigationManager.NavigateTo(exportUri.ToString(), forceLoad: true);
            return;
        }

        var rows = GetFilteredRows();
        var header = "date,time,ip,method,uri,status,referrer,user_agent";
        var lines = new List<string> { header };

        foreach (var row in rows)
        {
            lines.Add(string.Join(separator: ",", new[]
            {
                Csv(row.Date),
                Csv(row.Time),
                Csv(row.Ip),
                Csv(row.Method),
                Csv(row.Uri),
                Csv(row.Status),
                Csv(row.Referrer),
                Csv(row.UserAgent)
            }));
        }

        var csv = "\uFEFF" + string.Join("\n", lines);
        await JS.InvokeVoidAsync("exporter.download", "log-export.csv", csv);
    }

