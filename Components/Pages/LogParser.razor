    private static List<ErrorIpItem> GetErrorIps(List<ParsedLogRow> rows, int take)
    {
        return rows
            .Where(x => !string.IsNullOrWhiteSpace(x.Ip))
            .GroupBy(x => x.Ip.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => new ErrorIpItem(
                g.Key,
                g.Count(x => string.Equals(x.Status, "403", StringComparison.OrdinalIgnoreCase)),
                g.Count(x => string.Equals(x.Status, "404", StringComparison.OrdinalIgnoreCase)),
                g.Count(x => string.Equals(x.Status, "500", StringComparison.OrdinalIgnoreCase))))
            .Where(x => x.ErrorCount > 0)
            .OrderByDescending(x => x.ErrorCount)
            .ThenBy(x => x.Ip, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();
    }

    private static List<SuspiciousQueryItem> GetSuspiciousQueryStrings(List<ParsedLogRow> rows, int take)
    {
        var suspiciousEntries = rows
            .Select(row => SuspiciousQueryDetector.Detect(row.Uri))
            .Where(x => x is not null)
            .Select(x => x!)
            .GroupBy(x => x.QueryString, StringComparer.OrdinalIgnoreCase)
            .Select(g => new SuspiciousQueryItem(
                g.Key,
                g.Count(),
                g.SelectMany(x => x.Reasons).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.QueryString, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();

        return suspiciousEntries;
    }

    private static BotSummary GetBotSummary(List<ParsedLogRow> rows, int take)
    {
        var matches = rows
            .Select(row => ClassifyBot(row.UserAgent))
            .Where(match => match is not null)
            .Select(match => match!)
            .ToList();

        var breakdown = matches
            .GroupBy(x => new { x.Name, x.Category })
            .Select(g => new BotItem(g.Key.Name, g.Key.Category, g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .Take(take)
            .ToList();

        return new BotSummary(
            matches.Count(x => string.Equals(x.Category, "search-engine", StringComparison.OrdinalIgnoreCase)),
            matches.Count(x => string.Equals(x.Category, "ai", StringComparison.OrdinalIgnoreCase)),
            matches.Count(x => string.Equals(x.Category, "crawler", StringComparison.OrdinalIgnoreCase)),
            breakdown);
    }

    private static BotMatch? ClassifyBot(string? userAgent)
    {
        if (string.IsNullOrWhiteSpace(userAgent) || userAgent == "-")
        {
            return null;
        }

        var ua = userAgent.Trim();
        foreach (var candidate in BotCandidates)
        {
            if (ua.Contains(candidate.Pattern, StringComparison.OrdinalIgnoreCase))
            {
                return new BotMatch(candidate.Name, candidate.Category);
            }
        }

        return null;
    }

    private static bool IsMissingField(string? value)
    {
        return string.IsNullOrWhiteSpace(value) || string.Equals(value.Trim(), "-", StringComparison.Ordinal);
    }

    private static DateOnly? GetLogDate(List<ParsedLogRow> rows)
    {
        var dates = rows
            .Select(x => x.Date)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();

        if (dates.Count == 0)
        {
            return null;
        }

        var first = dates
            .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .FirstOrDefault();

        if (first is null)
        {
            return null;
        }

        if (DateOnly.TryParse(first, out var parsed))
        {
            return parsed;
        }

        return null;
    }

    private static string Csv(string? value)
    {
        var v = value ?? string.Empty;
        if (v.Contains('"') || v.Contains(',') || v.Contains('\n') || v.Contains('\r'))
        {
            v = v.Replace("\"", "\"\"");
            return $"\"{v}\"";
        }
        return v;
    }

